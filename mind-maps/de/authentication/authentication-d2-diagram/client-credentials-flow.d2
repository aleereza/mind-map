# A program trades its client ID and secret for an access token, then calls an API with the token.

vars: {
  d2-config: {
    layout-engine: tala
    pad: 24
  }
}

direction: down

classes: {
  box: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 8
      font-color: "#1E293B"
    }
  }
  store: {
    style: {
      fill: "#E0F2FE"
      stroke: "#0369A1"
      stroke-width: 2
      font-color: "#1E293B"
    }
  }
  actor: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      font-color: "#1E293B"
    }
  }
  external: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 8
      font-color: "#1E293B"
    }
  }
  zone: {
    style: {
      fill: "#F1F5F9"
      stroke: "#CBD5E1"
      border-radius: 12
      font-color: "#334155"
    }
  }
  zone_alt: {
    style: {
      fill: "#EEF2FF"
      stroke: "#C7D2FE"
      border-radius: 12
      font-color: "#334155"
    }
  }
  flow: {
    style: {
      stroke: "#64748B"
      stroke-width: 2
      font-color: "#334155"
    }
  }
}

token_flow: "Client credentials flow" {
  shape: sequence_diagram
  auth: "Authorization server\n(token endpoint)" {class: box}
  program: "Program\n(client)" {class: box}
  api: "API\n(resource server)" {class: box}

  program -> auth: "1. POST /token\ngrant_type=client_credentials\nclient ID and client secret" {class: flow}
  auth -> program: "2. 200 OK\naccess_token, token_type Bearer\nexpires_in 3600" {class: flow}
  program -> api: "3. GET /resource\nAuthorization: Bearer <access_token>" {class: flow}
  api -> api: "4. check signature,\niss, aud and exp" {class: flow}
  api -> program: "5. 200 OK" {class: flow}
}
