      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Core Ideas\nSix ideas explain every method in\nthis map. They come in dependency\norder: each idea uses only the\nones before it.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-e88f6d143bc6",
      "originalText": "Core Ideas\nSix ideas explain every method in this map. They come in dependency order: each idea uses only the ones before it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "core-ideas"
      }
    },
    {
