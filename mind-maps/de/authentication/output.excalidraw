      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1320.0,
      "y": 4020.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
