    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9285764060,
      "isDeleted": false,
      "id": "text-76f9c4f83295",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 2980.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 485840,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kerberos\nKerberos verifies the identities of principals\non an open network. It uses a trusted third\nparty and shared secret keys ([RFC 4120](https\n://www.rfc-editor.org/rfc/rfc4120.html#section\n-1.1)). The third party is the key\ndistribution center (KDC), a network service\nthat supplies tickets and temporary session\nkeys ([RFC 4120](https://www.rfc-editor.org/rf\nc/rfc4120.html#section-1.7)). To reach a\nservice, the client sends the application\nserver a ticket and an authenticator. The\nauthenticator is encrypted in the session key.\nThe network carries the session key only in\nencrypted form.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-76f9c4f83295",
      "originalText": "Kerberos\nKerberos verifies the identities of principals on an open network. It uses a trusted third party and shared secret keys ([RFC 4120](https://www.rfc-editor.org/rfc/rfc4120.html#section-1.1)). The third party is the key distribution center (KDC), a network service that supplies tickets and temporary session keys ([RFC 4120](https://www.rfc-editor.org/rfc/rfc4120.html#section-1.7)). To reach a service, the client sends the application server a ticket and an authenticator. The authenticator is encrypted in the session key. The network carries the session key only in encrypted form.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "kerberos"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9788157695,
      "isDeleted": false,
      "id": "node-7b95ff49b1d8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1320.0,
      "y": 3240.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
