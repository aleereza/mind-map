    {
      "type": "text",
      "version": 1,
      "versionNonce": 1620728160,
      "isDeleted": false,
      "id": "text-552e0ed2baac",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
