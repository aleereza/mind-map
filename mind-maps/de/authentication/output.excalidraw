    {
      "type": "text",
      "version": 1,
      "versionNonce": 7811248580,
      "isDeleted": false,
      "id": "text-7b95ff49b1d8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 3240.0,
      "strokeColor": "#1E3A8A",
