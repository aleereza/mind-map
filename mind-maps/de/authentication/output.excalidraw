    {
      "type": "text",
      "version": 1,
      "versionNonce": 3048397752,
      "isDeleted": false,
      "id": "text-2c35baf5aa80",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 5680.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 1190.0,
      "seed": 603452,
      "groupIds": [],
