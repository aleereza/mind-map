    {
      "type": "text",
      "version": 1,
      "versionNonce": 7636678958,
      "isDeleted": false,
      "id": "text-d1081e351fbe",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 4280.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 297.5,
