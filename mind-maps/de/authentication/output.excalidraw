    {
      "type": "text",
      "version": 1,
      "versionNonce": 5991944515,
      "isDeleted": false,
      "id": "text-164a819e9ba7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 4540.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 332.5,
      "seed": 457037,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Amazon Cognito\nAmazon Cognito is an identity platform for web\nand mobile apps. It combines a user directory\nand an authentication server. It also\nauthorizes OAuth 2.0 access tokens and AWS\ncredentials ([What is Amazon Cognito?](https:/\n/docs.aws.amazon.com/cognito/latest/developerg\nuide/what-is-amazon-cognito.html)). A user\npool is a user directory that follows OpenID\nConnect and issues JWTs to your app or API. An\nidentity pool decides which AWS resources a\nuser may reach. A program uses a confidential\napp client with a client secret and the client\ncredentials grant. The token authorizes only\nthe custom scopes of a resource server\n([machine-to-machine authorization](https://do\ncs.aws.amazon.com/cognito/latest/developerguid\ne/cognito-user-pools-define-resource-servers.h\ntml)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-164a819e9ba7",
      "originalText": "Amazon Cognito\nAmazon Cognito is an identity platform for web and mobile apps. It combines a user directory and an authentication server. It also authorizes OAuth 2.0 access tokens and AWS credentials ([What is Amazon Cognito?](https://docs.aws.amazon.com/cognito/latest/developerguide/what-is-amazon-cognito.html)). A user pool is a user directory that follows OpenID Connect and issues JWTs to your app or API. An identity pool decides which AWS resources a user may reach. A program uses a confidential app client with a client secret and the client credentials grant. The token authorizes only the custom scopes of a resource server ([machine-to-machine authorization](https://docs.aws.amazon.com/cognito/latest/developerguide/cognito-user-pools-define-resource-servers.html)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "amazon-cognito"
      }
    },
