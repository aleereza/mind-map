    {
      "type": "text",
      "version": 1,
      "versionNonce": 6128770314,
      "isDeleted": false,
      "id": "text-3b7ac510ec93",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 2720.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 350.0,
      "seed": 951318,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "SAML 2.0\nSAML (Security Assertion Markup Language) 2.0\nlets organizations that do business together\nexchange security information. It defines two\nroles: the identity provider (IdP) and the\nservice provider (SP) ([SAML technical overvie\nw](https://docs.oasis-open.org/security/saml/P\nost2.0/sstc-saml-tech-overview-2.0.html)). A\nSAML assertion is an XML statement about a\nuser, for example that the user is logged in\nat the IdP. In the browser sign-in flow, the\nservice sends the browser to the IdP. The user\nsigns in there. The IdP sends the browser back\nto the service with a SAML assertion.\nSnowflake supports federated authentication\nthrough SAML 2.0 security integrations. Okta\nand Microsoft Entra ID provide native support\nfor it ([federated authentication](https://doc\ns.snowflake.com/en/user-guide/admin-security-f\ned-auth-overview)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-3b7ac510ec93",
      "originalText": "SAML 2.0\nSAML (Security Assertion Markup Language) 2.0 lets organizations that do business together exchange security information. It defines two roles: the identity provider (IdP) and the service provider (SP) ([SAML technical overview](https://docs.oasis-open.org/security/saml/Post2.0/sstc-saml-tech-overview-2.0.html)). A SAML assertion is an XML statement about a user, for example that the user is logged in at the IdP. In the browser sign-in flow, the service sends the browser to the IdP. The user signs in there. The IdP sends the browser back to the service with a SAML assertion. Snowflake supports federated authentication through SAML 2.0 security integrations. Okta and Microsoft Entra ID provide native support for it ([federated authentication](https://docs.snowflake.com/en/user-guide/admin-security-fed-auth-overview)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "saml-2-0"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7166090583,
      "isDeleted": false,
      "id": "node-76f9c4f83295",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1320.0,
      "y": 2980.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220,
      "seed": 667386,
