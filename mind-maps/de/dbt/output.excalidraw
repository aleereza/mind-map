      "updated": 1,
      "link": null,
      "locked": false,
      "text": "`profiles.yml` Targets\nIn dbt Core, targets come from `profiles.yml`\nand can be selected with `--target`. This is\nwhere local runs choose dev, qa, prod, or\nother warehouse credentials and object\nnamespaces.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-016b2b7a6409",
      "originalText": "`profiles.yml` Targets\nIn dbt Core, targets come from `profiles.yml` and can be selected with `--target`. This is where local runs choose dev, qa, prod, or other warehouse credentials and object namespaces.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-profiles-targets"
      }
    },
