      "version": 1,
      "versionNonce": 5442737201,
      "isDeleted": false,
      "id": "text-276841b48de9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 4042.0012434458768,
      "y": 3148.9869667883568,
