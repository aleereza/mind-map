      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tables At Boundaries\nTables make expensive or widely reused\ntransformations concrete. They cost rebuild\ntime and storage, but they protect\ndownstream consumers from repeatedly paying\nthe same transformation cost.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-484915d1cc64",
      "originalText": "Tables At Boundaries\nTables make expensive or widely reused transformations concrete. They cost rebuild time and storage, but they protect downstream consumers from repeatedly paying the same transformation cost.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-tables-at-boundaries"
      }
    },
    {
      "type": "rectangle",
