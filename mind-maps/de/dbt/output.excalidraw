      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Monorepo Or Mesh\nMonorepos optimize local refactoring and\nshared standards. Mesh optimizes team autonomy\nand stable interfaces. The right boundary is\nusually ownership and release cadence, not\nfolder count.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-77285270ccde",
      "originalText": "Monorepo Or Mesh\nMonorepos optimize local refactoring and shared standards. Mesh optimizes team autonomy and stable interfaces. The right boundary is usually ownership and release cadence, not folder count.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-monorepo-or-mesh"
      }
    },
