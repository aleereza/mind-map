      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Views In The Middle\nViews are cheap to build but can push\nexpensive work to every downstream query. They\nare often fine near sources and dangerous when\nstacked under BI or many downstream models.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-90d3445d3606",
      "originalText": "Views In The Middle\nViews are cheap to build but can push expensive work to every downstream query. They are often fine near sources and dangerous when stacked under BI or many downstream models.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-views-in-the-middle"
      }
    },
    {
