      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Warehouse-Aware Config\nPerformance configs are adapter-specific:\nclustering, partitioning, sorting,\ndistribution, warehouse selection, query tags,\nand incremental strategies all depend on the\ndata platform.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b2b8501cfc80",
      "originalText": "Warehouse-Aware Config\nPerformance configs are adapter-specific: clustering, partitioning, sorting, distribution, warehouse selection, query tags, and incremental strategies all depend on the data platform.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-warehouse-aware-config"
      }
    },
