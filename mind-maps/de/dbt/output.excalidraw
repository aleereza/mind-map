    {
      "type": "text",
      "version": 1,
      "versionNonce": 9912426255,
      "isDeleted": false,
      "id": "text-a72a551f6d3d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3260.3872430634633,
      "y": -1678.718492114471,
      "strokeColor": "#1E3A8A",
