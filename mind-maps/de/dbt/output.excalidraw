    {
      "type": "text",
      "version": 1,
      "versionNonce": 6008124749,
      "isDeleted": false,
      "id": "text-ee2a3c65f94a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3930.5000058540313,
      "y": 82.58037226358488,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 471.556640625,
      "height": 140.0,
      "seed": 567496,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Macro Dispatch\nMacro dispatch lets dbt choose adapter-specific or project-overridden macro\nimplementations. It is how the same materialization concept can compile\ndifferently across warehouses.\n\nExample: `dateadd` or incremental merge logic can dispatch to Snowflake-\nspecific, BigQuery-specific, or root-project override macros while the model\ncalls a stable macro name.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ee2a3c65f94a",
      "originalText": "Macro Dispatch\nMacro dispatch lets dbt choose adapter-specific or project-overridden macro implementations. It is how the same materialization concept can compile differently across warehouses.\n\nExample: `dateadd` or incremental merge logic can dispatch to Snowflake-specific, BigQuery-specific, or root-project override macros while the model calls a stable macro name.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-macro-dispatch"
      }
    },
