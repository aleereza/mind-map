      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Precedence Discipline\nPut broad defaults high and exceptions close\nto the resource they affect. Scattered config\nis one of the fastest ways to make a dbt\nproject hard to reason about.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-64ae94da98be",
      "originalText": "Precedence Discipline\nPut broad defaults high and exceptions close to the resource they affect. Scattered config is one of the fastest ways to make a dbt project hard to reason about.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-config-precedence-discipline"
      }
    },
