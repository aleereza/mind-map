      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Fusion Adoption Boundary\nAdopt Fusion by checking adapter support,\nfeature coverage, CI behavior, package\ncompatibility, and run semantics. Treat the\nengine as a compatibility surface, not only\na faster binary.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-11f881c95b34",
      "originalText": "Fusion Adoption Boundary\nAdopt Fusion by checking adapter support, feature coverage, CI behavior, package compatibility, and run semantics. Treat the engine as a compatibility surface, not only a faster binary.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-fusion-adoption-boundary"
      }
    },
