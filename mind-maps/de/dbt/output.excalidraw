    {
      "type": "text",
      "version": 1,
      "versionNonce": 9933618242,
      "isDeleted": false,
      "id": "text-f7c577aa70d0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3105.549701650903,
      "y": -339.16793053321453,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 455.205078125,
      "height": 140.0,
      "seed": 298359,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Indirect Test Selection\nIndirect test selection controls which tests are included because their\nparent resources were selected. It prevents test behavior from being\naccidental in CI or targeted commands.\n\nExample: selecting `fct_orders` can bring in tests attached to `fct_orders`;\na relationship test with multiple parents may behave differently depending\non whether all or only some parents are selected.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f7c577aa70d0",
      "originalText": "Indirect Test Selection\nIndirect test selection controls which tests are included because their parent resources were selected. It prevents test behavior from being accidental in CI or targeted commands.\n\nExample: selecting `fct_orders` can bring in tests attached to `fct_orders`; a relationship test with multiple parents may behave differently depending on whether all or only some parents are selected.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-indirect-test-selection"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7299436817,
      "isDeleted": false,
      "id": "node-9b0f2cff32bf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3637.471420253414,
      "y": -428.46918379855447,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 615.8013407941205,
      "height": 215.586826103148,
      "seed": 4507,
      "groupIds": [],
