      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data Boundaries\nMost real-world dbt complexity\ncomes from knowing which data\nboundary a relation belongs to:\nowned by this project, declared as\nan external warehouse input,\nimported as code, or exposed as an\nAPI from another project.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-4369c5ee79f8",
      "originalText": "Data Boundaries\nMost real-world dbt complexity comes from knowing which data boundary a relation belongs to: owned by this project, declared as an external warehouse input, imported as code, or exposed as an API from another project.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-data-boundaries"
      }
    },
