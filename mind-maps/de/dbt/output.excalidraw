      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Semantic Layer Boundary\nThe Semantic Layer moves metric\ndefinitions into dbt metadata so\ndownstream tools query governed business\nconcepts rather than re-implementing\nmeasures independently.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-fae3a3f0715f",
      "originalText": "Semantic Layer Boundary\nThe Semantic Layer moves metric definitions into dbt metadata so downstream tools query governed business concepts rather than re-implementing measures independently.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-semantic-layer-boundary"
      }
    },
