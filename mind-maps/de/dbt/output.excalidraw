      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Jinja Is Metadata Plus SQL\nJinja is not just templating text. In dbt,\nspecific Jinja calls mutate the project graph,\nconfigure nodes, or return adapter-aware\n`Relation` objects.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-4951e50e1244",
      "originalText": "Jinja Is Metadata Plus SQL\nJinja is not just templating text. In dbt, specific Jinja calls mutate the project graph, configure nodes, or return adapter-aware `Relation` objects.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-jinja-metadata-plus-sql"
      }
    },
