      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Target Object\n`target` exposes attributes such as\nprofile name, target name, schema, adapter\ntype, threads, and adapter-specific fields\nlike Snowflake database, role, warehouse,\nand account.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-d680c300312c",
      "originalText": "Target Object\n`target` exposes attributes such as profile name, target name, schema, adapter type, threads, and adapter-specific fields like Snowflake database, role, warehouse, and account.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-target-object"
      }
    },
