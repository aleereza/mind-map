      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Public Model API\nA public model should behave like an API:\ndocumented, tested, versioned when breaking\nchanges happen, and owned by a team that can\nsupport downstream consumers.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-35c1c827c0d9",
      "originalText": "Public Model API\nA public model should behave like an API: documented, tested, versioned when breaking changes happen, and owned by a team that can support downstream consumers.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-public-model-api"
      }
    },
