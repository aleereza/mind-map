    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6112310011,
      "isDeleted": false,
      "id": "text-335862c613a8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3029.1785929927596,
      "y": -129.8333785892769,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 538.42578125,
      "height": 192.5,
      "seed": 378926,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Jinja Context\nThe Jinja context is the set of variables and functions available while dbt renders a\nresource. It bridges project metadata, target information, macros, and SQL text.\n\nExamples: `{{ target.name }}` can branch dev vs prod behavior, `{{ var('lookback_days')\n}}` reads invocation/project vars, and `{{ env_var('RAW_DATABASE') }}` reads\nenvironment configuration.\n\nIn Core, `target` values come from the active `profiles.yml` output. In the dbt platform,\n`target` values come from environment, connection, credentials, extended attributes,\nand job or developer settings.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-335862c613a8",
      "originalText": "Jinja Context\nThe Jinja context is the set of variables and functions available while dbt renders a resource. It bridges project metadata, target information, macros, and SQL text.\n\nExamples: `{{ target.name }}` can branch dev vs prod behavior, `{{ var('lookback_days') }}` reads invocation/project vars, and `{{ env_var('RAW_DATABASE') }}` reads environment configuration.\n\nIn Core, `target` values come from the active `profiles.yml` output. In the dbt platform, `target` values come from environment, connection, credentials, extended attributes, and job or developer settings.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-jinja-context"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1479976238,
      "isDeleted": false,
      "id": "node-a300d1015c67",
