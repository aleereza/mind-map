      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Build Order\nWithin the selected graph, dbt schedules\nresources so dependencies are available before\ndownstream nodes. Parallelism is constrained\nby DAG shape, adapter behavior, and thread or\nengine rules.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-276841b48de9",
      "originalText": "Build Order\nWithin the selected graph, dbt schedules resources so dependencies are available before downstream nodes. Parallelism is constrained by DAG shape, adapter behavior, and thread or engine rules.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-build-order"
      }
    },
