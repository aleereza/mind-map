      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Access Levels\nModel access controls communicate ownership\nboundaries inside and across projects. Public\nmodels are the intended dependency surface;\nprivate implementation models should not\nbecome downstream contracts.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-7d9542c77265",
      "originalText": "Access Levels\nModel access controls communicate ownership boundaries inside and across projects. Public models are the intended dependency surface; private implementation models should not become downstream contracts.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-access-levels"
      }
    },
