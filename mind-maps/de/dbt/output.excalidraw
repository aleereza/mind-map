      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Scale And Product Choices\nAt scale, dbt design becomes less\nabout writing models and more\nabout choosing the right execution\nengine, collaboration boundary,\nownership model, and metadata\nplane.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-f02840e7ee9c",
      "originalText": "Scale And Product Choices\nAt scale, dbt design becomes less about writing models and more about choosing the right execution engine, collaboration boundary, ownership model, and metadata plane.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-scale-and-product-choices"
      }
    },
