      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Sources Artifact\n`sources.json` records source freshness\nresults. It is useful for freshness-aware\nselection and for separating upstream\nload delays from dbt transformation\nfailures.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-182889a61aac",
      "originalText": "Sources Artifact\n`sources.json` records source freshness results. It is useful for freshness-aware selection and for separating upstream load delays from dbt transformation failures.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-sources-artifact"
      }
    },
