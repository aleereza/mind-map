      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Test Cost\nData tests are queries. Large relationship,\nuniqueness, and expression tests can\ndominate runtime unless scoped, indexed,\nfiltered, sampled, or scheduled\nintentionally.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-cee38d77b1d2",
      "originalText": "Test Cost\nData tests are queries. Large relationship, uniqueness, and expression tests can dominate runtime unless scoped, indexed, filtered, sampled, or scheduled intentionally.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-test-cost"
      }
    },
