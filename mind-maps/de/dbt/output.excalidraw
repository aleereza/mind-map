      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Source Naming Layer\n`name`, `database`, `schema`, and `identifier`\nlet you separate dbt-facing names from awkward\nphysical names. This is the right place to\nnormalize raw system naming without hiding the\ntrue warehouse location.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-5df7dec22385",
      "originalText": "Source Naming Layer\n`name`, `database`, `schema`, and `identifier` let you separate dbt-facing names from awkward physical names. This is the right place to normalize raw system naming without hiding the true warehouse location.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-source-naming-layer"
      }
    },
