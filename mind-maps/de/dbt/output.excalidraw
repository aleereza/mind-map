      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Filter Early\nPlace `is_incremental()` filters as close to\nlarge upstream scans as the warehouse\noptimizer can benefit from. Late filters often\nsave less compute than they appear to.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-87c51cb9a280",
      "originalText": "Filter Early\nPlace `is_incremental()` filters as close to large upstream scans as the warehouse optimizer can benefit from. Late filters often save less compute than they appear to.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-incremental-filter-early"
      }
    },
