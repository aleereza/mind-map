      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dependency Producers\n`ref()`, `source()`, tests, exposures,\nmetrics, semantic models, and some macros can\ncreate lineage. Raw SQL relation names do not\ncreate dbt lineage unless wrapped in a\ndeclared resource.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-c274f38044fb",
      "originalText": "Dependency Producers\n`ref()`, `source()`, tests, exposures, metrics, semantic models, and some macros can create lineage. Raw SQL relation names do not create dbt lineage unless wrapped in a declared resource.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-dependency-producers"
      }
    },
