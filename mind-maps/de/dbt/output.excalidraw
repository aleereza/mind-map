    {
      "type": "text",
      "version": 1,
      "versionNonce": 6078072272,
      "isDeleted": false,
      "id": "text-dc82451ce23b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2545.6847564204636,
      "y": -502.7318052924869,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 494.0947265625,
      "height": 122.5,
      "seed": 864604,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Select And Exclude\n`--select` chooses candidate resources and `--exclude` removes resources from\nthat candidate set. This lets one parsed project support local, CI, backfill, and\nproduction command scopes.\n\nExample: `dbt build --select tag:nightly --exclude config.materialized:view` starts\nwith nightly-tagged resources and removes view models from that invocation.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-dc82451ce23b",
      "originalText": "Select And Exclude\n`--select` chooses candidate resources and `--exclude` removes resources from that candidate set. This lets one parsed project support local, CI, backfill, and production command scopes.\n\nExample: `dbt build --select tag:nightly --exclude config.materialized:view` starts with nightly-tagged resources and removes view models from that invocation.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-select-and-exclude"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8262013433,
      "isDeleted": false,
      "id": "node-78cb72d8e14c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2517.6711859532484,
      "y": -339.65720491379034,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 531.4814115510808,
      "height": 150.42127234770146,
      "seed": 376690,
      "groupIds": [],
