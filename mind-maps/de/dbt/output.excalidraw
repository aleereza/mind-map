    {
      "type": "text",
      "version": 1,
      "versionNonce": 9071903716,
      "isDeleted": false,
      "id": "text-1edb85c192e9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3347.9180927104544,
      "y": -1876.9679902823327,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 528.404296875,
      "height": 122.5,
      "seed": 353559,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Resource Paths\nResource paths are the folders dbt scans for project resources. dbt does not scan the\nentire repository; it scans the paths configured in `dbt_project.yml`.\n\nExamples: `model-paths: [\"models\"]` means models and source YAML are read from\n`models/`; `macro-paths: [\"macros\"]` means reusable Jinja macros are read from\n`macros/`.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-1edb85c192e9",
      "originalText": "Resource Paths\nResource paths are the folders dbt scans for project resources. dbt does not scan the entire repository; it scans the paths configured in `dbt_project.yml`.\n\nExamples: `model-paths: [\"models\"]` means models and source YAML are read from `models/`; `macro-paths: [\"macros\"]` means reusable Jinja macros are read from `macros/`.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-resource-paths"
      }
    },
