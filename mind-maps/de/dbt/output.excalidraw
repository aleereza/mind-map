      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Platform Environments\nIn the dbt platform, deployment environments\ndefine dbt version or engine, warehouse\nconnection settings, credentials, code\nversion, and job behavior.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-1630c61e9007",
      "originalText": "Platform Environments\nIn the dbt platform, deployment environments define dbt version or engine, warehouse connection settings, credentials, code version, and job behavior.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-platform-environments"
