      "locked": false,
      "text": "Fusion Engine\nFusion is a Rust-based dbt engine with faster\nparsing, native SQL understanding, and a path\ntoward more efficient large-DAG development\nand deployment.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-081491461ab8",
      "originalText": "Fusion Engine\nFusion is a Rust-based dbt engine with faster parsing, native SQL understanding, and a path toward more efficient large-DAG development and deployment.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-fusion-engine"
      }
    },
