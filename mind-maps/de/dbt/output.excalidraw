    {
      "type": "text",
      "version": 1,
      "versionNonce": 1416661881,
      "isDeleted": false,
      "id": "text-e2b2d0eb9823",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3336.741179668294,
      "y": 970.441173035884,
      "strokeColor": "#1E3A8A",
