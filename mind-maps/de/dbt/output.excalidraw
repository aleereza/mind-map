    {
      "type": "text",
      "version": 1,
      "versionNonce": 6366304609,
      "isDeleted": false,
      "id": "text-ef54c8f81675",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 5342.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
