      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "State Caveats\nSeeds over size thresholds, macro changes,\nvars, env vars, tests with multiple parents,\nand overwritten manifests can all make state\ncomparison surprising. Treat state selection\nas a policy that needs tests.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b54fecb2345d",
      "originalText": "State Caveats\nSeeds over size thresholds, macro changes, vars, env vars, tests with multiple parents, and overwritten manifests can all make state comparison surprising. Treat state selection as a policy that needs tests.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-state-caveats"
      }
    },
