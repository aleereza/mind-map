      "text": "Invocation Context\n`invocation_id`, selected resources, logs, and\ntiming records let you join dbt behavior to\nwarehouse query history and scheduler\nmetadata.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-24e7ecc8efb9",
      "originalText": "Invocation Context\n`invocation_id`, selected resources, logs, and timing records let you join dbt behavior to warehouse query history and scheduler metadata.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-invocation-context"
      }
    },
