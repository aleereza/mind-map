      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Ephemeral Models\nEphemeral models inline SQL into downstream\nmodels. They reduce object sprawl, but they\ncan duplicate work and make compiled SQL\nlarger when reused broadly.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-32d6462dbfe3",
      "originalText": "Ephemeral Models\nEphemeral models inline SQL into downstream models. They reduce object sprawl, but they can duplicate work and make compiled SQL larger when reused broadly.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-ephemeral-models"
      }
    },
    {
