      "updated": 1,
      "link": null,
      "locked": false,
      "text": "`ref()` Owned Assets\n`ref()` is for dbt-managed models, seeds, and\nsnapshots. It returns a relation, compiles to\nthe correct physical object name, and creates\na graph edge that controls build order and\nlineage.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-06a591b28ab1",
      "originalText": "`ref()` Owned Assets\n`ref()` is for dbt-managed models, seeds, and snapshots. It returns a relation, compiles to the correct physical object name, and creates a graph edge that controls build order and lineage.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-ref-owned-assets"
      }
    },
