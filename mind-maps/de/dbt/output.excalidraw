      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Freshness And Logs\nFreshness and logs capture non-model evidence about the\ninvocation. They help separate upstream ingestion delay, dbt\ncompilation behavior, and warehouse execution behavior.\n\nExamples: `sources.json` records source freshness results; logs\nrecord command events, warnings, errors, timing, and useful\ncontext for debugging failed invocations.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ee2d1406e132",
      "originalText": "Freshness And Logs\nFreshness and logs capture non-model evidence about the invocation. They help separate upstream ingestion delay, dbt compilation behavior, and warehouse execution behavior.\n\nExamples: `sources.json` records source freshness results; logs record command events, warnings, errors, timing, and useful context for debugging failed invocations.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-freshness-and-logs"
      }
