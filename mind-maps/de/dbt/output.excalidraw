    {
      "type": "text",
      "version": 1,
      "versionNonce": 3455124354,
      "isDeleted": false,
      "id": "text-ee2d1406e132",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3270.418011606623,
