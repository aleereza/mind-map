    {
      "type": "text",
      "version": 1,
      "versionNonce": 7427870041,
      "isDeleted": false,
      "id": "text-1b557066a521",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2923.0812723112717,
      "y": -2345.3089010403874,
      "strokeColor": "#1E3A8A",
