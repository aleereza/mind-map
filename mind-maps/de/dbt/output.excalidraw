    {
      "type": "text",
      "version": 1,
      "versionNonce": 6727910942,
      "isDeleted": false,
      "id": "text-db014cd9bcab",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3433.2012434458766,
      "y": 2051.2369667883568,
      "strokeColor": "#1E3A8A",
