    {
      "type": "text",
      "version": 1,
      "versionNonce": 8281421612,
      "isDeleted": false,
      "id": "text-c090591e9c36",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1904.8000000000002,
      "y": 3042.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 87.5,
      "seed": 362062,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cross-Project Refs\nA cross-project `ref()` treats an upstream\npublic model as a dataset API. The producer\nowns quality and stability; the consumer\ndepends on the published contract and lineage.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-c090591e9c36",
      "originalText": "Cross-Project Refs\nA cross-project `ref()` treats an upstream public model as a dataset API. The producer owns quality and stability; the consumer depends on the published contract and lineage.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-cross-project-refs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2450201631,
      "isDeleted": false,
      "id": "node-a0a08fe3abeb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1892.8000000000002,
      "y": 3200.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 393.6,
      "height": 129.0,
      "seed": 82066,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
