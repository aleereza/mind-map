    {
      "type": "text",
      "version": 1,
      "versionNonce": 3502241476,
      "isDeleted": false,
      "id": "text-16fc8ae48d0c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3143.131099752382,
      "y": 349.13824819389674,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 411.140625,
      "height": 140.0,
      "seed": 151881,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Materialization Macros\nMaterialization macros convert a model resource into concrete\nwarehouse operations. They are why `materialized='table'`, `view`,\n`incremental`, and `snapshot` behave differently.\n\nExample: a table materialization may create or replace a relation;\nan incremental materialization may create a temp relation and\nmerge it into `{{ this }}` using a `unique_key`.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-16fc8ae48d0c",
      "originalText": "Materialization Macros\nMaterialization macros convert a model resource into concrete warehouse operations. They are why `materialized='table'`, `view`, `incremental`, and `snapshot` behave differently.\n\nExample: a table materialization may create or replace a relation; an incremental materialization may create a temp relation and merge it into `{{ this }}` using a `unique_key`.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-materialization-macros"
      }
    },
