      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Staging Environment\nStaging gives teams a pre-prod metadata\nand execution surface. It can support\nbranch validation, restricted access to\nproduction data, staging catalog views,\nand Mesh resolution away from production.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e4cde7e0e883",
      "originalText": "Staging Environment\nStaging gives teams a pre-prod metadata and execution surface. It can support branch validation, restricted access to production data, staging catalog views, and Mesh resolution away from production.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-staging-environment"
      }
    },
    {
