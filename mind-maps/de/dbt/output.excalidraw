      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Incremental Predicates\n`incremental_predicates` can limit how much\nexisting target data a merge scans. It is an\nadvanced cost-control lever and should match\nthe data's late-arrival and correction\nbehavior.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-8157d78f9338",
      "originalText": "Incremental Predicates\n`incremental_predicates` can limit how much existing target data a merge scans. It is an advanced cost-control lever and should match the data's late-arrival and correction behavior.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-incremental-predicates"
      }
    },
