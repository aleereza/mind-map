      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Threads And Concurrency\nMore threads only help when the graph and\nwarehouse can use them. Fusion may optimize\nparallelism differently by adapter, while Core\ntreats configured threads more directly.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-537c52e8272e",
      "originalText": "Threads And Concurrency\nMore threads only help when the graph and warehouse can use them. Fusion may optimize parallelism differently by adapter, while Core treats configured threads more directly.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-threads-and-concurrency"
      }
    },
