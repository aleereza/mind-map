      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Runtime Status\nRuntime status is dbt's record of what happened to each selected\nresource. It drives downstream behavior, alerts, and run result\ninterpretation.\n\nExamples: a node can be `success`, `error`, `fail`, `warn`, `skipped`, or\nadapter-specific response metadata; `--fail-fast` can stop later eligible\nwork after the first serious failure.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-8681f6553c81",
      "originalText": "Runtime Status\nRuntime status is dbt's record of what happened to each selected resource. It drives downstream behavior, alerts, and run result interpretation.\n\nExamples: a node can be `success`, `error`, `fail`, `warn`, `skipped`, or adapter-specific response metadata; `--fail-fast` can stop later eligible work after the first serious failure.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-runtime-status"
      }
    },
