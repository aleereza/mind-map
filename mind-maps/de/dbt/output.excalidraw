    {
      "type": "text",
      "version": 1,
      "versionNonce": 3065725155,
      "isDeleted": false,
      "id": "text-e4cde7e0e883",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
