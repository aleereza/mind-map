      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Docs And Catalog\nDocs, catalog, lineage, and governance tools\nare artifact consumers. Their quality\ndepends on descriptions, tests, contracts,\nexposures, groups, and stable resource\nownership in the manifest.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-356c633b5f94",
      "originalText": "Docs And Catalog\nDocs, catalog, lineage, and governance tools are artifact consumers. Their quality depends on descriptions, tests, contracts, exposures, groups, and stable resource ownership in the manifest.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-docs-and-catalog"
      }
    },
