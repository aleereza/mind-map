      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Freshness Contract\nFreshness checks make upstream load latency\nvisible to dbt. They do not load data; they\ntest whether upstream ingestion produced\ndata recently enough for downstream\nassumptions.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e3774799af85",
      "originalText": "Freshness Contract\nFreshness checks make upstream load latency visible to dbt. They do not load data; they test whether upstream ingestion produced data recently enough for downstream assumptions.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-source-freshness-contract"
      }
    },
