    {
      "type": "text",
      "version": 1,
      "versionNonce": 1486187829,
      "isDeleted": false,
      "id": "text-c06a016d2f0f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3101.480112512579,
      "y": -493.16732979221,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 499.54296875,
      "height": 122.5,
      "seed": 972269,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Graph Operators\nGraph operators expand a selection through upstream or downstream\ndependencies. They are useful because real impact usually follows lineage, not\nfolder boundaries.\n\nExample: `+fct_orders` includes ancestors of `fct_orders`; `stg_orders+` includes\ndescendants; `+stg_orders+` includes both sides around that node.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-c06a016d2f0f",
      "originalText": "Graph Operators\nGraph operators expand a selection through upstream or downstream dependencies. They are useful because real impact usually follows lineage, not folder boundaries.\n\nExample: `+fct_orders` includes ancestors of `fct_orders`; `stg_orders+` includes descendants; `+stg_orders+` includes both sides around that node.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-graph-operators"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9422725792,
      "isDeleted": false,
      "id": "node-f7c577aa70d0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3099.633231609866,
      "y": -344.16793053321453,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 467.03801820707355,
      "height": 150.0,
      "seed": 346018,
      "groupIds": [],
