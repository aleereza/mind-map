    {
      "type": "text",
      "version": 1,
      "versionNonce": 5911513959,
      "isDeleted": false,
      "id": "text-161843113a5a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3342.5029530333695,
      "y": -875.3027214849174,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 485.5498046875,
      "height": 122.5,
      "seed": 944044,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manifest Collections\nManifest collections group parsed resources by type. They let external tools\ninspect the project without re-reading every SQL and YAML file.\n\nExamples: `nodes` contains models, tests, seeds, snapshots, and analyses;\n`sources` contains declared source tables; `macros` contains parsed macro\ndefinitions; `exposures` and `metrics` contain downstream semantic metadata.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-161843113a5a",
      "originalText": "Manifest Collections\nManifest collections group parsed resources by type. They let external tools inspect the project without re-reading every SQL and YAML file.\n\nExamples: `nodes` contains models, tests, seeds, snapshots, and analyses; `sources` contains declared source tables; `macros` contains parsed macro definitions; `exposures` and `metrics` contain downstream semantic metadata.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-manifest-collections"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6414924562,
      "isDeleted": false,
      "id": "node-0cc00a60bc5c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3895.962706442279,
      "y": -807.4489591065271,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 512.633927052102,
      "height": 171.70138754862347,
      "seed": 40616,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
