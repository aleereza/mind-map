    {
      "type": "text",
      "version": 1,
      "versionNonce": 9451031222,
      "isDeleted": false,
      "id": "text-3fd79591f80c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3791.244505043178,
      "y": -623.3398383086558,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 506.625,
      "height": 157.5,
      "seed": 779382,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Artifact Location\nArtifact location is where the parsed graph and later execution results are written.\nIt matters because CI, docs, deferral, and state comparison must read the artifact\nfrom the intended run.\n\nIn Core, the default persisted manifest location is `target/manifest.json`; using `--\ntarget-path target/ci` keeps CI artifacts separate from local development artifacts.\nIn the dbt platform, persisted graph metadata is associated with the managed run,\nenvironment, job history, and platform metadata features.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-3fd79591f80c",
      "originalText": "Artifact Location\nArtifact location is where the parsed graph and later execution results are written. It matters because CI, docs, deferral, and state comparison must read the artifact from the intended run.\n\nIn Core, the default persisted manifest location is `target/manifest.json`; using `--target-path target/ci` keeps CI artifacts separate from local development artifacts. In the dbt platform, persisted graph metadata is associated with the managed run, environment, job history, and platform metadata features.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-artifact-location"
      }
    },
