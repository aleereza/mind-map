      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "State Selection\n`state:modified` compares current project\nstate with a prior manifest to select changed\nresources. It is powerful for CI and\ndeployments, but it depends on saved artifacts\nbeing kept separate from the current target\npath.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-93d10b5c7b82",
      "originalText": "State Selection\n`state:modified` compares current project state with a prior manifest to select changed resources. It is powerful for CI and deployments, but it depends on saved artifacts being kept separate from the current target path.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-state-selection"
      }
    },
    {
      "type": "rectangle",
