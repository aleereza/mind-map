      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Developer Schemas\nDevelopment usually isolates objects by\nschema, often with user-specific schema\nnaming. This lets developers build selected\nmodels without overwriting shared production\nobjects.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-8afb245230dd",
      "originalText": "Developer Schemas\nDevelopment usually isolates objects by schema, often with user-specific schema naming. This lets developers build selected models without overwriting shared production objects.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-developer-schemas"
      }
    },
    {
