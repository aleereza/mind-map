      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Deferral\nWith `--defer --state`, unselected refs can\nresolve to relations from a saved manifest\nwhen they are not built in the current target.\nThis enables slim CI and local development\nagainst production or staging parents.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a4ed770eaa0f",
      "originalText": "Deferral\nWith `--defer --state`, unselected refs can resolve to relations from a saved manifest when they are not built in the current target. This enables slim CI and local development against production or staging parents.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-deferral"
      }
    },
