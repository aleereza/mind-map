      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Query Comments\nQuery comments and tags can stamp warehouse\nSQL with dbt node metadata. They make it\npossible to map warehouse cost or failures\nback to model identity and invocation context.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-bc174df895c6",
      "originalText": "Query Comments\nQuery comments and tags can stamp warehouse SQL with dbt node metadata. They make it possible to map warehouse cost or failures back to model identity and invocation context.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-query-comments"
      }
    },
