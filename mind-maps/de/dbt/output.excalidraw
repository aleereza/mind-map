      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Parse-Time Contract\nParse time is when dbt discovers resources,\nconfigs, properties, macros, and dependencies.\nAnything that affects graph shape or config\nshould be stable enough to evaluate during\nparsing.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-01764e6978b2",
      "originalText": "Parse-Time Contract\nParse time is when dbt discovers resources, configs, properties, macros, and dependencies. Anything that affects graph shape or config should be stable enough to evaluate during parsing.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-parse-time-contract"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
