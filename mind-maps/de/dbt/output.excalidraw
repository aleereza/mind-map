      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Contracts And Versions\nContracts and model versions make breaking\nchanges explicit. They protect consumers\nfrom silent column, type, grain, or semantic\nchanges.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-edfbb82ab8a2",
      "originalText": "Contracts And Versions\nContracts and model versions make breaking changes explicit. They protect consumers from silent column, type, grain, or semantic changes.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-contracts-and-versions"
      }
    },
