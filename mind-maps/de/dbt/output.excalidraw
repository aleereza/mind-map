      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Versioned Refs\nVersioned models let consumers pin a\nbreaking-change boundary with `ref(...,\nversion=1)`. Omitting the version means the\nconsumer follows the latest version and\naccepts that upgrade behavior.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-92ce57643515",
      "originalText": "Versioned Refs\nVersioned models let consumers pin a breaking-change boundary with `ref(..., version=1)`. Omitting the version means the consumer follows the latest version and accepts that upgrade behavior.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-versioned-refs"
      }
    },
