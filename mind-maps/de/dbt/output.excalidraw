      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Compiler And DAG\nThe DAG is built before execution. dbt parses\nproject files, resolves resource metadata,\nextracts dependency-producing Jinja calls, then\ncompiles selected nodes into warehouse SQL\nin dependency order.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-0efe1186e4a5",
      "originalText": "Compiler And DAG\nThe DAG is built before execution. dbt parses project files, resolves resource metadata, extracts dependency-producing Jinja calls, then compiles selected nodes into warehouse SQL in dependency order.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-compiler-and-dag"
      }
    },
