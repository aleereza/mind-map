      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Incremental Design\nIncremental models are performance features\nwith correctness obligations. They need a\nclear grain, stable unique key when updates\nexist, and SQL that works for both\nfull-refresh and incremental paths.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-27f841abd1f9",
      "originalText": "Incremental Design\nIncremental models are performance features with correctness obligations. They need a clear grain, stable unique key when updates exist, and SQL that works for both full-refresh and incremental paths.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-incremental-design"
      }
    },
    {
      "type": "rectangle",
