    {
      "type": "text",
      "version": 1,
      "versionNonce": 2711752858,
      "isDeleted": false,
      "id": "text-38b52837245e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3927.278782047295,
      "y": -1091.2853932251703,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 746157,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "YAML-Derived Edges\nSome dependencies come from YAML resources\nrather than model SQL. This is why dependency\nextraction is broader than scanning for\n`ref()` strings.\n\nExamples: a relationship test depends on both\nthe child model and referenced parent; an\nexposure can depend on models; semantic models\nand metrics can depend on model resources.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-38b52837245e",
      "originalText": "YAML-Derived Edges\nSome dependencies come from YAML resources rather than model SQL. This is why dependency extraction is broader than scanning for `ref()` strings.\n\nExamples: a relationship test depends on both the child model and referenced parent; an exposure can depend on models; semantic models and metrics can depend on model resources.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-yaml-derived-edges"
      }
    },
