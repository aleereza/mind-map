      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hidden Dependency Risk\nDynamic refs, adapter dispatch, conditional\nconfig, and raw relation strings can hide\ndependencies from reviewers. Prefer explicit\ndeclarations when the dependency affects build\norder or ownership.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a515cfa3eb4a",
      "originalText": "Hidden Dependency Risk\nDynamic refs, adapter dispatch, conditional config, and raw relation strings can hide dependencies from reviewers. Prefer explicit declarations when the dependency affects build order or ownership.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-hidden-dependency-risk"
      }
    },
