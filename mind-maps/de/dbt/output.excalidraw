    {
      "type": "text",
      "version": 1,
      "versionNonce": 4101334014,
      "isDeleted": false,
      "id": "text-637820522bff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2614.2317314307793,
      "y": -1313.0523705339963,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 534.6044921875,
      "height": 140.0,
      "seed": 567104,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Properties\nProperties describe resources and their contracts with humans and tools. They are not\njust comments; they drive docs, tests, contracts, source freshness, exposures, and\nsemantic metadata.\n\nExamples: a column property can add a `not_null` test and description; a source\nproperty can declare `database`, `schema`, `identifier`, and `freshness`; a model\nproperty can declare `access: public` or versions.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-637820522bff",
      "originalText": "Properties\nProperties describe resources and their contracts with humans and tools. They are not just comments; they drive docs, tests, contracts, source freshness, exposures, and semantic metadata.\n\nExamples: a column property can add a `not_null` test and description; a source property can declare `database`, `schema`, `identifier`, and `freshness`; a model property can declare `access: public` or versions.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-properties"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9992490735,
      "isDeleted": false,
      "id": "node-f7c7501c9cbb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3221.256839820265,
      "y": -1289.1820180369637,
      "strokeColor": "#065F46",
      "backgroundColor": "#D1FAE5",
      "width": 486.0958736456388,
      "height": 150.0,
      "seed": 733179,
