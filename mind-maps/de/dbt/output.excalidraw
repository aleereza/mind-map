    {
      "type": "text",
      "version": 1,
      "versionNonce": 2114959689,
      "isDeleted": false,
      "id": "text-f1864ea1153c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3769.0635013192928,
      "y": -1471.1591245476518,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 490.259765625,
      "height": 122.5,
      "seed": 316496,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Config Precedence\nConfig precedence decides which materialization, schema, tags, contracts, and\nadapter settings win when the same setting is defined in multiple places.\n\nFor a model, inline `{{ config(materialized='table') }}` > model YAML `config:` >\npath-scoped `dbt_project.yml` config. Within `dbt_project.yml`, a deeper path\nsuch as `models/marts/finance` beats a broader `models/marts` default.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f1864ea1153c",
      "originalText": "Config Precedence\nConfig precedence decides which materialization, schema, tags, contracts, and adapter settings win when the same setting is defined in multiple places.\n\nFor a model, inline `{{ config(materialized='table') }}` > model YAML `config:` > path-scoped `dbt_project.yml` config. Within `dbt_project.yml`, a deeper path such as `models/marts/finance` beats a broader `models/marts` default.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-config-precedence"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1395589386,
      "isDeleted": false,
      "id": "node-637820522bff",
