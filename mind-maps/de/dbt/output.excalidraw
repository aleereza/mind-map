      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Production Source Of Truth\nOne deployment environment should represent\nthe authoritative production state. Features\nsuch as catalog, cross-project refs, and\ndownstream metadata depend on knowing which\nrun is production.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-93c7b3dbf05d",
      "originalText": "Production Source Of Truth\nOne deployment environment should represent the authoritative production state. Features such as catalog, cross-project refs, and downstream metadata depend on knowing which run is production.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-production-source-of-truth"
      }
    },
    {
      "type": "rectangle",
