    {
      "type": "text",
      "version": 1,
      "versionNonce": 2948276042,
      "isDeleted": false,
      "id": "text-7af0c87b9510",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 4033.601243445877,
      "y": 1607.4869667883568,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 122.5,
      "seed": 210125,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partial Parsing\nPartial parsing reuses prior parse state so\nunchanged files are not re-parsed on every\ninvocation. It speeds development, but\ngraph-affecting env vars, project config,\npackages, dbt version, or key macros can force\na full re-parse.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-7af0c87b9510",
      "originalText": "Partial Parsing\nPartial parsing reuses prior parse state so unchanged files are not re-parsed on every invocation. It speeds development, but graph-affecting env vars, project config, packages, dbt version, or key macros can force a full re-parse.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-partial-parsing"
      }
    },
    {
      "type": "rectangle",
