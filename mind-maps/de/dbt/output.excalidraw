      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "`source()` External Boundary\nUse `source()` for relations loaded or owned\noutside the current dbt project. It gives the\nwarehouse object a semantic name, lineage\nedge, tests, docs, and freshness metadata\nwithout pretending dbt built it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f372a5e74771",
      "originalText": "`source()` External Boundary\nUse `source()` for relations loaded or owned outside the current dbt project. It gives the warehouse object a semantic name, lineage edge, tests, docs, and freshness metadata without pretending dbt built it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-source-external-boundary"
      }
    },
