      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Package Namespace\nThe package or project name is part of\nresource identity. This matters when packages,\nproject dependencies, or duplicated model\nnames introduce ambiguity.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-db6e7f4274aa",
      "originalText": "Package Namespace\nThe package or project name is part of resource identity. This matters when packages, project dependencies, or duplicated model names introduce ambiguity.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-package-namespace"
      }
    },
