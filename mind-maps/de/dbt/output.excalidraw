    {
      "type": "text",
      "version": 1,
      "versionNonce": 6272359458,
      "isDeleted": false,
      "id": "text-9399432bb1f8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2731.88913606918,
      "y": 339.90070881274164,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 667101,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Topological Order\nTopological order means every selected node\nruns only after its selected upstream\ndependencies are ready. It is the execution\nform of the DAG.\n\nExample: `stg_orders` runs before\n`fct_orders`; two unrelated staging models can\nrun at the same time if threads and warehouse\ncapacity allow it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-9399432bb1f8",
      "originalText": "Topological Order\nTopological order means every selected node runs only after its selected upstream dependencies are ready. It is the execution form of the DAG.\n\nExample: `stg_orders` runs before `fct_orders`; two unrelated staging models can run at the same time if threads and warehouse capacity allow it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-topological-order"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1863314868,
      "isDeleted": false,
      "id": "node-b3b1e49ae723",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2829.1726912598806,
