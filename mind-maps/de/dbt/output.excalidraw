    {
      "type": "text",
      "version": 1,
      "versionNonce": 9304782760,
      "isDeleted": false,
      "id": "text-9fb27dd7bee1",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3639.1973704668167,
      "y": -93.08278124612877,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 451.3291015625,
      "height": 105.0,
      "seed": 745263,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "`this` Relation\n`this` is the relation dbt is currently building. It lets model SQL and\nmaterializations refer to the target object for the current node.\n\nExample: an incremental model can compare incoming rows to `{{ this }}`\nso it only processes rows newer than the existing target relation.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-9fb27dd7bee1",
      "originalText": "`this` Relation\n`this` is the relation dbt is currently building. It lets model SQL and materializations refer to the target object for the current node.\n\nExample: an incremental model can compare incoming rows to `{{ this }}` so it only processes rows newer than the existing target relation.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-this-relation"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5132878352,
      "isDeleted": false,
      "id": "node-ee2a3c65f94a",
