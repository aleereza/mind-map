      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Ownership Is A Graph Property\nOwnership should follow dependency boundaries.\nIf many teams depend on a model, the model\nneeds stronger contract, documentation, and\nchange-management expectations.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-dc48632a7f5c",
      "originalText": "Ownership Is A Graph Property\nOwnership should follow dependency boundaries. If many teams depend on a model, the model needs stronger contract, documentation, and change-management expectations.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-ownership-graph-property"
      }
    },
