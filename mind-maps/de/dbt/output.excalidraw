    {
      "type": "text",
      "version": 1,
      "versionNonce": 9611007281,
      "isDeleted": false,
      "id": "text-a0a08fe3abeb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1904.8000000000002,
      "y": 3205.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 369.6,
      "height": 105.0,
      "seed": 435323,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Producer Requirements\nThe upstream project needs public models, a\nsuccessful deployment run, and a production\nenvironment that publishes metadata. Staging\nmetadata can also matter when downstream\ndevelopment resolves pre-prod references.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a0a08fe3abeb",
      "originalText": "Producer Requirements\nThe upstream project needs public models, a successful deployment run, and a production environment that publishes metadata. Staging metadata can also matter when downstream development resolves pre-prod references.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-producer-requirements"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7487999724,
      "isDeleted": false,
      "id": "node-4472b60efbb5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
