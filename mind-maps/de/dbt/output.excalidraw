    {
      "type": "text",
      "version": 1,
      "versionNonce": 6638211923,
      "isDeleted": false,
      "id": "text-15fb7b0264c5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1771.1944326268072,
      "y": 955.1882495658544,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 573.0029296875,
      "height": 97.5,
      "seed": 938668,
      "groupIds": [
        "lge0hos9"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Write Artifacts\nPersist machine-readable outputs for the invocation. Common outputs are `manifest.json`, compiled\nSQL, `run_results.json`, `sources.json` for freshness, logs, timing data, and adapter responses.\n\nThese artifacts turn the command into durable evidence: what dbt understood, what it compiled,\nwhat it ran, what failed, how long it took, and which warehouse relations were involved.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-15fb7b0264c5",
      "originalText": "Write Artifacts\nPersist machine-readable outputs for the invocation. Common outputs are `manifest.json`, compiled SQL, `run_results.json`, `sources.json` for freshness, logs, timing data, and adapter responses.\n\nThese artifacts turn the command into durable evidence: what dbt understood, what it compiled, what it ran, what failed, how long it took, and which warehouse relations were involved.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-write-artifacts"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5864738311,
      "isDeleted": false,
      "id": "node-e2b2d0eb9823",
