      "locked": false,
      "text": "Properties Files\nYAML properties files define resource metadata\nsuch as descriptions, tests, sources,\nexposures, groups, contracts, model versions,\nand source freshness.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
