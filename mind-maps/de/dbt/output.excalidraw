      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Command Lifecycle\nFor `run`, `build`, `test`, `compile`, and similar commands, dbt first constructs\nthe full project graph, then narrows that graph to the requested work, then\ncompiles and executes selected resources.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-5693a1790956",
      "originalText": "Command Lifecycle\nFor `run`, `build`, `test`, `compile`, and similar commands, dbt first constructs the full project graph, then narrows that graph to the requested work, then compiles and executes selected resources.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-command-lifecycle"
      }
    },
