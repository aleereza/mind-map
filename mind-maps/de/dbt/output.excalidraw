      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Other Resource Entrances\nSeeds, snapshots, analyses, exposures,\nmetrics, semantic models, Python models, and\nadapter-specific external table patterns all\nadd graph nodes or metadata. The key question\nis whether dbt owns the object, describes it,\nor merely queries it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f0da91fdadbc",
      "originalText": "Other Resource Entrances\nSeeds, snapshots, analyses, exposures, metrics, semantic models, Python models, and adapter-specific external table patterns all add graph nodes or metadata. The key question is whether dbt owns the object, describes it, or merely queries it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-other-resource-entrances"
      }
    },
