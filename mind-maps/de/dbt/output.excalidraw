      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Indirect Test Selection\nTests are graph resources too. A selected\nmodel can bring in tests directly or\nindirectly depending on selection mode, which\nis why CI commands need explicit\ntest-selection policy.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-cff6f9abca54",
      "originalText": "Indirect Test Selection\nTests are graph resources too. A selected model can bring in tests directly or indirectly depending on selection mode, which is why CI commands need explicit test-selection policy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-indirect-test-selection"
      }
    },
