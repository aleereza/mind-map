      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Unique Key And Strategy\nThe `unique_key` defines update semantics for\nstrategies such as merge. Nulls, changing\ngrain, or weak surrogate keys turn incremental\nmodels into duplicate factories.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-5edacc4b0e89",
      "originalText": "Unique Key And Strategy\nThe `unique_key` defines update semantics for strategies such as merge. Nulls, changing grain, or weak surrogate keys turn incremental models into duplicate factories.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-unique-key-and-strategy"
      }
    },
    {
      "type": "rectangle",
