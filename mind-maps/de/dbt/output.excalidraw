    {
      "type": "text",
      "version": 1,
      "versionNonce": 9428116294,
      "isDeleted": false,
      "id": "text-f7c7501c9cbb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3230.8677649243346,
      "y": -1284.1820180369637,
      "strokeColor": "#065F46",
      "backgroundColor": "transparent",
      "width": 466.8740234375,
      "height": 140.0,
      "seed": 465625,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Merge Exceptions\nMost config values are overwritten by the most-specific value, but some are\nintentionally merged so broad metadata does not disappear when a local\noverride is added.\n\nExamples: tags are additive, `meta` is merged by key, hooks are additive,\nand source freshness can be overridden at a more-specific source or table\nlevel.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f7c7501c9cbb",
      "originalText": "Merge Exceptions\nMost config values are overwritten by the most-specific value, but some are intentionally merged so broad metadata does not disappear when a local override is added.\n\nExamples: tags are additive, `meta` is merged by key, hooks are additive, and source freshness can be overridden at a more-specific source or table level.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-merge-exceptions"
      }
    },
