      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pushdown Shape\nMost dbt performance problems are warehouse\nquery-shape problems: broad scans, fanout\njoins, skew, expensive windows, repeated CTEs,\nor models that hide predicates from the\noptimizer.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-64d4cd68e45e",
      "originalText": "Pushdown Shape\nMost dbt performance problems are warehouse query-shape problems: broad scans, fanout joins, skew, expensive windows, repeated CTEs, or models that hide predicates from the optimizer.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-pushdown-shape"
      }
    },
