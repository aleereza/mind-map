    {
      "type": "text",
      "version": 1,
      "versionNonce": 5791006171,
      "isDeleted": false,
      "id": "text-78cb72d8e14c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2525.4543721975388,
      "y": -334.65720491379034,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 515.9150390625,
      "height": 122.5,
      "seed": 675479,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Selector Methods\nSelector methods are lenses over the manifest. They match resources by metadata\nrather than by only file path or name.\n\nExamples: `tag:finance`, `path:models/marts`, `source:stripe`,\n`config.materialized:incremental`, and `state:modified` each select from a different\nmanifest attribute.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-78cb72d8e14c",
      "originalText": "Selector Methods\nSelector methods are lenses over the manifest. They match resources by metadata rather than by only file path or name.\n\nExamples: `tag:finance`, `path:models/marts`, `source:stripe`, `config.materialized:incremental`, and `state:modified` each select from a different manifest attribute.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-selector-methods"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8819761177,
      "isDeleted": false,
      "id": "node-c06a016d2f0f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3090.1829436075604,
      "y": -498.16732979221,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 522.1373065600371,
      "height": 143.8060707460877,
      "seed": 220930,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
