    {
      "type": "text",
      "version": 1,
      "versionNonce": 5602530383,
      "isDeleted": false,
      "id": "text-0cc00a60bc5c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3907.65564653083,
      "y": -802.4489591065271,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 489.248046875,
      "height": 140.0,
      "seed": 941863,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Parent And Child Maps\nParent and child maps are fast graph indexes derived from dependency\nextraction. They let dbt and tools answer upstream and downstream questions\ndirectly.\n\nExample: `parent_map[\"model.analytics.fct_orders\"]` lists its upstream refs and\nsources; `child_map[\"model.analytics.stg_orders\"]` lists downstream resources\naffected by changes.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-0cc00a60bc5c",
      "originalText": "Parent And Child Maps\nParent and child maps are fast graph indexes derived from dependency extraction. They let dbt and tools answer upstream and downstream questions directly.\n\nExample: `parent_map[\"model.analytics.fct_orders\"]` lists its upstream refs and sources; `child_map[\"model.analytics.stg_orders\"]` lists downstream resources affected by changes.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-parent-child-maps"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4747396190,
      "isDeleted": false,
      "id": "node-81755b7ccbf7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3254.4049523981503,
      "y": -690.4614978760679,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 494.9322952655631,
      "height": 152.22638353915286,
      "seed": 926456,
