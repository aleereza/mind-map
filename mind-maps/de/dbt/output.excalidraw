    {
      "type": "text",
      "version": 1,
      "versionNonce": 4919631385,
      "isDeleted": false,
      "id": "text-81755b7ccbf7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3270.3378969059318,
      "y": -685.4614978760679,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 463.06640625,
      "height": 140.0,
      "seed": 957010,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Disabled Resources\nDisabled resources are parsed enough to be known, but not active in the\nexecutable graph. Keeping them in metadata helps explain why a resource\nexists but is not selected or built.\n\nExample: a model with `enabled: false` may appear in disabled metadata,\nwhile downstream refs to it should fail because it is not an enabled build\ntarget.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-81755b7ccbf7",
      "originalText": "Disabled Resources\nDisabled resources are parsed enough to be known, but not active in the executable graph. Keeping them in metadata helps explain why a resource exists but is not selected or built.\n\nExample: a model with `enabled: false` may appear in disabled metadata, while downstream refs to it should fail because it is not an enabled build target.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-disabled-resources"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7242841078,
      "isDeleted": false,
      "id": "node-3fd79591f80c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3786.2331826042778,
      "y": -628.3398383086558,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
