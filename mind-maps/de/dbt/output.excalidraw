      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Selection Semantics\nSelectors operate on the graph after parsing.\nGraph operators such as ancestors and\ndescendants are powerful because they select\nby dependency structure, not by folders alone.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-57809e1d1bc1",
      "originalText": "Selection Semantics\nSelectors operate on the graph after parsing. Graph operators such as ancestors and descendants are powerful because they select by dependency structure, not by folders alone.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-selection-semantics"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4849779401,
      "isDeleted": false,
