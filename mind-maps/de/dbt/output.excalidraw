      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rebuild Surface\nOptimize the set of nodes you rebuild as\nmuch as individual SQL. State selection,\nsource freshness, deferral, and\norchestration policy determine how much of\nthe DAG pays compute on each run.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b95d40a07b9a",
      "originalText": "Rebuild Surface\nOptimize the set of nodes you rebuild as much as individual SQL. State selection, source freshness, deferral, and orchestration policy determine how much of the DAG pays compute on each run.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-rebuild-surface"
      }
    },
