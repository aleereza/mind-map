      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Developer Feedback Loop\nFusion-powered tooling can catch SQL issues\nearlier, trace column definitions, preview\ninline CTEs, and make large projects feel more\ninteractive during development.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-bc8dd73161ef",
      "originalText": "Developer Feedback Loop\nFusion-powered tooling can catch SQL issues earlier, trace column definitions, preview inline CTEs, and make large projects feel more interactive during development.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-fusion-developer-feedback"
      }
