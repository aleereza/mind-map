      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Artifacts And State\nArtifacts are the durable\nmachine-readable view of what dbt\nunderstood and did. They are the\nbridge between code, warehouse\nruns, docs, CI, Mesh metadata,\nlineage, and observability.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-3ed8f3d0a2a3",
      "originalText": "Artifacts And State\nArtifacts are the durable machine-readable view of what dbt understood and did. They are the bridge between code, warehouse runs, docs, CI, Mesh metadata, lineage, and observability.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-artifacts-and-state"
      }
    },
