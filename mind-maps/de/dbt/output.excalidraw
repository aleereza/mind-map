      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Governance Surface\nThe mature dbt surface is a\ngoverned graph: owners, groups,\naccess, contracts, tests, docs,\nexposures, semantic definitions,\nand artifacts all describe who can\ndepend on what.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-fea0ba3b43aa",
      "originalText": "Governance Surface\nThe mature dbt surface is a governed graph: owners, groups, access, contracts, tests, docs, exposures, semantic definitions, and artifacts all describe who can depend on what.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-governance-surface"
      }
    },
