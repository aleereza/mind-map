      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Static Analysis\nThe static parser can extract simple `ref()`,\n`source()`, and `config()` calls without fully\nrendering every model. Fusion expands this\nidea with native SQL understanding across\ndialects.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-919538e413b5",
      "originalText": "Static Analysis\nThe static parser can extract simple `ref()`, `source()`, and `config()` calls without fully rendering every model. Fusion expands this idea with native SQL understanding across dialects.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-static-analysis"
      }
    },
    {
      "type": "rectangle",
