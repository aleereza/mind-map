      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Core vs Platform\ndbt Core is the open-source local CLI\nframework. The dbt platform, formerly dbt\nCloud, adds hosted development, scheduling,\nCI/CD, docs hosting, monitoring, alerts,\nmetadata services, permissions, and integrated\nproduct surfaces.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-51b4e325192c",
      "originalText": "Core vs Platform\ndbt Core is the open-source local CLI framework. The dbt platform, formerly dbt Cloud, adds hosted development, scheduling, CI/CD, docs hosting, monitoring, alerts, metadata services, permissions, and integrated product surfaces.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-core-vs-platform"
      }
    },
