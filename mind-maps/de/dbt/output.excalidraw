      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manifest Schema\n`manifest.json` is an artifact, not source\nconfig. It contains the full parsed\nrepresentation of enabled project resources:\nnodes, sources, macros, docs, selectors,\nparent map, child map, group map, and more.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-c52f3e66a062",
      "originalText": "Manifest Schema\n`manifest.json` is an artifact, not source config. It contains the full parsed representation of enabled project resources: nodes, sources, macros, docs, selectors, parent map, child map, group map, and more.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-manifest-operational-schema"
      }
    },
