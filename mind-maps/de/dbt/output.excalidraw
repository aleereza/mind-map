      "strokeColor": "#065F46",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 714892,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Conditional Configuration\nUse conditional config for physical\ndifferences, not conceptual differences. If an\nenvironment condition changes model meaning,\nownership, or grain, it should probably be a\nseparate resource or contract decision.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-fddde1db0c9d",
      "originalText": "Conditional Configuration\nUse conditional config for physical differences, not conceptual differences. If an environment condition changes model meaning, ownership, or grain, it should probably be a separate resource or contract decision.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-conditional-configuration"
      }
    },
