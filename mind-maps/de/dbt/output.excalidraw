      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Performance Model\ndbt performance is a combination\nof warehouse SQL shape,\nmaterialization choice,\nincremental correctness, graph\ndesign, parser speed, and\norchestration policy.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-0a1fe12c0408",
      "originalText": "Performance Model\ndbt performance is a combination of warehouse SQL shape, materialization choice, incremental correctness, graph design, parser speed, and orchestration policy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-performance-model"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1787679427,
      "isDeleted": false,
      "id": "node-ef54c8f81675",
