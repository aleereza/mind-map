      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Direct Relation Names\nHard-coded `database.schema.table`\nreferences can be useful escape hatches, but\nthey remove lineage, environment resolution,\ndocs, freshness, and selection semantics.\nUse them only when that tradeoff is\nintentional.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-51c7c45cd6c2",
      "originalText": "Direct Relation Names\nHard-coded `database.schema.table` references can be useful escape hatches, but they remove lineage, environment resolution, docs, freshness, and selection semantics. Use them only when that tradeoff is intentional.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-direct-relation-names"
      }
    },
    {
      "type": "rectangle",
