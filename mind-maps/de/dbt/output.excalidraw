    {
      "type": "text",
      "version": 1,
      "versionNonce": 8426672143,
      "isDeleted": false,
      "id": "text-0f602ac86677",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 4394.587862757146,
      "y": -986.713673063724,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 486.3701171875,
      "height": 140.0,
      "seed": 99538,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dynamic Dependency Risk\nDynamic Jinja can make dependencies difficult to parse and review. It is useful\nfor advanced macros, but risky when it hides the graph that build order and\nownership depend on.\n\nExample: choosing a ref name from an environment variable can surprise\nstate selection and reviewers; prefer explicit `ref()` or documented macro\npatterns when dependency shape matters.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-0f602ac86677",
      "originalText": "Dynamic Dependency Risk\nDynamic Jinja can make dependencies difficult to parse and review. It is useful for advanced macros, but risky when it hides the graph that build order and ownership depend on.\n\nExample: choosing a ref name from an environment variable can surprise state selection and reviewers; prefer explicit `ref()` or documented macro patterns when dependency shape matters.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-dynamic-dependency-risk"
      }
    },
