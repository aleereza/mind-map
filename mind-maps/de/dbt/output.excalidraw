      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Mixed-Environment Tests\nDeferral can make tests query across\nenvironments. Relationship tests are the\nclassic example: one parent may be built in\ndev while another resolves to production or\nstaging.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-4c32fdd2e0f2",
      "originalText": "Mixed-Environment Tests\nDeferral can make tests query across environments. Relationship tests are the classic example: one parent may be built in dev while another resolves to production or staging.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-mixed-environment-tests"
      }
    },
    {
      "type": "rectangle",
