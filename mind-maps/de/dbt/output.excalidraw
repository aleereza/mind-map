      "seed": 138743,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Packages\nPackages are commonly declared in\n`packages.yml` and pull source code into the\ncurrent project, like a software library. They\nare best for macros, reusable transformations,\nor starter projects, not for team-owned\nproduction data APIs.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-4472b60efbb5",
      "originalText": "Packages\nPackages are commonly declared in `packages.yml` and pull source code into the current project, like a software library. They are best for macros, reusable transformations, or starter projects, not for team-owned production data APIs.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-packages"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8094730214,
