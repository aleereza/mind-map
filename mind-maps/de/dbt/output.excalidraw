    {
      "type": "text",
      "version": 1,
      "versionNonce": 5347510075,
      "isDeleted": false,
      "id": "text-ecbc62bf147f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 4380.4859348517275,
      "y": -1184.110081896779,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 454.4873046875,
      "height": 140.0,
      "seed": 85910,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Runtime Relation Strings\nRaw warehouse relation names are invisible to dbt lineage because dbt\ncannot know whether a string is an intended dependency, a comment, or\ndynamic SQL.\n\nExample: `select * from raw.stripe.payments` may run in the warehouse,\nbut dbt will not add source freshness, docs, selection, or lineage behavior\nunless that relation is declared and used through `source()`.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ecbc62bf147f",
      "originalText": "Runtime Relation Strings\nRaw warehouse relation names are invisible to dbt lineage because dbt cannot know whether a string is an intended dependency, a comment, or dynamic SQL.\n\nExample: `select * from raw.stripe.payments` may run in the warehouse, but dbt will not add source freshness, docs, selection, or lineage behavior unless that relation is declared and used through `source()`.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-runtime-relation-strings"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3385018227,
      "isDeleted": false,
      "id": "node-0f602ac86677",
