      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Conditional Sources\nEnvironment-specific source databases can be\nresolved with `target` or `env_var()` while\nkeeping one logical source in the DAG. The\nshape of the graph stays stable while physical\nrelation names change by environment.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-87ae347775ed",
      "originalText": "Conditional Sources\nEnvironment-specific source databases can be resolved with `target` or `env_var()` while keeping one logical source in the DAG. The shape of the graph stays stable while physical relation names change by environment.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-conditional-sources"
      }
    },
