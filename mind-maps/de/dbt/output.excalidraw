      "updated": 1,
      "link": null,
      "locked": false,
      "text": "State-Aware Orchestration\nState-aware orchestration uses code and\ndata-change awareness to skip models that do\nnot need rebuilding. It is a platform feature\ntied to Fusion and depends on metadata\nquality.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-2fe15202a8a0",
      "originalText": "State-Aware Orchestration\nState-aware orchestration uses code and data-change awareness to skip models that do not need rebuilding. It is a platform feature tied to Fusion and depends on metadata quality.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-state-aware-orchestration"
      }
    },
