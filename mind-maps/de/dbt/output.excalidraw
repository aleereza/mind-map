      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 4457039437,
      "isDeleted": false,
      "id": "text-9b0f2cff32bf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3646.9184773692245,
      "y": -423.46918379855447,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 596.9072265625,
      "height": 192.5,
      "seed": 153062,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "State And Deferral Inputs\nState and deferral read a previous manifest so dbt can compare code changes or resolve unbuilt\nupstream relations. They exist to make slim CI and local partial builds practical.\n\nIn Core, you provide artifact paths explicitly with flags such as `--state path/to/prod_artifacts` and\noptionally `--defer-state`. Example: `--select state:modified+ --defer` selects changed resources\nand can resolve unbuilt parents from the comparison manifest.\n\nIn the dbt platform, Studio IDE and dbt CLI development can natively defer to production\nmetadata, and CI or merge jobs can compare against production environment artifacts without\nyou manually managing a local artifact directory.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-9b0f2cff32bf",
      "originalText": "State And Deferral Inputs\nState and deferral read a previous manifest so dbt can compare code changes or resolve unbuilt upstream relations. They exist to make slim CI and local partial builds practical.\n\nIn Core, you provide artifact paths explicitly with flags such as `--state path/to/prod_artifacts` and optionally `--defer-state`. Example: `--select state:modified+ --defer` selects changed resources and can resolve unbuilt parents from the comparison manifest.\n\nIn the dbt platform, Studio IDE and dbt CLI development can natively defer to production metadata, and CI or merge jobs can compare against production environment artifacts without you manually managing a local artifact directory.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-state-and-deferral-inputs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
