      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Node Identity\nEvery resource has a stable identity such as\n`model.project_name.model_name` or\n`source.project_name.source_name.table_name`.\nThat identity is the join key across\nselection, artifacts, lineage, tests, docs,\nand run results.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-db014cd9bcab",
      "originalText": "Node Identity\nEvery resource has a stable identity such as `model.project_name.model_name` or `source.project_name.source_name.table_name`. That identity is the join key across selection, artifacts, lineage, tests, docs, and run results.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-node-identity"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7189935683,
      "isDeleted": false,
      "id": "node-db6e7f4274aa",
