      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Graph Cost Shape\nThe same SQL can be cheap or expensive\ndepending on graph placement. A heavy model\nupstream of many consumers deserves a\ndifferent materialization and testing strategy\nthan a one-off branch.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-640076be66f6",
      "originalText": "Graph Cost Shape\nThe same SQL can be cheap or expensive depending on graph placement. A heavy model upstream of many consumers deserves a different materialization and testing strategy than a one-off branch.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-graph-cost-shape"
      }
    },
