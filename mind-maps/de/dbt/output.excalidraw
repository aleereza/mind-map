      "seed": 501556,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Volatile Parse Inputs\nAvoid using values such as `run_started_at`,\n`invocation_id`, or runtime-only flags to set\ndependencies, configs, or resource properties.\nThey make parse-time state harder to cache and\nreason about.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ec9d1ff54876",
      "originalText": "Volatile Parse Inputs\nAvoid using values such as `run_started_at`, `invocation_id`, or runtime-only flags to set dependencies, configs, or resource properties. They make parse-time state harder to cache and reason about.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-volatile-parse-inputs"
      }
    },
