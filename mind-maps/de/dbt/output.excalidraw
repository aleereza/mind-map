    {
      "type": "text",
      "version": 1,
      "versionNonce": 6710798714,
      "isDeleted": false,
      "id": "text-981c42a0e7d6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3229.864478431007,
      "y": -1444.5252701201086,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 472.8828125,
      "height": 122.5,
      "seed": 169223,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Package Namespace\nPackage namespace prevents resources from different projects or packages\nfrom colliding. It comes from each package's `dbt_project.yml` `name`.\n\nExample: `ref('orders')` looks in the current namespace first, while\n`ref('finance', 'orders')` points at a model in the `finance` namespace when\ncross-package or cross-project references are valid.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-981c42a0e7d6",
      "originalText": "Package Namespace\nPackage namespace prevents resources from different projects or packages from colliding. It comes from each package's `dbt_project.yml` `name`.\n\nExample: `ref('orders')` looks in the current namespace first, while `ref('finance', 'orders')` points at a model in the `finance` namespace when cross-package or cross-project references are valid.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-package-namespace"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8250592994,
      "isDeleted": false,
      "id": "node-f1864ea1153c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3758.1960117910867,
      "y": -1476.1591245476518,
      "strokeColor": "#1E3A8A",
