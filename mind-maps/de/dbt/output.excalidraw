      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Environments And Targets\nAn environment is the execution\ncontext. A target is the active\nwarehouse connection and naming\ncontext that compiles logical dbt\nresources into physical objects.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-cca88e6499a8",
      "originalText": "Environments And Targets\nAn environment is the execution context. A target is the active warehouse connection and naming context that compiles logical dbt resources into physical objects.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-environments-and-targets"
      }
    },
