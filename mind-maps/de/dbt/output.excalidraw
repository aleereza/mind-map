    {
      "type": "text",
      "version": 1,
      "versionNonce": 6729813005,
      "isDeleted": false,
      "id": "text-a300d1015c67",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3329.0374649549904,
      "y": 74.90372314797878,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 510.48046875,
      "height": 122.5,
      "seed": 532818,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Relation Resolution\nRelation resolution turns logical dbt references into physical warehouse object\nnames. This is where environment-specific database, schema, alias, identifier, and\nquoting rules become concrete.\n\nExample: `{{ ref('stg_orders') }}` might compile to `analytics_dev.alice.stg_orders`\nlocally and `analytics_prod.marts.stg_orders` in production.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a300d1015c67",
      "originalText": "Relation Resolution\nRelation resolution turns logical dbt references into physical warehouse object names. This is where environment-specific database, schema, alias, identifier, and quoting rules become concrete.\n\nExample: `{{ ref('stg_orders') }}` might compile to `analytics_dev.alice.stg_orders` locally and `analytics_prod.marts.stg_orders` in production.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-relation-resolution"
      }
    },
