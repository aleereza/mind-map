    {
      "type": "text",
      "version": 1,
      "versionNonce": 6450397951,
      "isDeleted": false,
      "id": "text-b8a31b19b6c3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2653.0222452360676,
      "y": -1877.5931959327934,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 626.4111328125,
      "height": 140.0,
      "seed": 364744,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Macro And Test Files\nMacros are reusable Jinja functions, and tests are SQL assertions or generic test macros. dbt parses\nthem early because they can affect compilation, materializations, test nodes, and dependency\nextraction.\n\nExamples: `macros/generate_schema_name.sql` can override schema naming;\n`tests/assert_positive_revenue.sql` is a singular test; a generic `test_not_empty_string` macro can be\nreferenced from a column test.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b8a31b19b6c3",
      "originalText": "Macro And Test Files\nMacros are reusable Jinja functions, and tests are SQL assertions or generic test macros. dbt parses them early because they can affect compilation, materializations, test nodes, and dependency extraction.\n\nExamples: `macros/generate_schema_name.sql` can override schema naming; `tests/assert_positive_revenue.sql` is a singular test; a generic `test_not_empty_string` macro can be referenced from a column test.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-lifecycle-macro-and-test-files"
      }
    },
