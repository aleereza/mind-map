      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Environment Isolation\nKeep logical resource names stable while\nisolating physical data, credentials, schemas,\nroles, branches, and permissions. The DAG\nshould not fork just because dev and prod live\nin different places.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-775277c02bf0",
      "originalText": "Environment Isolation\nKeep logical resource names stable while isolating physical data, credentials, schemas, roles, branches, and permissions. The DAG should not fork just because dev and prod live in different places.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-environment-isolation"
      }
    },
