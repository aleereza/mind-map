      "updated": 1,
      "link": null,
      "locked": false,
      "text": "dbt Mesh\nMesh is an organizational pattern for scaling\ndbt across teams. It turns selected models\ninto governed interfaces instead of forcing\nevery consumer into the same monolithic\nproject.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-851da7f1a872",
      "originalText": "dbt Mesh\nMesh is an organizational pattern for scaling dbt across teams. It turns selected models into governed interfaces instead of forcing every consumer into the same monolithic project.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbt-mesh"
      }
    },
