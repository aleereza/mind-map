      "height": 105.0,
      "seed": 57206,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Materialization Choice\nMaterialization decides how a model persists:\nview, table, incremental, ephemeral,\nmaterialized view, or a custom\nadapter-specific implementation. This is the\nbiggest dbt-level performance lever.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ef54c8f81675",
      "originalText": "Materialization Choice\nMaterialization decides how a model persists: view, table, incremental, ephemeral, materialized view, or a custom adapter-specific implementation. This is the biggest dbt-level performance lever.",
      "lineHeight": 1.25,
