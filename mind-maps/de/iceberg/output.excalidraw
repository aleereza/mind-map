      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Metadata File\nThe metadata file, usually a JSON file, holds\nthe table state: the schemas, the partition\nspecs, the sort orders, the table properties,\nthe list of snapshots, and which snapshot is\ncurrent. Each commit writes a new metadata\nfile instead of editing the old one.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-338819120d7f",
      "originalText": "Metadata File\nThe metadata file, usually a JSON file, holds the table state: the schemas, the partition specs, the sort orders, the table properties, the list of snapshots, and which snapshot is current. Each commit writes a new metadata file instead of editing the old one.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "metadata-file"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4331671470,
      "isDeleted": false,
      "id": "node-c004e50c8e13",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 1105.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 111.5,
      "seed": 657106,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
