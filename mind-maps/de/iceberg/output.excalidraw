    {
      "type": "text",
      "version": 1,
      "versionNonce": 8144094575,
      "isDeleted": false,
      "id": "text-ff3a6f3b41f1",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1883.2,
      "y": 4977.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 378.0,
      "height": 87.5,
      "seed": 710147,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rollback\nRollback sets the current snapshot back to\nan earlier one. The bad commit stops being\nvisible, and no data file is rewritten. It\nis the fastest repair after a wrong write.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-ff3a6f3b41f1",
      "originalText": "Rollback\nRollback sets the current snapshot back to an earlier one. The bad commit stops being visible, and no data file is rewritten. It is the fastest repair after a wrong write.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "rollback"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8190818254,
      "isDeleted": false,
      "id": "node-eed0a88eb59e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1871.2,
      "y": 5123.75,
