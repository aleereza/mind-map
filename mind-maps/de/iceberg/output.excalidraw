    {
      "type": "text",
      "version": 1,
      "versionNonce": 6493366860,
      "isDeleted": false,
      "id": "text-3176cc8605b4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 715.2,
      "y": 6157.25,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 377.99999999999994,
      "height": 112.5,
      "seed": 516958,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Catalogs & Engines\nIceberg needs two external roles:\na catalog that owns the table\npointer, and one or more engines\nthat read and write the files.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-3176cc8605b4",
      "originalText": "Catalogs & Engines\nIceberg needs two external roles: a catalog that owns the table pointer, and one or more engines that read and write the files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "catalogs-and-engines"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6318710958,
      "isDeleted": false,
      "id": "node-45fb89878081",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 6031.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 164.0,
      "seed": 377733,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-45fb89878081"
        },
        {
          "id": "edge-2fe8b27504e4",
          "type": "arrow"
        },
        {
          "id": "edge-6177c5a96ed1",
          "type": "arrow"
        },
        {
          "id": "edge-221a44ac2c03",
          "type": "arrow"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
