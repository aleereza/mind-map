      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Engine Prunes Manifests\nThe engine compares the query filter against\nthe partition ranges in the manifest list.\nManifests that cannot hold a matching row are\nskipped.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-99c653a2e19b",
      "originalText": "Engine Prunes Manifests\nThe engine compares the query filter against the partition ranges in the manifest list. Manifests that cannot hold a matching row are skipped.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "read-prune-manifests"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2941309442,
      "isDeleted": false,
      "id": "node-d0074aed9e64",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
