    {
      "type": "text",
      "version": 1,
      "versionNonce": 1750763693,
      "isDeleted": false,
      "id": "text-d0074aed9e64",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1579.2,
      "y": 3424.25,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 397.8,
      "height": 81.25,
      "seed": 312611,
      "groupIds": [
        "sj9n5tip"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Engine Prunes Data Files\nInside the remaining manifests, the engine compares\nthe filter against each file's partition values and\ncolumn statistics. Files that cannot match are\nskipped without being opened.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-d0074aed9e64",
      "originalText": "Engine Prunes Data Files\nInside the remaining manifests, the engine compares the filter against each file's partition values and column statistics. Files that cannot match are skipped without being opened.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "read-prune-files"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4549278110,
      "isDeleted": false,
      "id": "node-b756de80c390",
