    {
      "type": "text",
      "version": 1,
      "versionNonce": 1684295688,
      "isDeleted": false,
      "id": "text-eed0a88eb59e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1883.2,
      "y": 5128.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 836284,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Branches & Tags\nA branch and a tag are named references to a\nsnapshot. A tag pins one snapshot, for example\na month-end version. A branch lets a writer\npublish several commits away from the main\nline, then merge or promote them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-eed0a88eb59e",
      "originalText": "Branches & Tags\nA branch and a tag are named references to a snapshot. A tag pins one snapshot, for example a month-end version. A branch lets a writer publish several commits away from the main line, then merge or promote them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "branches-and-tags"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4146494074,
      "isDeleted": false,
      "id": "node-58c1ba9eeefc",
