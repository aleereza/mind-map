      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Catalog Swaps the Pointer\nThe catalog moves the table pointer from the\nold metadata file to the new one in one atomic\noperation. This swap is the commit. Until it\nhappens, the new files are invisible; after it\nhappens, they are fully visible.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-f2ab33e454a9",
      "originalText": "Catalog Swaps the Pointer\nThe catalog moves the table pointer from the old metadata file to the new one in one atomic operation. This swap is the commit. Until it happens, the new files are invisible; after it happens, they are fully visible.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "write-commit-swap"
      }
    },
