      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1218919296,
      "isDeleted": false,
      "id": "text-45fb89878081",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 6031.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 1942,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Catalog Role\nThe catalog maps a table name to its current\nmetadata file, and it performs the pointer\nswap as one atomic operation. It also holds\nnamespaces, and it is often where access\ncontrol lives. Without a catalog there is no\nsafe commit, because two writers could\noverwrite each other. The catalog stays\ndeliberately thin: it owns the pointer, the\nnames, and the permissions, not the table\nmetadata itself.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-45fb89878081",
      "originalText": "Catalog Role\nThe catalog maps a table name to its current metadata file, and it performs the pointer swap as one atomic operation. It also holds namespaces, and it is often where access control lives. Without a catalog there is no safe commit, because two writers could overwrite each other. The catalog stays deliberately thin: it owns the pointer, the names, and the permissions, not the table metadata itself.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "catalog-role"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9505738672,
      "isDeleted": false,
      "id": "node-6ec2c47324d8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 5873.75,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 765275,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
