      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Writer Builds New Metadata File\nThe engine writes a new metadata file. It adds the\nnew snapshot, points the current snapshot at it,\nand keeps the older snapshots in the list.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-fe1438723c05",
      "originalText": "Writer Builds New Metadata File\nThe engine writes a new metadata file. It adds the new snapshot, points the current snapshot at it, and keeps the older snapshots in the list.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "write-metadata-file"
      }
    },
