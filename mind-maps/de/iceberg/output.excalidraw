    {
      "type": "text",
      "version": 1,
      "versionNonce": 5332261133,
      "isDeleted": false,
      "id": "text-fa07874e4d2b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 1599.5,
      "strokeColor": "#1E3A8A",
