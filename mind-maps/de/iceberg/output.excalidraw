    {
      "type": "text",
      "version": 1,
      "versionNonce": 1674336144,
      "isDeleted": false,
      "id": "text-e6fb95651670",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6000000000001,
      "y": 6268.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 157.5,
      "seed": 179405,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Common Engines\nApache Spark and Apache Flink are the usual\nwriters, and Flink covers streaming ingestion.\nTrino, Presto, Dremio, Apache Impala,\nStarRocks, ClickHouse, and DuckDB are common\nquery engines. Snowflake, Databricks, Google\nBigQuery, and Amazon Athena read Iceberg\ntables as well, and some of them can also\nmanage and write them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e6fb95651670",
      "originalText": "Common Engines\nApache Spark and Apache Flink are the usual writers, and Flink covers streaming ingestion. Trino, Presto, Dremio, Apache Impala, StarRocks, ClickHouse, and DuckDB are common query engines. Snowflake, Databricks, Google BigQuery, and Amazon Athena read Iceberg tables as well, and some of them can also manage and write them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "common-engines"
      }
    },
