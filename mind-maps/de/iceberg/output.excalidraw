        "node_id": "copy-on-write"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2102780663,
      "isDeleted": false,
      "id": "text-b48ef1511b4c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 3928.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 955254,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Copy-on-Write\nThe writer rewrites every data file that holds\nan affected row. Writes cost more, and reads\nstay fast because there is nothing extra to\nmerge. This suits tables that change in large,\ninfrequent batches.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b48ef1511b4c",
      "originalText": "Copy-on-Write\nThe writer rewrites every data file that holds an affected row. Writes cost more, and reads stay fast because there is nothing extra to merge. This suits tables that change in large, infrequent batches.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "copy-on-write"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1659200579,
      "isDeleted": false,
      "id": "node-9cd79dabe9c4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 4092.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 129.0,
      "seed": 409927,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-9cd79dabe9c4"
        },
        {
          "id": "edge-1bee8fe7be29",
          "type": "arrow"
