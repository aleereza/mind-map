      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Evolution & Time Travel\nBecause the table is described by\nmetadata, several changes that\nonce needed a rewrite become\nmetadata operations.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-800313cd1eff",
      "originalText": "Evolution & Time Travel\nBecause the table is described by metadata, several changes that once needed a rewrite become metadata operations.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "evolution-and-time-travel"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1524260933,
      "isDeleted": false,
      "id": "node-a8e87dc40958",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
