    {
      "type": "text",
      "version": 1,
      "versionNonce": 5076756391,
      "isDeleted": false,
      "id": "text-d9676a1c97f1",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 5466.75,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 470156,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Expiry Is Not a Backup\nExpiry deletes data permanently and shortens\nthe time-travel window. A rollback is\nimpossible once its snapshot is gone. Keep a\nreal backup, or a replicated copy, for\ndisaster recovery.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-d9676a1c97f1",
      "originalText": "Expiry Is Not a Backup\nExpiry deletes data permanently and shortens the time-travel window. A rollback is impossible once its snapshot is gone. Keep a real backup, or a replicated copy, for disaster recovery.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "expiry-not-backup"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1123720413,
      "isDeleted": false,
      "id": "node-dea2afeae364",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
