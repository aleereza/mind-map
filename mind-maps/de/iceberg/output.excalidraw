      "y": 3419.25,
      "strokeColor": "#1F2937",
      "backgroundColor": "#F9FAFB",
      "width": 417.8,
      "height": 101.25,
      "seed": 986087,
      "groupIds": [
        "sj9n5tip"
      ],
      "frameId": null,
