      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Catalog Pointer\nThe catalog stores one value per table: the\nlocation of the current metadata file. A\ncommit replaces that value. All readers start\nhere, so the pointer defines what the table is\nright now.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-6b883807b03e",
      "originalText": "Catalog Pointer\nThe catalog stores one value per table: the location of the current metadata file. A commit replaces that value. All readers start here, so the pointer defines what the table is right now.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "catalog-pointer"
      }
    },
