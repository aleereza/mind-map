      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Delete Files\nA delete file marks rows as removed without\nrewriting the data file. A position delete\nnames a file and the row positions inside it.\nAn equality delete names column values that\nmust disappear. Readers apply the delete files\nthat belong to the snapshot.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-dab4fd3c11eb",
      "originalText": "Delete Files\nA delete file marks rows as removed without rewriting the data file. A position delete names a file and the row positions inside it. An equality delete names column values that must disappear. Readers apply the delete files that belong to the snapshot.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "delete-files"
      }
    },
