    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5950943219,
      "isDeleted": false,
      "id": "text-1fe7a21457bf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 3706.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 157.5,
      "seed": 557021,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Concurrency Control\nTwo writers can work at the same time, because\neach one writes its own files and its own\nmetadata file. Only the pointer swap must be\nserialized, and the catalog guarantees that.\nThe writer that loses the race revalidates its\nchange against the new current snapshot and\nretries. Conflicts are therefore detected in\nmetadata, not by locking data files.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-1fe7a21457bf",
      "originalText": "Concurrency Control\nTwo writers can work at the same time, because each one writes its own files and its own metadata file. Only the pointer swap must be serialized, and the catalog guarantees that. The writer that loses the race revalidates its change against the new current snapshot and retries. Conflicts are therefore detected in metadata, not by locking data files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "concurrency-control"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5549574244,
      "isDeleted": false,
      "id": "node-93c902533cd4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 4007.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 129.0,
      "seed": 739262,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
