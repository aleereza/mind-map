      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Engine Asks the Catalog\nThe engine reads the table pointer and loads\nthe current metadata file. It never lists\nstorage directories to discover the table\ncontent.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-d81ae5189c86",
      "originalText": "Engine Asks the Catalog\nThe engine reads the table pointer and loads the current metadata file. It never lists storage directories to discover the table content.",
