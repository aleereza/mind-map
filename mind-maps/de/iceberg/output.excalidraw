      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "node_id": "merge-on-read"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3412654106,
      "isDeleted": false,
      "id": "text-9cd79dabe9c4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 4097.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 988891,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Merge-on-Read\nThe writer keeps the data files and writes\ndelete files instead. Writes are fast, and\nreads cost more because the engine must apply\nthe deletes. This suits frequent small\nchanges, and it needs regular compaction.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-9cd79dabe9c4",
      "originalText": "Merge-on-Read\nThe writer keeps the data files and writes delete files instead. Writes are fast, and reads cost more because the engine must apply the deletes. This suits frequent small changes, and it needs regular compaction.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "merge-on-read"
      }
    },
    {
      "type": "rectangle",
