    {
      "type": "text",
      "version": 1,
      "versionNonce": 5438856407,
      "isDeleted": false,
      "id": "text-78377f3e6ef2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 4528.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 140.0,
      "seed": 403639,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hidden Partitioning\nThe partition value is derived from a source\ncolumn by a transform recorded in the spec.\nQueries filter on the real column, for example\n`event_time`, and the engine derives the\npartition itself. You do not add a separate\npartition column, and a query does not break\nwhen the partition rule changes.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-78377f3e6ef2",
      "originalText": "Hidden Partitioning\nThe partition value is derived from a source column by a transform recorded in the spec. Queries filter on the real column, for example `event_time`, and the engine derives the partition itself. You do not add a separate partition column, and a query does not break when the partition rule changes.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "hidden-partitioning"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9422599761,
      "isDeleted": false,
      "id": "node-f048ac846735",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 4447.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 129.0,
      "seed": 671020,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
