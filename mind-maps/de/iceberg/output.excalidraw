    {
      "type": "text",
      "version": 1,
      "versionNonce": 7113188737,
      "isDeleted": false,
      "id": "text-c004e50c8e13",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 1110.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 87.5,
      "seed": 35687,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Schema\nThe schema lists the columns with a stable\nfield ID for each one. Engines match columns\nby field ID, not by name or position. This is\nwhy a rename does not break old data files.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-c004e50c8e13",
      "originalText": "Schema\nThe schema lists the columns with a stable field ID for each one. Engines match columns by field ID, not by name or position. This is why a rename does not break old data files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "table-schema"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8326803987,
      "isDeleted": false,
      "id": "node-b713a273ccc7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 1256.5,
