    {
      "type": "text",
      "version": 1,
      "versionNonce": 9187786990,
      "isDeleted": false,
      "id": "text-3e72d712677f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 310.07578939757195,
      "y": 808.49474677352,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 335.2833251953125,
      "height": 140.0,
      "seed": 888314,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hive-Style Directory Table\nIn the older model, a directory path is the table and a\nsubdirectory is a partition. The engine must list\nstorage to find the data, so the listing is slow and\neventually inconsistent. There is no atomic commit, so\na reader can see a partly written result. Renaming a\ncolumn, or changing the partition layout, usually\nneeds a full rewrite.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-3e72d712677f",
      "originalText": "Hive-Style Directory Table\nIn the older model, a directory path is the table and a subdirectory is a partition. The engine must list storage to find the data, so the listing is slow and eventually inconsistent. There is no atomic commit, so a reader can see a partly written result. Renaming a column, or changing the partition layout, usually needs a full rewrite.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "hive-style-table"
      }
    },
    {
