    {
      "type": "text",
      "version": 1,
      "versionNonce": 9319605698,
      "isDeleted": false,
      "id": "text-32380cfc95a4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6000000000001,
      "y": 5297.75,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 999899,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Small Files Still Hurt\nIceberg tracks small files well, but it does\nnot merge them for you. Streaming writes and\nfrequent commits create many tiny files, which\nslows planning and reading. Treat compaction\nas a required job, not an optional one.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-32380cfc95a4",
      "originalText": "Small Files Still Hurt\nIceberg tracks small files well, but it does not merge them for you. Streaming writes and frequent commits create many tiny files, which slows planning and reading. Treat compaction as a required job, not an optional one.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "small-files-warning"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8050851792,
      "isDeleted": false,
      "id": "node-a3acfa1244f9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 5461.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 129.0,
      "seed": 694595,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
