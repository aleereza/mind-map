      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data Files\nThe data files hold the rows, normally as\nParquet, and sometimes as ORC or Avro. They\nlive in object storage such as S3, GCS, ADLS,\nor HDFS. They are immutable: a writer adds new\nfiles and never edits a committed one.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-8587b0e13dc0",
      "originalText": "Data Files\nThe data files hold the rows, normally as Parquet, and sometimes as ORC or Avro. They live in object storage such as S3, GCS, ADLS, or HDFS. They are immutable: a writer adds new files and never edits a committed one.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "data-files"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5729150227,
      "isDeleted": false,
      "id": "node-dab4fd3c11eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 2119.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 146.5,
