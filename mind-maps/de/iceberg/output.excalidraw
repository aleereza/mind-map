      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Writer Writes Manifests\nThe engine records the new files, with their\npartition values and column statistics, in one or\nmore manifests. It then writes a manifest list for\nthe new snapshot, reusing the manifests that did\nnot change.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-a25594db2c12",
      "originalText": "Writer Writes Manifests\nThe engine records the new files, with their partition values and column statistics, in one or more manifests. It then writes a manifest list for the new snapshot, reusing the manifests that did not change.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "write-manifests"
      }
    },
