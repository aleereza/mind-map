    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 7178931423,
      "isDeleted": false,
      "id": "text-4ead7a94e790",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 5053.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 378.0,
      "height": 105.0,
      "seed": 462979,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Time Travel\nBecause old snapshots stay listed in the\nmetadata file, you can query the table as it\nwas, by snapshot ID or by timestamp. This is\nuseful for audits, for comparing results,\nand for debugging a bad load.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-4ead7a94e790",
      "originalText": "Time Travel\nBecause old snapshots stay listed in the metadata file, you can query the table as it was, by snapshot ID or by timestamp. This is useful for audits, for comparing results, and for debugging a bad load.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "time-travel"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9267223421,
      "isDeleted": false,
      "id": "node-ff3a6f3b41f1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1871.2,
      "y": 4972.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 402.0,
      "height": 111.5,
      "seed": 804188,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
