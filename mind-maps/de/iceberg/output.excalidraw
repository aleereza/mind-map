      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manifest List\nEach snapshot has one manifest list. It\nnames the manifests in the snapshot and, for\neach one, the partition value ranges and the\nfile counts. This lets an engine skip whole\nmanifests before it reads them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-fa07874e4d2b",
      "originalText": "Manifest List\nEach snapshot has one manifest list. It names the manifests in the snapshot and, for each one, the partition value ranges and the file counts. This lets an engine skip whole manifests before it reads them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "manifest-list"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5805783799,
      "isDeleted": false,
      "id": "node-af1f1ed4026c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
