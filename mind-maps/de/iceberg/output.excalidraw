    {
      "type": "text",
      "version": 1,
      "versionNonce": 8810840281,
      "isDeleted": false,
      "id": "text-338819120d7f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
