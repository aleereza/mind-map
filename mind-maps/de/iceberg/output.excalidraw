    {
      "type": "text",
      "version": 1,
      "versionNonce": 1061669207,
      "isDeleted": false,
      "id": "text-f048ac846735",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6000000000001,
      "y": 4452.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 811856,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partition Transforms\nThe common transforms are `identity`, `year`,\n`month`, `day`, `hour`, `bucket(N, col)`, and\n`truncate(N, col)`. Time transforms group rows\nby period. `bucket` spreads values evenly by\nhash, which suits high-cardinality keys.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f048ac846735",
      "originalText": "Partition Transforms\nThe common transforms are `identity`, `year`, `month`, `day`, `hour`, `bucket(N, col)`, and `truncate(N, col)`. Time transforms group rows by period. `bucket` spreads values evenly by hash, which suits high-cardinality keys.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "partition-transforms"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4433160177,
      "isDeleted": false,
      "id": "node-565c7ae18efe",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 4616.75,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 410.40000000000003,
      "height": 146.5,
      "seed": 969652,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
