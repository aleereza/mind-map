    {
      "type": "text",
      "version": 1,
      "versionNonce": 5133824698,
      "isDeleted": false,
      "id": "text-e94025be336b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 1430.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 361125,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snapshot\nA snapshot is the complete set of data files\nat one commit. It has an ID, a timestamp, a\nsummary of the operation, and a link to one\nmanifest list. Old snapshots stay in the\nmetadata file until you expire them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e94025be336b",
      "originalText": "Snapshot\nA snapshot is the complete set of data files at one commit. It has an ID, a timestamp, a summary of the operation, and a link to one manifest list. Old snapshots stay in the metadata file until you expire them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "snapshot"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7408335563,
      "isDeleted": false,
      "id": "node-fa07874e4d2b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
