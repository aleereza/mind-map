    {
      "type": "text",
      "version": 1,
      "versionNonce": 9932919800,
      "isDeleted": false,
      "id": "text-e8509aaed8aa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 4808.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 675811,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partition Evolution\nYou can change the partition spec, for example\nfrom `day` to `hour`, without rewriting\nhistory. Old files keep the spec that produced\nthem, new files use the new spec, and the\nengine plans across both.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e8509aaed8aa",
      "originalText": "Partition Evolution\nYou can change the partition spec, for example from `day` to `hour`, without rewriting history. Old files keep the spec that produced them, new files use the new spec, and the engine plans across both.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "partition-evolution"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8600194617,
      "isDeleted": false,
      "id": "node-4ead7a94e790",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 5048.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 402.0,
      "height": 129.0,
