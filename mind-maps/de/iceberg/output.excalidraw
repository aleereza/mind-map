    {
      "type": "text",
      "version": 1,
      "versionNonce": 9408421680,
      "isDeleted": false,
      "id": "text-a3acfa1244f9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 5466.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 138038,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snapshot Expiry\nExpiry removes old snapshots from the\nmetadata, then deletes the data files that\nonly those snapshots referenced. It controls\nmetadata size and storage cost, and it sets\nhow far back you can travel.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a3acfa1244f9",
      "originalText": "Snapshot Expiry\nExpiry removes old snapshots from the metadata, then deletes the data files that only those snapshots referenced. It controls metadata size and storage cost, and it sets how far back you can travel.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "snapshot-expiry"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7009149041,
      "isDeleted": false,
      "id": "node-d9676a1c97f1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 5461.75,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 129.0,
      "seed": 877276,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
