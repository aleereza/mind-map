    {
      "type": "text",
      "version": 1,
      "versionNonce": 7719791612,
      "isDeleted": false,
      "id": "text-1dd8ffd8be7a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 5839.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 829463,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manifest Rewrite\nMany small commits leave many small manifests,\nand pruning gets weaker. A manifest rewrite\nregroups the file entries, usually by\npartition, so the manifest list ranges stay\nnarrow and planning stays fast.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-1dd8ffd8be7a",
      "originalText": "Manifest Rewrite\nMany small commits leave many small manifests, and pruning gets weaker. A manifest rewrite regroups the file entries, usually by partition, so the manifest list ranges stay narrow and planning stays fast.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "manifest-rewrite"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7027580610,
      "isDeleted": false,
      "id": "node-3176cc8605b4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 699.2,
      "y": 6152.25,
      "strokeColor": "#0F172A",
      "backgroundColor": "#DBEAFE",
      "width": 409.99999999999994,
      "height": 144.5,
      "seed": 675980,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 12
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-3176cc8605b4"
        },
