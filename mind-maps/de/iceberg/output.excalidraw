    {
      "type": "text",
      "version": 1,
      "versionNonce": 9397951407,
      "isDeleted": false,
      "id": "text-dea2afeae364",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 5635.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 140.0,
      "seed": 60663,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Orphan File Cleanup\nA failed or aborted write can leave files in\nstorage that no metadata references. These\norphans cost money and are invisible to\nqueries. Cleanup compares storage against the\nmetadata and removes them, so it must use a\nsafe age threshold to avoid deleting files\nfrom a write that is still running.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-dea2afeae364",
      "originalText": "Orphan File Cleanup\nA failed or aborted write can leave files in storage that no metadata references. These orphans cost money and are invisible to queries. Cleanup compares storage against the metadata and removes them, so it must use a safe age threshold to avoid deleting files from a write that is still running.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "orphan-file-cleanup"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8213079541,
      "isDeleted": false,
      "id": "node-1dd8ffd8be7a",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
