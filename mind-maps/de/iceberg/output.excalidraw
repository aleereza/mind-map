    {
      "type": "text",
      "version": 1,
      "versionNonce": 7861414959,
      "isDeleted": false,
      "id": "text-8587b0e13dc0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 1955.0,
      "strokeColor": "#1E3A8A",
