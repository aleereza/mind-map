    {
      "type": "text",
      "version": 1,
      "versionNonce": 5476974016,
      "isDeleted": false,
      "id": "text-af1f1ed4026c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 1768.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 122.5,
      "seed": 868141,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Manifest File\nA manifest lists data files. For each file it\nrecords the path, the partition values, the\nrow count, the file size, and column\nstatistics such as minimum, maximum, and null\ncounts. These statistics make file pruning\npossible without opening the files.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-af1f1ed4026c",
      "originalText": "Manifest File\nA manifest lists data files. For each file it records the path, the partition values, the row count, the file size, and column statistics such as minimum, maximum, and null counts. These statistics make file pruning possible without opening the files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "manifest-file"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7543466346,
      "isDeleted": false,
      "id": "node-8587b0e13dc0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 1950.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 129.0,
      "seed": 903158,
      "groupIds": [],
      "frameId": null,
