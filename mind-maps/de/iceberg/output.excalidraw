      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Table Anatomy\nThe metadata forms a small tree.\nOne pointer in the catalog leads\nto a metadata file, the metadata\nfile names a snapshot, the\nsnapshot names a manifest list,\nand the manifest list names the\nmanifests that list the data\nfiles.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-89dae63b736c",
      "originalText": "Table Anatomy\nThe metadata forms a small tree. One pointer in the catalog leads to a metadata file, the metadata file names a snapshot, the snapshot names a manifest list, and the manifest list names the manifests that list the data files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "table-anatomy"
      }
    },
