      "locked": false,
      "text": "Compaction\nCompaction rewrites many small data files into\nfewer large ones, and can also merge delete\nfiles into the data files. It usually re-sorts\nthe rows too, which tightens the column\nstatistics and improves pruning.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-6a2b80d9f61e",
      "originalText": "Compaction\nCompaction rewrites many small data files into fewer large ones, and can also merge delete files into the data files. It usually re-sorts the rows too, which tightens the column statistics and improves pruning.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "compaction"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4618837662,
      "isDeleted": false,
