    {
      "type": "text",
      "version": 1,
      "versionNonce": 1457543132,
      "isDeleted": false,
      "id": "text-12bf5ad269d5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 352.1992083819456,
      "y": 1125.544281421248,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 384.6000061035156,
      "height": 87.5,
      "seed": 504743,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Iceberg Is Only a Specification\nIceberg is not a query engine, not a storage system, and not a\ndatabase. It defines metadata files and rules. You still need an\nengine to run queries, a catalog to hold the table pointer, and\nobject storage to hold the files.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-12bf5ad269d5",
      "originalText": "Iceberg Is Only a Specification\nIceberg is not a query engine, not a storage system, and not a database. It defines metadata files and rules. You still need an engine to run queries, a catalog to hold the table pointer, and object storage to hold the files.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "iceberg-is-a-spec"
      }
    },
