    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5682325153,
      "isDeleted": false,
      "id": "text-93c902533cd4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 4012.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 144215,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Row-Level Changes\nAn update or a delete needs a decision:\nrewrite the affected data files now, or record\nthe change and resolve it at read time. Both\noptions are valid, and a table can set them\nper operation.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-93c902533cd4",
      "originalText": "Row-Level Changes\nAn update or a delete needs a decision: rewrite the affected data files now, or record the change and resolve it at read time. Both options are valid, and a table can set them per operation.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "row-level-changes"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9690785937,
      "isDeleted": false,
      "id": "node-b48ef1511b4c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 3923.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 129.0,
      "seed": 125177,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
