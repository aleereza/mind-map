    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1511668912,
      "isDeleted": false,
      "id": "text-a8e87dc40958",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 4266.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 122.5,
      "seed": 720823,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Schema Evolution\nYou can add, drop, rename, reorder, and widen\ncolumns without rewriting data. Field IDs keep\nthe mapping stable, so an old file that lacks\na new column simply returns null for it.\nIceberg also prevents unsafe changes, such as\na type change that would lose data.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-a8e87dc40958",
      "originalText": "Schema Evolution\nYou can add, drop, rename, reorder, and widen columns without rewriting data. Field IDs keep the mapping stable, so an old file that lacks a new column simply returns null for it. Iceberg also prevents unsafe changes, such as a type change that would lose data.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "schema-evolution"
      }
    },
