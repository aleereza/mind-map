    {
      "type": "text",
      "version": 1,
      "versionNonce": 6230331432,
      "isDeleted": false,
      "id": "text-565c7ae18efe",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6000000000001,
      "y": 4621.75,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 122.5,
      "seed": 465703,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partitioning Still Needs Design\nHidden partitioning removes the extra column,\nnot the need to think. Too fine a granularity,\nsuch as `hour` on a small table, creates many\ntiny files and slow planning. Choose the\ngranularity from the data volume and the usual\nquery filters.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-565c7ae18efe",
      "originalText": "Partitioning Still Needs Design\nHidden partitioning removes the extra column, not the need to think. Too fine a granularity, such as `hour` on a small table, creates many tiny files and slow planning. Choose the granularity from the data volume and the usual query filters.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "partition-design-warning"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2112496975,
      "isDeleted": false,
      "id": "node-e8509aaed8aa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 4803.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 129.0,
      "seed": 748340,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
