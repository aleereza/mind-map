    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9861927219,
      "isDeleted": false,
      "id": "text-b756de80c390",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1579.2,
      "y": 3565.5,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 390.0,
      "height": 81.25,
      "seed": 323685,
      "groupIds": [
        "sj9n5tip"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Engine Reads Rows\nThe engine reads the surviving data files, and\nreads only the needed columns. If the snapshot has\ndelete files that apply, the engine uses them to\ndrop the deleted rows from the result.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-b756de80c390",
      "originalText": "Engine Reads Rows\nThe engine reads the surviving data files, and reads only the needed columns. If the snapshot has delete files that apply, the engine uses them to drop the deleted rows from the result.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "read-rows"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5913388801,
      "isDeleted": false,
      "id": "node-1fe7a21457bf",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
      "y": 3701.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 410.40000000000003,
      "height": 181.5,
      "seed": 228578,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
