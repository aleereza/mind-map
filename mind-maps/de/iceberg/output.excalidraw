      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Writer Plans the Write\nThe engine reads the table pointer from the catalog\nand loads the current metadata file. From it the\nengine takes the schema, the current partition\nspec, and the sort order it must follow.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-093e9c33d609",
      "originalText": "Writer Plans the Write\nThe engine reads the table pointer from the catalog and loads the current metadata file. From it the engine takes the schema, the current partition spec, and the sort order it must follow.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "write-plan"
      }
    },
