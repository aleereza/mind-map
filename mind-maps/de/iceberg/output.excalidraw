      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Table Maintenance\nA busy Iceberg table collects data\nfiles, delete files, and metadata\nfiles. Maintenance jobs keep\nplanning fast and storage cheap.\nThey are scheduled work; the\nformat does not do them for you,\nalthough a managed service may.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-58c1ba9eeefc",
      "originalText": "Table Maintenance\nA busy Iceberg table collects data files, delete files, and metadata files. Maintenance jobs keep planning fast and storage cheap. They are scheduled work; the format does not do them for you, although a managed service may.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "table-maintenance"
      }
    },
