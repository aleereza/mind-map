      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 699.2,
      "y": 5522.25,
      "strokeColor": "#0F172A",
      "backgroundColor": "#DBEAFE",
      "width": 409.99999999999994,
      "height": 212.0,
