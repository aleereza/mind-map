    {
      "type": "text",
      "version": 1,
      "versionNonce": 2402872629,
      "isDeleted": false,
      "id": "text-b713a273ccc7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 1261.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 105.0,
      "seed": 944439,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Partition Spec\nThe partition spec defines how partition\nvalues come from source columns, for example\n`day(event_time)`. A table can hold several\nspecs, because the spec can change over time.\nEach data file records which spec produced it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b713a273ccc7",
      "originalText": "Partition Spec\nThe partition spec defines how partition values come from source columns, for example `day(event_time)`. A table can hold several specs, because the spec can change over time. Each data file records which spec produced it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "partition-spec"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6290872500,
      "isDeleted": false,
      "id": "node-e94025be336b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1888.0,
      "y": 1425.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 129.0,
      "seed": 686320,
      "groupIds": [],
