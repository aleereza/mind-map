      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Writer Writes Data Files\nThe engine writes the new rows into new data files\nin storage. Nothing that already exists is changed,\nso the current snapshot stays readable during the\nwrite.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-9cd6dd962c9d",
      "originalText": "Writer Writes Data Files\nThe engine writes the new rows into new data files in storage. Nothing that already exists is changed, so the current snapshot stays readable during the write.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "write-data-files"
      }
    },
