        "node_id": "engine-role"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1661509722,
      "isDeleted": false,
      "id": "text-79c9122e4ce1",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 6286.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 122.5,
      "seed": 112363,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Engine Role\nAn engine uses an Iceberg client library to\nresolve the pointer, plan the scan, prune\nfiles, and read or write data. Iceberg itself\nruns no compute. Because the table state is in\nshared metadata, several engines can use one\ntable without copying it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-79c9122e4ce1",
      "originalText": "Engine Role\nAn engine uses an Iceberg client library to resolve the pointer, plan the scan, prune files, and read or write data. Iceberg itself runs no compute. Because the table state is in shared metadata, several engines can use one table without copying it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "engine-role"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8229573768,
      "isDeleted": false,
      "id": "node-e6fb95651670",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 6263.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 181.5,
      "seed": 414322,
      "groupIds": [],
      "frameId": null,
