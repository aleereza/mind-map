      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 146.5,
      "seed": 65693,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
