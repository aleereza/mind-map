    {
      "type": "text",
      "version": 1,
      "versionNonce": 1549992227,
      "isDeleted": false,
      "id": "text-e1725abf7caf",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 136.0,
      "y": 1549.25,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 377.99999999999994,
      "height": 225.0,
      "seed": 180589,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kafka \u2192 Iceberg \u2192 Snowflake\nHow does a database change or an\napplication event become a table\nthat Snowflake can query? A\nconnector writes the records as\nIceberg tables in S3. A catalog\ntells Snowflake which files make\nup each table, and Snowflake reads\nthose files without loading a\ncopy.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-e1725abf7caf",
      "originalText": "Kafka \u2192 Iceberg \u2192 Snowflake\nHow does a database change or an application event become a table that Snowflake can query? A connector writes the records as Iceberg tables in S3. A catalog tells Snowflake which files make up each table, and Snowflake reads those files without loading a copy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "kafka-iceberg-snowflake"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3578301028,
      "isDeleted": false,
      "id": "node-6d6019671bad",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 720.0,
      "y": 120.0,
      "strokeColor": "#0F172A",
      "backgroundColor": "#DBEAFE",
      "width": 409.99999999999994,
      "height": 144.5,
      "seed": 500464,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
