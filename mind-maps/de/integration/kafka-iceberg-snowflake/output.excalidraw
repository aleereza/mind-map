    {
      "type": "text",
      "version": 1,
      "versionNonce": 3527707629,
      "isDeleted": false,
      "id": "text-98d57068829b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 1358.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 336.0,
      "height": 52.5,
