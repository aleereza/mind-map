      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6801925503,
      "isDeleted": false,
      "id": "text-5a81790a6082",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1940.8,
      "y": 82.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 237107,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What reading in place buys\n- The table data is stored once, in S3. There\nis no load step to pay for, and no second copy\ninside Snowflake.\n- Any engine that reads Iceberg, such as\nSpark, Trino, or DuckDB, can read the same\ntable.\n- A ready-made sink connector replaces custom\nexporter code.\n- The table format adds atomic\n(all-or-nothing) commits, schema evolution,\nand time travel, as the [Iceberg\nmap](../../iceberg/iceberg.md) explains.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-5a81790a6082",
      "originalText": "What reading in place buys\n- The table data is stored once, in S3. There is no load step to pay for, and no second copy inside Snowflake.\n- Any engine that reads Iceberg, such as Spark, Trino, or DuckDB, can read the same table.\n- A ready-made sink connector replaces custom exporter code.\n- The table format adds atomic (all-or-nothing) commits, schema evolution, and time travel, as the [Iceberg map](../../iceberg/iceberg.md) explains.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "read-in-place-buys"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3284193005,
      "isDeleted": false,
      "id": "node-9c34ac8babce",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
