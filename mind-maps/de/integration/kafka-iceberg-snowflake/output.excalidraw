      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snowflake read side\nFinds the tables through the catalog and reads\ntheir files in place.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-655e0e633b58",
      "originalText": "Snowflake read side\nFinds the tables through the catalog and reads their files in place.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "snowflake-read-side"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9888992914,
      "isDeleted": false,
      "id": "node-b3e91aa6be5c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1920.4,
      "y": 2505.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 100.0,
      "height": 41.5,
      "seed": 671477,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-b3e91aa6be5c"
        },
        {
          "id": "edge-71536baf7ebf",
          "type": "arrow"
        }
      ],
      "updated": 1,
      "link": null,
