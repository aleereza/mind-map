    {
      "type": "text",
      "version": 1,
      "versionNonce": 8940294799,
      "isDeleted": false,
      "id": "text-6d6019671bad",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 736.0,
      "y": 120.0,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 377.99999999999994,
      "height": 157.5,
      "seed": 33429,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why this pattern\nThe pattern makes two choices. It\nputs Kafka in front of the tables.\nIt also lets Snowflake read\nIceberg tables in place, instead\nof loading a copy. Each choice\nsolves a real problem.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-6d6019671bad",
      "originalText": "Why this pattern\nThe pattern makes two choices. It puts Kafka in front of the tables. It also lets Snowflake read Iceberg tables in place, instead of loading a copy. Each choice solves a real problem.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "why-this-pattern"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5109895012,
      "isDeleted": false,
      "id": "node-cc7dda13693c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1320.0,
      "y": -177.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 165636,
      "groupIds": [],
