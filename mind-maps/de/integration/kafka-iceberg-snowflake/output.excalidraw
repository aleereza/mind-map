    {
      "type": "text",
      "version": 1,
      "versionNonce": 9979140814,
      "isDeleted": false,
      "id": "text-655e0e633b58",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
