      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data flow\nDatabase row change \u2192 CDC source\nconnector \u2192 Kafka topic\nApplication event \u2192 event producer\n\u2192 Kafka topic\nKafka topic \u2192 Iceberg sink\nconnector \u2192 S3 bucket and\nSnowflake Open Catalog \u2192 Snowflake\nread side",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-5d38a35bc102",
      "originalText": "Data flow\nDatabase row change \u2192 CDC source connector \u2192 Kafka topic\nApplication event \u2192 event producer \u2192 Kafka topic\nKafka topic \u2192 Iceberg sink connector \u2192 S3 bucket and Snowflake Open Catalog \u2192 Snowflake read side",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "data-flow"
      }
    },
    {
