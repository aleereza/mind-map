      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 7501719012,
      "isDeleted": false,
      "id": "text-9c34ac8babce",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1940.8,
      "y": 342.25,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 280.0,
      "seed": 632696,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "What reading in place costs\n- You run more parts: a sink, a catalog, and\nseparate identities for writing and reading.\n- Rows appear one commit at a time, not one\nrecord at a time.\n- A stopped sink looks the same as a quiet\nsource, so a failure stays hidden until\nsomeone checks.\n- Small files and old snapshots pile up until\na job merges the files and removes the old\nsnapshots.\n\nEach cost has its own node under [End-to-end\nconcerns](#end-to-end-concerns). If Snowflake\nis the only reader and you want fewer parts to\nrun, a copy is the better choice.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-9c34ac8babce",
      "originalText": "What reading in place costs\n- You run more parts: a sink, a catalog, and separate identities for writing and reading.\n- Rows appear one commit at a time, not one record at a time.\n- A stopped sink looks the same as a quiet source, so a failure stays hidden until someone checks.\n- Small files and old snapshots pile up until a job merges the files and removes the old snapshots.\n\nEach cost has its own node under [End-to-end concerns](#end-to-end-concerns). If Snowflake is the only reader and you want fewer parts to run, a copy is the better choice.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "read-in-place-costs"
      }
    },
