    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3123587058,
      "isDeleted": false,
      "id": "text-61eb640f36fa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1932.4,
      "y": 1038.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 76.0,
      "height": 1120.0,
      "seed": 859812,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Inputs\nFor a SQL\nServer\nsource,\nSQL\nServer's\nown CDC\nfeature\ndoes the\nfirst\nhalf of\nthe work.\nAn admini\nstrator\nenables\nCDC on\nthe\ndatabase\nand on\neach\ntable. A\nSQL\nServer\nAgent job\nthen\nreads the\ntransacti\non log\nevery 5\nseconds.\nIt copies\neach\ncommitted\nchange\ninto a\nchange\ntable. An\nupdate\nwrites\ntwo\nchange\nrows: the\nrow\nbefore\nthe\nchange\nand the\nrow after\nit.\n\nThe\nconnector\npolls\nthese\nchange\ntables\nabout\nevery 500\nms. One\nconnector\ncan\ncapture\nmany\ntables.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-61eb640f36fa",
      "originalText": "Inputs\nFor a SQL Server source, SQL Server's own CDC feature does the first half of the work. An administrator enables CDC on the database and on each table. A SQL Server Agent job then reads the transaction log every 5 seconds. It copies each committed change into a change table. An update writes two change rows: the row before the change and the row after it.\n\nThe connector polls these change tables about every 500 ms. One connector can capture many tables.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "cdc-inputs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4408460512,
      "isDeleted": false,
      "id": "node-86398aa18ef6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1920.4,
      "y": 1119.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 100.0,
      "height": 41.5,
      "seed": 907916,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-86398aa18ef6"
        },
        {
          "id": "edge-6c6e26f99f57",
          "type": "arrow"
        },
        {
          "id": "edge-1d0575d8a866",
          "type": "arrow"
