      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Event producer\nAn application that writes each event\nit creates to a Kafka topic.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-98d57068829b",
      "originalText": "Event producer\nAn application that writes each event it creates to a Kafka topic.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "event-producer"
      }
