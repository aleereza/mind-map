# Stage 0: the player connects to the camera over TCP and asks for chunks in a loop.

vars: {
  d2-config: {
    layout-engine: elk
    pad: 24
  }
}

style.fill: "#FAF8F4"

classes: {
  producer: {
    style: {
      fill: "#E4EDE5"
      stroke: "#86A68E"
      stroke-width: 2
      border-radius: 8
      font-color: "#2F4A38"
    }
  }
  kafka: {
    style: {
      fill: "#E4E8F1"
      stroke: "#8593B4"
      stroke-width: 2
      border-radius: 8
      font-color: "#2E3A57"
    }
  }
  consumer: {
    style: {
      fill: "#F3E8DF"
      stroke: "#C29C84"
      stroke-width: 2
      border-radius: 8
      font-color: "#5B3B29"
    }
  }
  highlight: {
    style: {
      fill: "#F4E4B8"
      stroke: "#C7A24A"
      stroke-width: 2
      border-radius: 8
      font-color: "#5A4614"
    }
  }
  quiet: {
    style: {
      fill: "#F1F0EC"
      stroke: "#BDB8AE"
      stroke-width: 2
      border-radius: 8
      font-color: "#55524B"
    }
  }
  zone: {
    style: {
      fill: "#FFFFFF"
      stroke: "#D5D1C8"
      stroke-width: 2
      border-radius: 12
      font-color: "#3D3B36"
    }
  }
  note: {
    shape: text
    style: {
      font-color: "#5F5B53"
      font-size: 15
      bold: false
    }
  }
  flow: {
    style: {
      stroke: "#7D8698"
      stroke-width: 2
      font-color: "#4F5664"
    }
  }
}

tcp: "" {
  shape: sequence_diagram
  player: "Player (C)\nKnows P's address" {class: consumer}
  camera: "Camera (P)\nAddress 10.0.0.5:9000" {class: producer}
  player -> camera: "Opens a TCP connection" {class: flow}
  player -> camera: "Give me chunk 7" {class: flow}
  camera -> player: "Here is chunk 7" {class: flow}
  player."Remembers next = 8": {class: quiet}
  player -> camera: "Give me chunk 8" {class: flow}
}

footer: "↻ Works only while both are online" {
  class: note
  near: bottom-center
}
