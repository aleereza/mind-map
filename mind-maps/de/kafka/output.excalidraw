    {
      "type": "text",
      "version": 1,
      "versionNonce": 8688877833,
      "isDeleted": false,
      "id": "text-5006ed0248a0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.5363988498723,
      "y": 456.1540351860577,
      "strokeColor": "#1E40AF",
