    {
      "type": "text",
      "version": 1,
      "versionNonce": 8662032670,
      "isDeleted": false,
      "id": "text-4bf28342709d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 493.6091639264316,
      "y": 927.68057660529,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 423.98333740234375,
      "height": 87.5,
      "seed": 18781,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Producer Application\nIn the IoT example, the gateway application typically runs a loop that\nwaits for sensor readings. When data arrives, it builds a record and\nasks its Kafka client to serialize, batch, and push the record to a\nbroker; Kafka itself does not inspect the sensors.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-4bf28342709d",
      "originalText": "Producer Application\nIn the IoT example, the gateway application typically runs a loop that waits for sensor readings. When data arrives, it builds a record and asks its Kafka client to serialize, batch, and push the record to a broker; Kafka itself does not inspect the sensors.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "producer-application"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6926736308,
      "isDeleted": false,
      "id": "node-8a87c25e1377",
