    {
      "type": "text",
      "version": 1,
      "versionNonce": 7667644246,
      "isDeleted": false,
      "id": "text-f6c5bebdaf0e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 369.06576035003036,
      "y": 1423.2305464864169,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 157.5,
      "seed": 965901,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Consumer Application\nA consumer application typically runs a poll\nloop that asks Kafka for records after its\ncurrent partition offsets. Kafka may hold an\nempty fetch request open briefly, then returns\nnew records or a timeout; the consumer\ndeserializes and processes the results. Kafka\ndoes not push records to the destination, and\nreading them does not delete them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-f6c5bebdaf0e",
      "originalText": "Consumer Application\nA consumer application typically runs a poll loop that asks Kafka for records after its current partition offsets. Kafka may hold an empty fetch request open briefly, then returns new records or a timeout; the consumer deserializes and processes the results. Kafka does not push records to the destination, and reading them does not delete them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "consumer-application"
      }
    },
    {
      "type": "rectangle",
