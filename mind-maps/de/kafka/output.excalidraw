      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Confluent Cloud\nA fully managed data-streaming platform with a\ncloud-native Apache Kafka engine. Confluent\noperates cluster provisioning, scaling,\nreliability, and security and also provides\nconnectors, schema governance, stream\nprocessing, and monitoring tools.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e2fb58db4a7a",
      "originalText": "Confluent Cloud\nA fully managed data-streaming platform with a cloud-native Apache Kafka engine. Confluent operates cluster provisioning, scaling, reliability, and security and also provides connectors, schema governance, stream processing, and monitoring tools.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "confluent-cloud"
      }
