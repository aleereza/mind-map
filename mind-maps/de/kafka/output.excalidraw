    {
      "type": "text",
      "version": 1,
      "versionNonce": 9770278972,
      "isDeleted": false,
      "id": "text-e672bde8f27c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1389.9116128894127,
      "y": -577.2090500173416,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 445.2,
      "height": 122.5,
      "seed": 992499,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Edge Device\nA local computing device near the sensors, such as an\nindustrial PC, PLC, embedded controller, or gateway\nappliance. It receives streams from multiple sensors\nand provides compute, temporary buffering, local\nprocessing, and network connectivity for sending\nselected data upstream.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e672bde8f27c",
      "originalText": "Edge Device\nA local computing device near the sensors, such as an industrial PC, PLC, embedded controller, or gateway appliance. It receives streams from multiple sensors and provides compute, temporary buffering, local processing, and network connectivity for sending selected data upstream.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "edge-device"
      }
    },
