      "seed": 253111,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Runtime Model\nKafka is not one infinite loop searching external systems for\nmessages. It is a collection of long-running broker server\nprocesses and client applications communicating over\npersistent TCP connections: producers push records to\nbrokers, consumers pull records from brokers, and brokers\nstore the records between them.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22.5,
      "containerId": "node-13cc9c666b01",
      "originalText": "Runtime Model\nKafka is not one infinite loop searching external systems for messages. It is a collection of long-running broker server processes and client applications communicating over persistent TCP connections: producers push records to brokers, consumers pull records from brokers, and brokers store the records between them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "runtime-model"
      }
    },
    {
      "type": "rectangle",
