        "1cnb5uv1"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Sensor Measures\nOne or more sensors measure properties in the physical world, such\nas sensor `42` recording a temperature of `21.4\u00b0C`, and emit their\nown streams of readings.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-2ebe954ae492",
      "originalText": "Sensor Measures\nOne or more sensors measure properties in the physical world, such as sensor `42` recording a temperature of `21.4\u00b0C`, and emit their own streams of readings.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "sensor-measures"
      }
    },
