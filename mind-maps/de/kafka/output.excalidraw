    {
      "type": "text",
      "version": 1,
      "versionNonce": 5144660265,
      "isDeleted": false,
      "id": "text-7ddb9625261f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2123.477061675331,
      "y": -349.0656789919241,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 157.5,
      "seed": 231068,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Replication\nReplication keeps copies of each partition on\ndifferent brokers. With replication factor\n`3`, one leader serves the partition while two\nfollowers copy it and an in-sync follower can\ntake over after failure. Replication improves\navailability and durability, but it multiplies\nstorage and does not replace backup or extend\nretention.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-7ddb9625261f",
      "originalText": "Replication\nReplication keeps copies of each partition on different brokers. With replication factor `3`, one leader serves the partition while two followers copy it and an in-sync follower can take over after failure. Replication improves availability and durability, but it multiplies storage and does not replace backup or extend retention.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "replication"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4805372486,
      "isDeleted": false,
      "id": "node-5006ed0248a0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1283.5941392342331,
      "y": 451.1540351860577,
