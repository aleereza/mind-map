      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gateway Application\nSoftware running on the edge device that collects sensor streams,\ntranslates local device protocols, and can validate, normalize,\nfilter, batch, or aggregate readings before publishing them. It\nis often the producer in an IoT setup.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-2e2efabf5b40",
      "originalText": "Gateway Application\nSoftware running on the edge device that collects sensor streams, translates local device protocols, and can validate, normalize, filter, batch, or aggregate readings before publishing them. It is often the producer in an IoT setup.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "gateway-application"
      }
    },
