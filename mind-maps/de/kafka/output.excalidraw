      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Producer\nAn application role that publishes records to Kafka topics. In the IoT\nexample, the gateway is usually the producer and uses a Kafka client\nlibrary to send sensor readings.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-101456bdd9c4",
      "originalText": "Producer\nAn application role that publishes records to Kafka topics. In the IoT example, the gateway is usually the producer and uses a Kafka client library to send sensor readings.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "producer"
      }
    },
