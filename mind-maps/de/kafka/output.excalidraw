      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Consumer\nAn application role that reads records from topic partitions and processes\nthem. Reading does not delete records; a consumer tracks offsets so it can\ncontinue from its last position or intentionally replay earlier data.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-cb7a82c31787",
      "originalText": "Consumer\nAn application role that reads records from topic partitions and processes them. Reading does not delete records; a consumer tracks offsets so it can continue from its last position or intentionally replay earlier data.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "consumer"
      }
    },
