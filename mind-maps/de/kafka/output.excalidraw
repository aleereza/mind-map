      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2770.9527000051057,
      "y": 1248.6478843871378,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 381.0,
      "height": 50.32714814249558,
      "seed": 726593,
      "groupIds": [
        "1cnb5uv1"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Broker Appends Record\nThe leader broker appends the record to the partition log on disk\nand assigns its sequential offset within that partition.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-3ed28995959b",
      "originalText": "Broker Appends Record\nThe leader broker appends the record to the partition log on disk and assigns its sequential offset within that partition.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "broker-appends-record"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4887151950,
      "isDeleted": false,
      "id": "node-55f2bf9ac2ec",
