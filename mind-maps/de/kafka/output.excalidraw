      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kafka Broker\nA Kafka server process that receives client requests\nand stores topic partitions in append-only\nlog-segment files on its storage. Kafka does not\nrequire an external database; brokers replicate\npartition data with other brokers for fault\ntolerance.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-cf085ab1b0b8",
      "originalText": "Kafka Broker\nA Kafka server process that receives client requests and stores topic partitions in append-only log-segment files on its storage. Kafka does not require an external database; brokers replicate partition data with other brokers for fault tolerance.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "kafka-broker"
      }
    },
