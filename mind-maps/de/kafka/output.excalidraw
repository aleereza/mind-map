    {
      "type": "text",
      "version": 1,
      "versionNonce": 9551802498,
      "isDeleted": false,
      "id": "text-afdc7357dc93",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 480.43702221202966,
      "y": 1138.1344298871063,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 175.0,
      "seed": 599999,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Broker Process\nA broker is a long-running Kafka server\nprocess, commonly run as an operating-system\nservice, container, or Kubernetes workload. At\nstartup it loads its partition logs, joins the\ncluster, opens configured TCP\nlisteners\u2014commonly on port `9092`\u2014and waits\nefficiently for client and broker requests. A\nmanaged Kafka provider runs these broker\nprocesses for you.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-afdc7357dc93",
      "originalText": "Broker Process\nA broker is a long-running Kafka server process, commonly run as an operating-system service, container, or Kubernetes workload. At startup it loads its partition logs, joins the cluster, opens configured TCP listeners\u2014commonly on port `9092`\u2014and waits efficiently for client and broker requests. A managed Kafka provider runs these broker processes for you.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "broker-process"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1217958172,
      "isDeleted": false,
      "id": "node-084f028d3dbc",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1161.247377947202,
      "y": 1130.562714475244,
      "strokeColor": "#1E40AF",
      "backgroundColor": "#EFF6FF",
      "width": 457.04556620765504,
