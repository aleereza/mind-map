      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Consumer Reads Record\nA consumer fetches records from its current partition offset and uses\nits Kafka client to deserialize the key and value back into application\ndata.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-9f2fd7ba2e46",
      "originalText": "Consumer Reads Record\nA consumer fetches records from its current partition offset and uses its Kafka client to deserialize the key and value back into application data.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "consumer-reads-record"
      }
    },
