    {
      "type": "text",
      "version": 1,
      "versionNonce": 1321429599,
      "isDeleted": false,
      "id": "text-dc0966bae944",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2766.445104913319,
      "y": 963.9998136307099,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 400.0,
      "height": 97.5,
      "seed": 266867,
      "groupIds": [
        "1cnb5uv1"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Client Creates Record\nThe Kafka client is a library used by the gateway\napplication to communicate with Kafka. Acting as a\nproducer, the gateway uses it to create a record\nwith the destination topic, key, value, timestamp,\nand any optional headers.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-dc0966bae944",
      "originalText": "Client Creates Record\nThe Kafka client is a library used by the gateway application to communicate with Kafka. Acting as a producer, the gateway uses it to create a record with the destination topic, key, value, timestamp, and any optional headers.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "client-creates-record"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6353717565,
      "isDeleted": false,
      "id": "node-e086f24322eb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2757.872933570231,
      "y": 1097.828198743497,
      "strokeColor": "#1F2937",
      "backgroundColor": "#F9FAFB",
      "width": 431.31656397814675,
      "height": 104.52561537287544,
