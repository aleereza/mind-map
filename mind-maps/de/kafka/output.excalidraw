      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Sensor\nA measurement component that observes one\nphysical property, such as temperature,\npressure, or vibration. A sensor may be too\nsimple to communicate with Kafka, and multiple\nsensors can send independent data streams to\nthe same edge device.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-2fc03be5f18a",
      "originalText": "Sensor\nA measurement component that observes one physical property, such as temperature, pressure, or vibration. A sensor may be too simple to communicate with Kafka, and multiple sensors can send independent data streams to the same edge device.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "sensor"
      }
    },
    {
