      "locked": false,
      "text": "Sink\nA consumer application or Kafka Connect sink connector that\nreads a Kafka topic and writes records to an external\ndestination, such as a time-series database, data lake, or\nalerting system.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-6f2b83563239",
      "originalText": "Sink\nA consumer application or Kafka Connect sink connector that reads a Kafka topic and writes records to an external destination, such as a time-series database, data lake, or alerting system.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "sink"
      }
    },
