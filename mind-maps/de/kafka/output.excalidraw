      "height": 52.5,
      "seed": 678371,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cluster\nA group of Kafka brokers working together as one service. A cluster spreads topic\npartitions and their replicas across brokers for capacity and fault tolerance.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-da68bf3a5522",
      "originalText": "Cluster\nA group of Kafka brokers working together as one service. A cluster spreads topic partitions and their replicas across brokers for capacity and fault tolerance.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "cluster"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7153863593,
      "isDeleted": false,
      "id": "node-7ddb9625261f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2111.477061675331,
      "y": -354.0656789919241,
      "strokeColor": "#1E40AF",
      "backgroundColor": "#EFF6FF",
      "width": 418.8,
      "height": 181.5,
      "seed": 114403,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
