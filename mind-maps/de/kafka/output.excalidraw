      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Topic\nA named, durable stream of related records, such as\n`sensor-readings`. Producers write to the topic and\nconsumers read from it independently.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-b415e16fbe4c",
      "originalText": "Topic\nA named, durable stream of related records, such as `sensor-readings`. Producers write to the topic and consumers read from it independently.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "topic"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5927741278,
      "isDeleted": false,
      "id": "node-88faac11dac2",
