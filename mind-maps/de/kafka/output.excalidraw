    {
      "type": "text",
      "version": 1,
      "versionNonce": 6348660284,
      "isDeleted": false,
      "id": "text-084f028d3dbc",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1179.3451579992718,
      "y": 1135.562714475244,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 420.8500061035156,
      "height": 105.0,
      "seed": 837982,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Request Handling\nNetwork I/O and request-handler loops wait on sockets rather than\nrepeatedly scanning for data. A produce request is validated and\nappended to a partition log; a fetch request asks for records after an\noffset and may be held briefly until data arrives, avoiding a wasteful\nbusy loop.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-084f028d3dbc",
      "originalText": "Request Handling\nNetwork I/O and request-handler loops wait on sockets rather than repeatedly scanning for data. A produce request is validated and appended to a partition log; a fetch request asks for records after an offset and may be held briefly until data arrives, avoiding a wasteful busy loop.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "broker-request-handling"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4795368057,
      "isDeleted": false,
      "id": "node-dabdc27acbd2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1167.6480251806502,
      "y": 1280.7972777142786,
      "strokeColor": "#1E40AF",
      "backgroundColor": "#EFF6FF",
      "width": 441.8423300404138,
      "height": 124.31598715262089,
