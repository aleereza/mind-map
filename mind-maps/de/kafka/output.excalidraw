    {
      "type": "text",
      "version": 1,
      "versionNonce": 1782121598,
      "isDeleted": false,
      "id": "text-42907b912ce3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 997.58845432934,
      "y": 978.0341190749136,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 469.95001220703125,
      "height": 105.0,
      "seed": 78683,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Produce Request\nCalling `producer.send(record)` makes the client serialize and batch records\ninto Kafka's binary produce-request format, then send the bytes through a\nTCP connection to the partition's leader broker. TCP divides the request\ninto IP packets for network transport, and the broker returns an\nacknowledgement according to the producer's configuration.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-42907b912ce3",
      "originalText": "Produce Request\nCalling `producer.send(record)` makes the client serialize and batch records into Kafka's binary produce-request format, then send the bytes through a TCP connection to the partition's leader broker. TCP divides the request into IP packets for network transport, and the broker returns an acknowledgement according to the producer's configuration.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "producer-produce-request"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
