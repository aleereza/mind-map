      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kafka Replicates & Retains\nFollower brokers copy the partition data according to its replication\nfactor, and Kafka keeps the record according to the topic's retention\npolicy.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-55f2bf9ac2ec",
      "originalText": "Kafka Replicates & Retains\nFollower brokers copy the partition data according to its replication factor, and Kafka keeps the record according to the topic's retention policy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "kafka-replicates-retains"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7314561279,
      "isDeleted": false,
