      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Aiven for Apache Kafka\nA fully managed Apache Kafka service that runs\nin Aiven's cloud or a bring-your-own-cloud\nenvironment. Aiven operates the cluster and\noffers managed scaling, Kafka Connect,\nmonitoring, and local, tiered, or\nobject-storage-backed topic options.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-5a1105c87910",
      "originalText": "Aiven for Apache Kafka\nA fully managed Apache Kafka service that runs in Aiven's cloud or a bring-your-own-cloud environment. Aiven operates the cluster and offers managed scaling, Kafka Connect, monitoring, and local, tiered, or object-storage-backed topic options.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-kafka"
      }
