    {
      "type": "text",
      "version": 1,
      "versionNonce": 7842430316,
      "isDeleted": false,
      "id": "text-03eab94f3bea",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1016.7067411141323,
      "y": 827.7995558358789,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 463.7166748046875,
      "height": 105.0,
      "seed": 901421,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Persistent Connections\nThe client maintains and reuses TCP connections to the brokers it needs\ninstead of opening a new connection for every record. Connections may\ncross a private network, VPN, or the internet and commonly use TLS\nencryption plus authentication; the client handles reconnecting and retrying\nwhen connections fail.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-03eab94f3bea",
      "originalText": "Persistent Connections\nThe client maintains and reuses TCP connections to the brokers it needs instead of opening a new connection for every record. Connections may cross a private network, VPN, or the internet and commonly use TLS encryption plus authentication; the client handles reconnecting and retrying when connections fail.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "producer-persistent-connections"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2394574685,
      "isDeleted": false,
      "id": "node-42907b912ce3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 992.4403537123042,
      "y": 973.0341190749136,
      "strokeColor": "#1E40AF",
