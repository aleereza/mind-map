    {
      "type": "text",
      "version": 1,
      "versionNonce": 1750809318,
      "isDeleted": false,
      "id": "text-dabdc27acbd2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1172.6775276032008,
      "y": 1285.7972777142786,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 431.7833251953125,
      "height": 105.0,
      "seed": 401576,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Background Work\nKafka continuously performs internal maintenance alongside client\nrequests. Followers fetch partition updates from leaders, retention\nremoves expired log segments, compaction and log maintenance\nmanage storage, and cluster coordination tracks metadata and broker\nleadership.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-dabdc27acbd2",
      "originalText": "Background Work\nKafka continuously performs internal maintenance alongside client requests. Followers fetch partition updates from leaders, retention removes expired log segments, compaction and log maintenance manage storage, and cluster coordination tracks metadata and broker leadership.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "broker-background-work"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5393062195,
      "isDeleted": false,
      "id": "node-f6c5bebdaf0e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
