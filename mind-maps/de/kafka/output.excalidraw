    {
      "type": "text",
      "version": 1,
      "versionNonce": 9306039418,
      "isDeleted": false,
      "id": "text-2fc03be5f18a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1389.4082887301774,
      "y": -1530.6057379773356,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
