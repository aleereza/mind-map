      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Kafka Client\nA language library or compatible interface used by an\napplication to authenticate with brokers and produce or\nconsume records. It handles Kafka's network protocol and\nserializes outgoing keys and values or deserializes\nincoming ones.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-e6bd0d4f2475",
      "originalText": "Kafka Client\nA language library or compatible interface used by an application to authenticate with brokers and produce or consume records. It handles Kafka's network protocol and serializes outgoing keys and values or deserializes incoming ones.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "kafka-client"
      }
    },
