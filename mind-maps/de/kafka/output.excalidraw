    {
      "type": "text",
      "version": 1,
      "versionNonce": 5784623935,
      "isDeleted": false,
      "id": "text-31e69adfb28b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2257.8674741261666,
      "y": -664.8039656076621,
      "strokeColor": "#1E40AF",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 140.0,
      "seed": 918148,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Retention\nRetention controls how long or how much of a\ntopic's log Kafka keeps, independently of\nwhether consumers have read it. Time- or\nsize-based retention removes old log segments,\nwhile compaction can retain the latest record\nfor each key. Retention defines the replay\nwindow; it is not a backup.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 17.5,
      "containerId": "node-31e69adfb28b",
      "originalText": "Retention\nRetention controls how long or how much of a topic's log Kafka keeps, independently of whether consumers have read it. Time- or size-based retention removes old log segments, while compaction can retain the latest record for each key. Retention defines the replay window; it is not a backup.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "retention"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3031423189,
      "isDeleted": false,
