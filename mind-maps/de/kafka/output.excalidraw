    {
      "type": "text",
      "version": 1,
      "versionNonce": 8135569327,
      "isDeleted": false,
      "id": "text-0923e4b8aa39",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2752.6573989637336,
      "y": 831.5458296822595,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 390.3999938964844,
      "height": 81.25,
      "seed": 549509,
      "groupIds": [
        "1cnb5uv1"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gateway Builds Event\nThe gateway application is software running on the edge device. It\nconverts selected sensor data into application events containing\ninformation such as the sensor ID, measured value, unit, and\nmeasurement time, and decides what should be published to Kafka.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 16.25,
      "containerId": "node-0923e4b8aa39",
      "originalText": "Gateway Builds Event\nThe gateway application is software running on the edge device. It converts selected sensor data into application events containing information such as the sensor ID, measured value, unit, and measurement time, and decides what should be published to Kafka.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "gateway-builds-event"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1123759370,
      "isDeleted": false,
      "id": "node-dc0966bae944",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
