    {
      "type": "text",
      "version": 1,
      "versionNonce": 3595528368,
      "isDeleted": false,
      "id": "text-fb8d4ceb6ff8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1002.0,
      "y": 120.0,
      "strokeColor": "#1E3A8A",
