    {
      "type": "text",
      "version": 1,
      "versionNonce": 4094346258,
      "isDeleted": false,
      "id": "text-17667ed2b7ea",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1312.0,
      "y": 1425.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 580577,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Magic Bytes\nEvery Parquet file starts and ends with the\nfour bytes `PAR1`. A reader checks them to\nknow that the file is Parquet. The next bytes\nstart the header of the first page. In the\nexample file, the first 11 bytes are\n`b'PAR1\\x15\\x04\\x150\\x15.L'` in Python\nnotation. The bytes `0x15` and `0x04` are\ncontrol codes, which an editor does not show\nas letters. The [specification](https://github\n.com/apache/parquet-format/blob/ec90dd4/README\n.md#L92-L121) shows the layout.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-17667ed2b7ea",
      "originalText": "Magic Bytes\nEvery Parquet file starts and ends with the four bytes `PAR1`. A reader checks them to know that the file is Parquet. The next bytes start the header of the first page. In the example file, the first 11 bytes are `b'PAR1\\x15\\x04\\x150\\x15.L'` in Python notation. The bytes `0x15` and `0x04` are control codes, which an editor does not show as letters. The [specification](https://github.com/apache/parquet-format/blob/ec90dd4/README.md#L92-L121) shows the layout.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "magic-bytes"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4118619252,
