    {
      "type": "text",
      "version": 1,
      "versionNonce": 1589855926,
      "isDeleted": false,
      "id": "text-959f0806c0d1",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1889.6000000000001,
      "y": 2437.0,
      "strokeColor": "#1F2937",
      "backgroundColor": "transparent",
      "width": 397.8,
      "height": 178.75,
      "seed": 805006,
      "groupIds": [
        "rhdjcntn"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Encode the Values\nDictionary encoding stores each different value\nonce, in the dictionary page. The data pages then\nhold small codes that point into the dictionary ([s\npecification](https://github.com/apache/parquet-for\nmat/blob/ec90dd4/README.md#L213-L218)). The `city`\ncolumn of the test file has 300,000 values but only\nfour different names. Written as plain values, the\ncolumn takes 3,299,981 bytes. With dictionary\nencoding, it takes 75,933 bytes, which is 43 times\nsmaller. That is about 2 bits for each row.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 16.25,
      "containerId": "node-959f0806c0d1",
      "originalText": "Encode the Values\nDictionary encoding stores each different value once, in the dictionary page. The data pages then hold small codes that point into the dictionary ([specification](https://github.com/apache/parquet-format/blob/ec90dd4/README.md#L213-L218)). The `city` column of the test file has 300,000 values but only four different names. Written as plain values, the column takes 3,299,981 bytes. With dictionary encoding, it takes 75,933 bytes, which is 43 times smaller. That is about 2 bits for each row.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "encode-values"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5764255677,
      "isDeleted": false,
      "id": "node-b07779aeda7b",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 2665.75,
      "strokeColor": "#1F2937",
      "backgroundColor": "#F9FAFB",
      "width": 417.8,
      "height": 220.0,
      "seed": 577943,
      "groupIds": [
        "rhdjcntn"
      ],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 12
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-b07779aeda7b"
        },
        {
          "id": "edge-5f92badd5176",
          "type": "arrow"
