      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "File Anatomy\nA Parquet file is a stack of\nparts. At the top level, the file\nholds row groups and a footer. A\nrow group holds one column chunk\nfor each column. A column chunk\nholds pages. The picture shows the\nexample file down to the column\nchunks, with the real byte range\nof each part. The [format specific\nation](https://github.com/apache/p\narquet-format/blob/ec90dd4/README.\nmd#L64-L85) defines the same\nhierarchy.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-e4518a3b165f",
      "originalText": "File Anatomy\nA Parquet file is a stack of parts. At the top level, the file holds row groups and a footer. A row group holds one column chunk for each column. A column chunk holds pages. The picture shows the example file down to the column chunks, with the real byte range of each part. The [format specification](https://github.com/apache/parquet-format/blob/ec90dd4/README.md#L64-L85) defines the same hierarchy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "file-anatomy"
      }
    },
