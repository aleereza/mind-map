      "y": 2697.375,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 367.2,
      "height": 225.0,
      "seed": 65754,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Why Columnar Pays\nA query costs the bytes it reads\nand the values it decodes. A row\nlayout keeps the fields of one row\ntogether, so a query that needs\none column still reads every\nfield. A column layout keeps the\nvalues of one column together, so\na reader fetches only the columns\nthat it needs.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-a5ee6e6159f5",
      "originalText": "Why Columnar Pays\nA query costs the bytes it reads and the values it decodes. A row layout keeps the fields of one row together, so a query that needs one column still reads every field. A column layout keeps the values of one column together, so a reader fetches only the columns that it needs.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "why-columnar-pays"
      }
    },
    {
      "type": "rectangle",
