    {
      "type": "text",
      "version": 1,
      "versionNonce": 1439258420,
      "isDeleted": false,
      "id": "text-dbe717ef8462",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1910.8,
      "y": 1669.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 253826,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Column Chunk\nA column chunk holds the values of one column\ninside one row group, in one contiguous byte\nrange. In the example file, the `id` chunk of\nrow group 0 covers bytes 4 to 114. The `city`\nchunk follows it at bytes 114 to 196. The [spe\ncification](https://github.com/apache/parquet-\nformat/blob/ec90dd4/README.md#L87-L90) names\nthe column chunk as the unit for input and\noutput.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-dbe717ef8462",
      "originalText": "Column Chunk\nA column chunk holds the values of one column inside one row group, in one contiguous byte range. In the example file, the `id` chunk of row group 0 covers bytes 4 to 114. The `city` chunk follows it at bytes 114 to 196. The [specification](https://github.com/apache/parquet-format/blob/ec90dd4/README.md#L87-L90) names the column chunk as the unit for input and output.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "column-chunk"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2672420093,
      "isDeleted": false,
      "id": "node-767013ce0ee0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2497.6,
