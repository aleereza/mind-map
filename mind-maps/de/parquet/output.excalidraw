    {
      "type": "text",
      "version": 1,
      "versionNonce": 6247420761,
      "isDeleted": false,
      "id": "text-e4518a3b165f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 726.0,
