    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2289953454,
      "isDeleted": false,
      "id": "text-d45498bb6340",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1301.2,
      "y": 2167.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 402.5,
      "seed": 477820,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Column Pruning\nA reader fetches only the column chunks that a\nquery needs. It finds their byte ranges in the\nfooter and skips the rest. The test file\n`trips_big.parquet` has 300,000 rows and\n15,353,361 bytes (About the Numbers describes\nit). A read of `fare` alone pulls 629,235\nbytes, which is 4.1% of the file. A wrapper\nthat logged every read showed what pyarrow\n18.1.0 did in November 2026. It first read the\nlast 64 KB of the file, which holds the\nfooter. It then made three reads of about 188\nKB each, one for each row group, at the byte\nranges that the footer lists. It skipped the\nother 14,724,126 bytes. A read of all four\ncolumns pulled 15,416,992 bytes: every byte of\nthe file except the first 4, plus 63,635 bytes\nthat the footer read repeats. Snowflake stores\nthe columns of each micro-partition, its unit\nof table storage, independently. A query scans\nonly the columns that it references ([micro-pa\nrtitions](https://docs.snowflake.com/en/user-g\nuide/tables-clustering-micropartitions)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-d45498bb6340",
      "originalText": "Column Pruning\nA reader fetches only the column chunks that a query needs. It finds their byte ranges in the footer and skips the rest. The test file `trips_big.parquet` has 300,000 rows and 15,353,361 bytes (About the Numbers describes it). A read of `fare` alone pulls 629,235 bytes, which is 4.1% of the file. A wrapper that logged every read showed what pyarrow 18.1.0 did in November 2026. It first read the last 64 KB of the file, which holds the footer. It then made three reads of about 188 KB each, one for each row group, at the byte ranges that the footer lists. It skipped the other 14,724,126 bytes. A read of all four columns pulled 15,416,992 bytes: every byte of the file except the first 4, plus 63,635 bytes that the footer read repeats. Snowflake stores the columns of each micro-partition, its unit of table storage, independently. A query scans only the columns that it references ([micro-partitions](https://docs.snowflake.com/en/user-guide/tables-clustering-micropartitions)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "column-pruning"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6343468370,
      "isDeleted": false,
      "id": "node-42f263f6eb8d",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1289.2,
