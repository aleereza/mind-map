      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Snowflake Open Catalog account\nA separate catalog service, with its own web\ninterface, that tracks Iceberg tables for many\nengines.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-36345f3ced19",
      "originalText": "Snowflake Open Catalog account\nA separate catalog service, with its own web interface, that tracks Iceberg tables for many engines.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "open-catalog-account"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3715166678,
      "isDeleted": false,
      "id": "node-7bb509c85683",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1898.8000000000002,
      "y": 1342.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 100.0,
      "height": 41.5,
      "seed": 548606,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-7bb509c85683"
        },
        {
          "id": "edge-9482a04c52cf",
          "type": "arrow"
        }
      ],
      "updated": 1,
