      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cloud storage\nHolds the data files and metadata files\nof every Iceberg table.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b0d2c9973121",
