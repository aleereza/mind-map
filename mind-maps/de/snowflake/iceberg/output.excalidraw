      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2359172088,
      "isDeleted": false,
      "id": "text-7bb509c85683",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1910.8000000000002,
      "y": 1342.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 76.0,
      "height": 822.5,
      "seed": 600311,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Inputs\nOpen\nCatalog\ntakes\nfour\nkinds of\ninput:\n\n- sign-in\nrequests,\nwith the\nclient ID\nand\nsecret of\na princip\nal;\n- table\nlookups\nfrom\nreaders,\nsuch as S\nnowflake;\n- commit\nrequests\nfrom\nwriters,\nsuch as\nSnowflake\nor a\nKafka\nsink conn\nector;\n- setup\nchanges\nfrom\npeople,\nin the\nweb\ninterface\nor the\nAPI:\ncatalogs,\nservice c\nonnection\ns, roles,\nand\ngrants.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7bb509c85683",
      "originalText": "Inputs\nOpen Catalog takes four kinds of input:\n\n- sign-in requests, with the client ID and secret of a principal;\n- table lookups from readers, such as Snowflake;\n- commit requests from writers, such as Snowflake or a Kafka sink connector;\n- setup changes from people, in the web interface or the API: catalogs, service connections, roles, and grants.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "open-catalog-inputs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5272862488,
      "isDeleted": false,
      "id": "node-7169fb292ac9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1898.8000000000002,
      "y": 1424.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 100.0,
      "height": 41.5,
      "seed": 421250,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
