    {
      "type": "text",
      "version": 1,
      "versionNonce": 9858406061,
      "isDeleted": false,
      "id": "text-36345f3ced19",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
