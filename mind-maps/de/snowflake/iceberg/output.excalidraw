      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8820024066,
      "isDeleted": false,
      "id": "text-8196d2dacc03",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1094.4,
      "y": 527.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 252.0,
      "height": 437.5,
      "seed": 649050,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Internal and external\ncatalogs\nAn Open Catalog account holds\none or more catalogs, and\neach catalog holds\nnamespaces, which group\ntables much as schemas do in\nSnowflake. Iceberg clients\nchoose a catalog by name, in\na setting called warehouse.\nHere, warehouse means the\ncatalog name.\n\nA catalog is internal or\nexternal. Open Catalog\nmanages an internal catalog,\nand engines, including\nSnowflake, read and write its\ntables through Open Catalog.\nAn external catalog mirrors\ntables that another catalog\nmanages, for example\nSnowflake through catalog\nsync. Its tables are\nread-only in Open Catalog.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-8196d2dacc03",
      "originalText": "Internal and external catalogs\nAn Open Catalog account holds one or more catalogs, and each catalog holds namespaces, which group tables much as schemas do in Snowflake. Iceberg clients choose a catalog by name, in a setting called warehouse. Here, warehouse means the catalog name.\n\nA catalog is internal or external. Open Catalog manages an internal catalog, and engines, including Snowflake, read and write its tables through Open Catalog. An external catalog mirrors tables that another catalog manages, for example Snowflake through catalog sync. Its tables are read-only in Open Catalog.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "internal-and-external-catalogs"
      }
    },
