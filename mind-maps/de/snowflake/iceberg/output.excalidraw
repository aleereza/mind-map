      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5336708078,
      "isDeleted": false,
      "id": "text-7169fb292ac9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1910.8000000000002,
      "y": 1424.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 76.0,
      "height": 752.5,
      "seed": 849003,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Outputs\nFor each\nsign-in,\nOpen\nCatalog\nreturns a\nshort-liv\ned token.\nFor each\ntable\nlookup,\nit\nreturns\nthe\nlocation\nof the\ntable's\ncurrent\nmetadata\nfile.\nWhen cred\nential\nvending\nis on, it\nalso\nreturns s\nhort-live\nd storage\ncredentia\nls. For\neach\ncommit,\nit writes\na new\nmetadata\nfile to\nstorage\nand moves\nthe\ntable's\npointer\nto that\nfile.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7169fb292ac9",
      "originalText": "Outputs\nFor each sign-in, Open Catalog returns a short-lived token. For each table lookup, it returns the location of the table's current metadata file. When credential vending is on, it also returns short-lived storage credentials. For each commit, it writes a new metadata file to storage and moves the table's pointer to that file.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "open-catalog-outputs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6800085689,
      "isDeleted": false,
      "id": "node-1e7b0087054d",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1898.8000000000002,
      "y": 1505.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 141.60000000000002,
      "height": 41.5,
      "seed": 124465,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-1e7b0087054d"
        },
        {
          "id": "edge-25e48c187c80",
          "type": "arrow"
        }
