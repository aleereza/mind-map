      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data flow\nAnother engine writes a table \u2192\nSnowflake Open Catalog \u2192 catalog\nintegration \u2192 Snowflake reads the\ntable\nSnowflake writes a\nSnowflake-managed table \u2192 Horizon\nCatalog or catalog sync \u2192 another\nengine reads the table",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-5d38a35bc102",
      "originalText": "Data flow\nAnother engine writes a table \u2192 Snowflake Open Catalog \u2192 catalog integration \u2192 Snowflake reads the table\nSnowflake writes a Snowflake-managed table \u2192 Horizon Catalog or catalog sync \u2192 another engine reads the table",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "data-flow"
      }
    },
