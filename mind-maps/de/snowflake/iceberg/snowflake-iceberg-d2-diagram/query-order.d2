# One query on an externally managed Iceberg table: Snowflake plans on the snapshot from the last refresh, returns a saved result when one exists, and otherwise reads the files through the warehouse.

vars: {
  d2-config: {
    layout-engine: tala
    pad: 24
  }
}

direction: down

classes: {
  box: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      border-radius: 8
      font-color: "#1E293B"
      font-size: 20
    }
  }
  external: {
    style: {
      fill: "#FFFFFF"
      stroke: "#475569"
      stroke-width: 2
      stroke-dash: 4
      border-radius: 8
      font-color: "#1E293B"
      font-size: 20
    }
  }
  reads_s3: {
    style: {
      fill: "#FEF3C7"
      stroke: "#B45309"
      stroke-width: 2
      border-radius: 8
      font-color: "#1E293B"
      font-size: 20
    }
  }
  skips_s3: {
    style: {
      fill: "#CCFBF1"
      stroke: "#0F766E"
      stroke-width: 2
      border-radius: 8
      font-color: "#1E293B"
      font-size: 20
    }
  }
  flow: {
    style: {
      stroke: "#475569"
      stroke-width: 3
      font-color: "#334155"
      font-size: 20
    }
  }
  ref: {
    style: {
      stroke: "#64748B"
      stroke-width: 2
      stroke-dash: 4
      font-color: "#334155"
      font-size: 20
    }
  }
}

refresh: "Background refresh\nSnowflake polls the catalog\nand reads each new snapshot" {
  class: external
  top: 0
  left: 540
  width: 380
  height: 110
}
sql: "1. SQL arrives\nthe role needs SELECT" {
  class: box
  top: 150
  left: 0
  width: 420
  height: 84
}
plan: "2. Plan on the snapshot\ndrop files that cannot match" {
  class: box
  top: 274
  left: 0
  width: 420
  height: 84
}
saved: "3. Saved result exists?\nsame SQL text, table unchanged" {
  class: box
  top: 398
  left: 0
  width: 420
  height: 84
}
reuse: "Return the saved result\nno S3 read" {
  class: skips_s3
  top: 398
  left: 540
  width: 380
  height: 84
}
warehouse: "4. Warehouse reads the files\ncache first, S3 for the rest" {
  class: reads_s3
  top: 560
  left: 0
  width: 420
  height: 84
}
done: "5. Return rows, save the result\nkept for the next same SQL" {
  class: box
  top: 684
  left: 0
  width: 420
  height: 84
}

refresh -> plan: "as of last refresh" {class: ref}
sql -> plan: {class: flow}
plan -> saved: {class: flow}
saved -> reuse: "yes" {class: flow}
saved -> warehouse: "no" {class: flow}
warehouse -> done: {class: flow}
