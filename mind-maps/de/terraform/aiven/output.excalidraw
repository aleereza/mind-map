    {
      "type": "text",
      "version": 1,
      "versionNonce": 4778251625,
      "isDeleted": false,
      "id": "text-83e0698ed072",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 736.0,
      "y": 4594.5,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 367.2,
      "height": 90.0,
      "seed": 692569,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pitfalls\nThe pitfalls fall into three\ngroups: data loss, connectors, and\noperations.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-83e0698ed072",
      "originalText": "Pitfalls\nThe pitfalls fall into three groups: data loss, connectors, and operations.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-pitfalls"
      }
    },
    {
      "type": "rectangle",
