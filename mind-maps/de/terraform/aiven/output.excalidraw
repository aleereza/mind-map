      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5602579938,
      "isDeleted": false,
      "id": "text-7d8f2f207504",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1913.2,
      "y": 3243.25,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 840062,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Topic Identity\nA rename in the code deletes the topic with\nits messages and creates an empty one. A\nchanged `for_each` key without a `moved` block\nplans the same. When the new topic has the\nsame name, the plan fails with \"topic\nconflict, already exists\". The same error\nappears when a tool such as Kafka Connect\nalready created the topic, for example a\ndead-letter topic. In that case, import the\ntopic.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7d8f2f207504",
      "originalText": "Topic Identity\nA rename in the code deletes the topic with its messages and creates an empty one. A changed `for_each` key without a `moved` block plans the same. When the new topic has the same name, the plan fails with \"topic conflict, already exists\". The same error appears when a tool such as Kafka Connect already created the topic, for example a dead-letter topic. In that case, import the topic.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "topic-identity"
      }
    },
    {
      "type": "rectangle",
