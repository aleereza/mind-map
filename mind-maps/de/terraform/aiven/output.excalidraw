      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Connector Pitfalls\nThese pitfalls do not show as errors. The\nconnector runs, but not as the code says.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-93b753fd9f36",
      "originalText": "Connector Pitfalls\nThese pitfalls do not show as errors. The connector runs, but not as the code says.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-connector-pitfalls"
      }
    },
    {
