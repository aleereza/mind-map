    {
      "type": "text",
      "version": 1,
      "versionNonce": 2853667699,
      "isDeleted": false,
      "id": "text-3369451edb89",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
