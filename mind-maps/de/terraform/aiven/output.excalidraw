    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5324985417,
      "isDeleted": false,
      "id": "text-2ac9b7129236",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 7337.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 612745,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One Project per Environment\nAiven recommends separate projects for\nenvironments such as development and\nproduction ([organizations and projects](https\n://aiven.io/docs/platform/concepts/orgs-units-\nprojects)). It also recommends one application\nuser, with its own token, for each tool\n([application users](https://aiven.io/docs/pla\ntform/concepts/application-users)). Then a\ntoken for development cannot touch production,\nand each token can be rotated alone. One\nshared token for all environments is simpler,\nbut it gives every pipeline the rights of all\nof them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-2ac9b7129236",
      "originalText": "One Project per Environment\nAiven recommends separate projects for environments such as development and production ([organizations and projects](https://aiven.io/docs/platform/concepts/orgs-units-projects)). It also recommends one application user, with its own token, for each tool ([application users](https://aiven.io/docs/platform/concepts/application-users)). Then a token for development cannot touch production, and each token can be rotated alone. One shared token for all environments is simpler, but it gives every pipeline the rights of all of them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "one-project-per-environment"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7859410741,
      "isDeleted": false,
      "id": "node-8ee2140372f2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
