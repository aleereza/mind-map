    {
      "type": "text",
      "version": 1,
      "versionNonce": 6387527712,
      "isDeleted": false,
      "id": "text-ba8da7c65a77",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1896.4,
      "y": 5564.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
