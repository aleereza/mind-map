    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9147598137,
      "isDeleted": false,
      "id": "text-4c4e3fb8d3ed",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1913.2,
      "y": 2980.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 297.5,
      "seed": 859469,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Service Replacement\nA new `service_name` or `project`, for example\nfrom a typo in an input file, replaces the\nKafka service. Every topic, ACL and connector\ninside it is replaced too.\n`termination_protection` makes the delete fail\nin Aiven, and `lifecycle { prevent_destroy =\ntrue }` makes the plan fail before anything\nruns. The old topic-level\n`termination_protection` is checked only by\nthe provider, and only at apply ([issue 1596](\nhttps://github.com/aiven/terraform-provider-ai\nven/issues/1596)). Use `prevent_destroy`\ninstead, as the topic docs advise ([topic docs\n](https://github.com/aiven/terraform-provider-\naiven/blob/v4.66.0/docs/resources/kafka_topic.\nmd#L94)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-4c4e3fb8d3ed",
      "originalText": "Service Replacement\nA new `service_name` or `project`, for example from a typo in an input file, replaces the Kafka service. Every topic, ACL and connector inside it is replaced too. `termination_protection` makes the delete fail in Aiven, and `lifecycle { prevent_destroy = true }` makes the plan fail before anything runs. The old topic-level `termination_protection` is checked only by the provider, and only at apply ([issue 1596](https://github.com/aiven/terraform-provider-aiven/issues/1596)). Use `prevent_destroy` instead, as the topic docs advise ([topic docs](https://github.com/aiven/terraform-provider-aiven/blob/v4.66.0/docs/resources/kafka_topic.md#L94)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "service-replacement"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6608577432,
      "isDeleted": false,
      "id": "node-7d8f2f207504",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1901.2,
      "y": 3240.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 199.0,
