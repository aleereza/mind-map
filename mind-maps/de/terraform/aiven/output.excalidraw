    {
      "type": "text",
      "version": 1,
      "versionNonce": 7338946400,
      "isDeleted": false,
      "id": "text-2c9934afea16",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 2720.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 437.5,
      "seed": 439310,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| `-/+ aiven_kafka ... # forces replacement` |\nThe service and all its data will be deleted,\nand every child object replaced. |\n| `-/+ aiven_kafka_topic ... # forces\nreplacement` | The topic and its messages will\nbe deleted. |\n| `number of partitions cannot be decreased` |\nThe plan stops; Kafka cannot remove\npartitions. |\n| `topic conflict, already exists` | A topic\nwith this name exists outside this resource:\nimport it, or add a `moved` block. |\n| `schema is not compatible with previous\nversion` | The schema edit breaks the\ncompatibility rule. |\n| `~` on a connector `config` without a code\nchange | Someone changed the connector outside\nTerraform; the apply will revert it. |\n| `~` on integrations right after a provider\nupgrade | A resource moved to the Plugin\nFramework; see the changelog's IMPORTANT\nnotes. |",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-2c9934afea16",
      "originalText": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| `-/+ aiven_kafka ... # forces replacement` | The service and all its data will be deleted, and every child object replaced. |\n| `-/+ aiven_kafka_topic ... # forces replacement` | The topic and its messages will be deleted. |\n| `number of partitions cannot be decreased` | The plan stops; Kafka cannot remove partitions. |\n| `topic conflict, already exists` | A topic with this name exists outside this resource: import it, or add a `moved` block. |\n| `schema is not compatible with previous version` | The schema edit breaks the compatibility rule. |\n| `~` on a connector `config` without a code change | Someone changed the connector outside Terraform; the apply will revert it. |\n| `~` on integrations right after a provider upgrade | A resource moved to the Plugin Framework; see the changelog's IMPORTANT notes. |",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-plan-signals"
      }
    },
