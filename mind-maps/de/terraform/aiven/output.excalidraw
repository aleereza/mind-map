    {
      "type": "text",
      "version": 1,
      "versionNonce": 9560753902,
      "isDeleted": false,
      "id": "text-862386f375a4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 3739.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
