    {
      "type": "text",
      "version": 1,
      "versionNonce": 5729220400,
      "isDeleted": false,
      "id": "text-b7298129b221",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
