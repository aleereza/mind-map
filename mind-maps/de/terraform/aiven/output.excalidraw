    {
      "type": "text",
      "version": 1,
      "versionNonce": 1671347843,
      "isDeleted": false,
      "id": "text-c9a8e99c5313",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6599.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 159242,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Service Users in Code or by Hand\n`aiven_kafka_user` puts each service user in\ncode, with drift detection. Its password and\naccess key then sit in the state in plain\ntext, and write-only arguments need Terraform\n1.11 or later ([storing passwords](https://git\nhub.com/aiven/terraform-provider-aiven/blob/v4\n.66.0/docs/guides/storing-passwords.md)).\nUsers made by hand keep secrets out of the\nstate, but nothing checks them, and the ACLs\nrefer to names that Terraform cannot see.\nEither way, certificate renewal is a manual\nstep ([renew certificates](https://aiven.io/do\ncs/products/kafka/howto/renew-ssl-certs)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-c9a8e99c5313",
      "originalText": "Service Users in Code or by Hand\n`aiven_kafka_user` puts each service user in code, with drift detection. Its password and access key then sit in the state in plain text, and write-only arguments need Terraform 1.11 or later ([storing passwords](https://github.com/aiven/terraform-provider-aiven/blob/v4.66.0/docs/guides/storing-passwords.md)). Users made by hand keep secrets out of the state, but nothing checks them, and the ACLs refer to names that Terraform cannot see. Either way, certificate renewal is a manual step ([renew certificates](https://aiven.io/docs/products/kafka/howto/renew-ssl-certs)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "service-users-in-code-or-by-hand"
      }
    },
    {
