      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Operations Pitfalls\nThese pitfalls come from provider\nversions, schemas, access rules and\nservice state.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-755f14a6211b",
      "originalText": "Operations Pitfalls\nThese pitfalls come from provider versions, schemas, access rules and service state.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-operations-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9669306056,
      "isDeleted": false,
      "id": "node-b743fd201b04",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1884.4,
