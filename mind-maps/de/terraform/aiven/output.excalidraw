      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading an Aiven Configuration\nThese nodes say what you will find\nin the files, in which order to\nread them, and what each kind of\nplan line means.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-51522b90e902",
      "originalText": "Reading an Aiven Configuration\nThese nodes say what you will find in the files, in which order to read them, and what each kind of plan line means.",
      "lineHeight": 1.25,
