    {
      "type": "text",
      "version": 1,
      "versionNonce": 4886707986,
      "isDeleted": false,
      "id": "text-7834294d9203",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 3304.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 378.0,
      "height": 70.0,
      "seed": 98694,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data Loss Pitfalls\nThese pitfalls delete messages. A plan shows\neach of them, so they are caught when\nsomeone reads the plan.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7834294d9203",
      "originalText": "Data Loss Pitfalls\nThese pitfalls delete messages. A plan shows each of them, so they are caught when someone reads the plan.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aiven-data-loss-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5609327379,
      "isDeleted": false,
      "id": "node-4c4e3fb8d3ed",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1901.2,
      "y": 2980.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 445214,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
