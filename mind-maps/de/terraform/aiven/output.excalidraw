    {
      "type": "text",
      "version": 1,
      "versionNonce": 2890733006,
      "isDeleted": false,
      "id": "text-b743fd201b04",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1896.4,
      "y": 5039.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 108859,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Floating Provider Version\nA constraint such as `>= 4.46.0` with no\ncommitted lock file installs each new release\non the next run. Release 4.66.0, for example,\nmoved integrations to the Plugin Framework, so\ntheir first plan can show removed blocks. It\nalso fails the plan when one side of an\nintegration sets both an endpoint ID and a\nservice name ([4.66.0 notes](https://github.co\nm/aiven/terraform-provider-aiven/blob/v4.66.0/\nCHANGELOG.md#L15-L33)). Commit\n`.terraform.lock.hcl`, and raise the version\non purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b743fd201b04",
      "originalText": "Floating Provider Version\nA constraint such as `>= 4.46.0` with no committed lock file installs each new release on the next run. Release 4.66.0, for example, moved integrations to the Plugin Framework, so their first plan can show removed blocks. It also fails the plan when one side of an integration sets both an endpoint ID and a service name ([4.66.0 notes](https://github.com/aiven/terraform-provider-aiven/blob/v4.66.0/CHANGELOG.md#L15-L33)). Commit `.terraform.lock.hcl`, and raise the version on purpose.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "floating-provider-version"
      }
    },
    {
      "type": "rectangle",
