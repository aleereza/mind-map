    {
      "type": "text",
      "version": 1,
      "versionNonce": 3221760845,
      "isDeleted": false,
      "id": "text-a45b66d24f88",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6000000000001,
      "y": 3999.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 332.5,
      "seed": 738227,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Connector Drift\nAn edit in the Aiven Console shows in the next\nplan, and the apply reverts it. For example,\nthe console option for automatic restart is\nthe key `_aiven.restart.on.failure` in the\nconnector config ([provider example](https://g\nithub.com/aiven/terraform-provider-aiven/blob/\nv4.66.0/examples/postgres/postgres_debezium_ka\nfka/debezium_connector.tf#L24)); put it in the\ncode to keep it. A change of `connector_name`\nor `service_name` creates a new connector. A\nsink connector reads with the consumer group\n`connect-<connector name>` ([Kafka source](htt\nps://github.com/apache/kafka/blob/4.1.0/connec\nt/runtime/src/main/java/org/apache/kafka/conne\nct/util/SinkUtils.java#L39-L41)). So a new\nname starts a new group with no saved offsets,\nand it reads the topic again from its\nconfigured start point.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-a45b66d24f88",
      "originalText": "Connector Drift\nAn edit in the Aiven Console shows in the next plan, and the apply reverts it. For example, the console option for automatic restart is the key `_aiven.restart.on.failure` in the connector config ([provider example](https://github.com/aiven/terraform-provider-aiven/blob/v4.66.0/examples/postgres/postgres_debezium_kafka/debezium_connector.tf#L24)); put it in the code to keep it. A change of `connector_name` or `service_name` creates a new connector. A sink connector reads with the consumer group `connect-<connector name>` ([Kafka source](https://github.com/apache/kafka/blob/4.1.0/connect/runtime/src/main/java/org/apache/kafka/connect/util/SinkUtils.java#L39-L41)). So a new name starts a new group with no saved offsets, and it reads the topic again from its configured start point.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "connector-drift"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6918415047,
      "isDeleted": false,
      "id": "node-44344e6522c3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1867.6000000000001,
      "y": 4259.0,
      "strokeColor": "#92400E",
