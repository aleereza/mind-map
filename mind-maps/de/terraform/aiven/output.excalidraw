    {
      "type": "text",
      "version": 1,
      "versionNonce": 9354620381,
      "isDeleted": false,
      "id": "text-6e0ed3bfa060",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6339.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 193817,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dedicated or Shared Connect\nKafka Connect can run on the nodes of the\nKafka service or in a dedicated Connect\nservice ([enable Kafka Connect](https://aiven.\nio/docs/products/kafka/kafka-connect/howto/ena\nble-connect)). On the Kafka nodes it costs\nnothing extra, but it shares CPU and memory\nwith the brokers and needs a business or\npremium plan. A dedicated service costs more\nand scales on its own. The trade-off is cost\nagainst the stability of the brokers. Moving a\nconnector between the two recreates it, so\nchoose before the first apply.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-6e0ed3bfa060",
      "originalText": "Dedicated or Shared Connect\nKafka Connect can run on the nodes of the Kafka service or in a dedicated Connect service ([enable Kafka Connect](https://aiven.io/docs/products/kafka/kafka-connect/howto/enable-connect)). On the Kafka nodes it costs nothing extra, but it shares CPU and memory with the brokers and needs a business or premium plan. A dedicated service costs more and scales on its own. The trade-off is cost against the stability of the brokers. Moving a connector between the two recreates it, so choose before the first apply.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dedicated-or-shared-connect"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2413878636,
      "isDeleted": false,
      "id": "node-c9a8e99c5313",
