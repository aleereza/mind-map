      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3256560063,
      "isDeleted": false,
      "id": "text-bc6e0f055b2e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 1940.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 525.0,
      "seed": 57511,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Where to Look First\nRead an Auth0 configuration in this order:\n\n1. `required_providers`, the lock file and the\nprovider block. Note the version gap to the\nlatest release, and where the credentials and\nthe tenant domain come from.\n2. The backend and the environment selector.\nMap each state to a tenant, and flag any\ntenant that two states change.\n3. The singletons. Each one needs exactly one\nowner per tenant.\n4. The link resources. Look for singular and\nplural styles on the same parent, in this repo\nand in others.\n5. `auth0_action`: `deploy`, the runtime, the\nsecrets, and where its binding lives.\n6. `auth0_connection`: the strategy, the full\n`options` block and its secrets.\n7. `auth0_client`, its credentials and grants:\nthe app type, the callback and origin lists,\nand grants to the Management API.\n8. The data sources and outputs: lookups by\nname, and secrets that leave for other\nsystems.\n9. The `lifecycle` blocks: each\n`ignore_changes` marks a field that a person\nor another state owns.\n10. `auth0_log_stream`: the filters and the\ntarget system.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-bc6e0f055b2e",
      "originalText": "Where to Look First\nRead an Auth0 configuration in this order:\n\n1. `required_providers`, the lock file and the provider block. Note the version gap to the latest release, and where the credentials and the tenant domain come from.\n2. The backend and the environment selector. Map each state to a tenant, and flag any tenant that two states change.\n3. The singletons. Each one needs exactly one owner per tenant.\n4. The link resources. Look for singular and plural styles on the same parent, in this repo and in others.\n5. `auth0_action`: `deploy`, the runtime, the secrets, and where its binding lives.\n6. `auth0_connection`: the strategy, the full `options` block and its secrets.\n7. `auth0_client`, its credentials and grants: the app type, the callback and origin lists, and grants to the Management API.\n8. The data sources and outputs: lookups by name, and secrets that leave for other systems.\n9. The `lifecycle` blocks: each `ignore_changes` marks a field that a person or another state owns.\n10. `auth0_log_stream`: the filters and the target system.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "auth0-where-to-look-first"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5788594415,
      "isDeleted": false,
      "id": "node-fb752c7dfef1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 2200.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
