        "node_id": "auth0-decisions"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9722569905,
      "isDeleted": false,
      "id": "node-dc7f387de99d",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 5316.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 208560,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
