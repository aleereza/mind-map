      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9337791015,
      "isDeleted": false,
      "id": "text-dc7f387de99d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5316.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 128806,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One Tenant per Environment\nAuth0 recommends separate tenants for\ndevelopment, staging and production ([multiple\nenvironments](https://auth0.com/docs/get-start\ned/auth0-overview/create-tenants/set-up-multip\nle-environments)). A shared tenant saves a\ntenant and lets staging test the real company\ndirectory. But then the tenant-wide settings\nneed guards in code, two states share objects,\na staging log stream also exports production\nevents, and a staging apply can change\nproduction actions. A tenant used by\nproduction should also carry the production\ntag, because the production rate limits apply\nonly to such tenants (same page).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-dc7f387de99d",
      "originalText": "One Tenant per Environment\nAuth0 recommends separate tenants for development, staging and production ([multiple environments](https://auth0.com/docs/get-started/auth0-overview/create-tenants/set-up-multiple-environments)). A shared tenant saves a tenant and lets staging test the real company directory. But then the tenant-wide settings need guards in code, two states share objects, a staging log stream also exports production events, and a staging apply can change production actions. A tenant used by production should also carry the production tag, because the production rate limits apply only to such tenants (same page).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "one-tenant-per-environment"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4124688038,
      "isDeleted": false,
      "id": "node-451b3f394516",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 5576.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 576195,
      "groupIds": [],
