      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Good and Bad Decisions\nEach node compares a choice with\nits alternative.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-f79783f00208",
      "originalText": "Good and Bad Decisions\nEach node compares a choice with its alternative.",
      "lineHeight": 1.25,
      "autoResize": true,
