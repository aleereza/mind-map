      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 4288354493,
      "isDeleted": false,
      "id": "text-2c3ae304c2f4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1897.6,
      "y": 4801.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 328311,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Rate Limits\nThe Management API has rate limits per tenant\n([rate limit policy](https://auth0.com/docs/tr\noubleshoot/customer-support/operational-polici\nes/rate-limit-policy)). A large configuration\nreads many objects in every plan, even with no\nchanges, and it can hit the limit ([issue 1488\n](https://github.com/auth0/terraform-provider-\nauth0/issues/1488)). The provider then waits\nand retries, so plans get slow. Calls that\nTerraform makes share the limit with the apps\nthat use the tenant.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-2c3ae304c2f4",
      "originalText": "Rate Limits\nThe Management API has rate limits per tenant ([rate limit policy](https://auth0.com/docs/troubleshoot/customer-support/operational-policies/rate-limit-policy)). A large configuration reads many objects in every plan, even with no changes, and it can hit the limit ([issue 1488](https://github.com/auth0/terraform-provider-auth0/issues/1488)). The provider then waits and retries, so plans get slow. Calls that Terraform makes share the limit with the apps that use the tenant.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "rate-limits"
      }
    },
