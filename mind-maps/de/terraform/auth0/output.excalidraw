    {
      "type": "text",
      "version": 1,
      "versionNonce": 6390663619,
      "isDeleted": false,
      "id": "text-428ebd2abc20",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1872.4,
      "y": 3240.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 481508,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data Sources Copy Secrets\n`data \"auth0_client\"` stores the client secret\nof the application that it reads. `data\n\"auth0_connection\"` stores the connection\noptions, including an identity provider's\nsecret. So every configuration that only reads\nthese objects also holds their secrets in its\nstate. Newer versions add `hide_client_secret`\nto both data sources ([client data source](htt\nps://github.com/auth0/terraform-provider-auth0\n/blob/v1.63.0/docs/data-sources/client.md#L31)\n; [connection data source](https://github.com/\nauth0/terraform-provider-auth0/blob/v1.63.0/do\ncs/data-sources/connection.md#L31)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-428ebd2abc20",
      "originalText": "Data Sources Copy Secrets\n`data \"auth0_client\"` stores the client secret of the application that it reads. `data \"auth0_connection\"` stores the connection options, including an identity provider's secret. So every configuration that only reads these objects also holds their secrets in its state. Newer versions add `hide_client_secret` to both data sources ([client data source](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/data-sources/client.md#L31); [connection data source](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/data-sources/connection.md#L31)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "data-sources-copy-secrets"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7369000023,
      "isDeleted": false,
      "id": "node-212aacd5db73",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
