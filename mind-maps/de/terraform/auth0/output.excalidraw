    {
      "type": "text",
      "version": 1,
      "versionNonce": 4062148097,
      "isDeleted": false,
      "id": "text-55d1f4fb9b97",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5848.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 122.5,
      "seed": 207189,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One Owner per Parent\nUse a plural link resource when one\nconfiguration owns the parent: it removes\nstrays and keeps the order of actions. Use\nsingular resources when several configurations\neach add their own item. Never mix the two on\none parent (see Plural Owns, Singular Adds).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-55d1f4fb9b97",
      "originalText": "One Owner per Parent\nUse a plural link resource when one configuration owns the parent: it removes strays and keeps the order of actions. Use singular resources when several configurations each add their own item. Never mix the two on one parent (see Plural Owns, Singular Adds).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "one-owner-per-parent"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7208900471,
      "isDeleted": false,
      "id": "node-aa0ef375b8b4",
