    {
      "type": "text",
      "version": 1,
      "versionNonce": 1504496962,
      "isDeleted": false,
      "id": "text-f79783f00208",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
