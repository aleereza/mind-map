    {
      "type": "text",
      "version": 1,
      "versionNonce": 2037555451,
      "isDeleted": false,
      "id": "text-a18975aa6d4b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1872.4,
      "y": 4020.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 597967,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Secret Rotation\nAuth0 rotates a client secret in the dashboard\nor through the API, and a new secret can take\nup to 30 seconds to work ([rotate a client sec\nret](https://auth0.com/docs/get-started/applic\nations/rotate-client-secret)). Replacing\n`auth0_client_credentials` in Terraform does\nnot rotate the secret ([issue 1785](https://gi\nthub.com/auth0/terraform-provider-auth0/issues\n/1785)). A rotated secret can also have\ncopies, for example in Secrets Manager, in an\naction secret or in a pipeline variable. Each\ncopy changes only at the next apply of the\nconfiguration that writes it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-a18975aa6d4b",
      "originalText": "Secret Rotation\nAuth0 rotates a client secret in the dashboard or through the API, and a new secret can take up to 30 seconds to work ([rotate a client secret](https://auth0.com/docs/get-started/applications/rotate-client-secret)). Replacing `auth0_client_credentials` in Terraform does not rotate the secret ([issue 1785](https://github.com/auth0/terraform-provider-auth0/issues/1785)). A rotated secret can also have copies, for example in Secrets Manager, in an action secret or in a pipeline variable. Each copy changes only at the next apply of the configuration that writes it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "secret-rotation"
      }
    },
