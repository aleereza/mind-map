      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Ownership Pitfalls\nThese pitfalls appear when two owners act on\none tenant.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-657353782e12",
      "originalText": "Ownership Pitfalls\nThese pitfalls appear when two owners act on one tenant.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "auth0-ownership-pitfalls"
      }
    },
    {
      "type": "rectangle",
