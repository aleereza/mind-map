    {
      "type": "text",
      "version": 1,
      "versionNonce": 9443190683,
      "isDeleted": false,
      "id": "text-8b1ec677edd3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 736.0,
      "y": 1993.75,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 367.2,
      "height": 112.5,
      "seed": 208166,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading an Auth0 Configuration\nThese nodes say what you will find\nin the files, in which order to\nread them, and what each kind of\nplan line means.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-8b1ec677edd3",
      "originalText": "Reading an Auth0 Configuration\nThese nodes say what you will find in the files, in which order to read them, and what each kind of plan line means.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-auth0-configuration"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7391236106,
      "isDeleted": false,
      "id": "node-df8837358f72",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 1680.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 937445,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-df8837358f72"
        },
        {
