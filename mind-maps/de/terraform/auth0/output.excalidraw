      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8709684856,
      "isDeleted": false,
      "id": "text-7b4228ff18ff",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1872.4,
      "y": 2980.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 525.0,
      "seed": 962362,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Singletons on Destroy\nA destroy of a tenant-wide setting does\ndifferent things:\n\n| Resource | What a destroy does |\n| --- | --- |\n| `auth0_tenant`, `auth0_prompt` | Nothing in\nAuth0; it only leaves the state ([tenant code]\n(https://github.com/auth0/terraform-provider-a\nuth0/blob/v1.63.0/internal/auth0/tenant/resour\nce.go#L642-L644)). |\n| `auth0_branding` | Deletes the Universal\nLogin template ([branding code](https://github\n.com/auth0/terraform-provider-auth0/blob/v1.63\n.0/internal/auth0/branding/resource.go#L177-L1\n88)). |\n| `auth0_attack_protection` | Turns off\nbreached-password detection, brute-force\nprotection and IP throttling ([code](https://g\nithub.com/auth0/terraform-provider-auth0/blob/\nv1.63.0/internal/auth0/attackprotection/resour\nce.go#L837-L879)). |\n| `auth0_guardian` | Turns off all\nmulti-factor authentication factors ([code](ht\ntps://github.com/auth0/terraform-provider-auth\n0/blob/v1.63.0/internal/auth0/guardian/resourc\ne.go#L693-L709)). |\n\nSo removing a singleton from the code can\nweaken the security of a production tenant.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7b4228ff18ff",
      "originalText": "Singletons on Destroy\nA destroy of a tenant-wide setting does different things:\n\n| Resource | What a destroy does |\n| --- | --- |\n| `auth0_tenant`, `auth0_prompt` | Nothing in Auth0; it only leaves the state ([tenant code](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/internal/auth0/tenant/resource.go#L642-L644)). |\n| `auth0_branding` | Deletes the Universal Login template ([branding code](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/internal/auth0/branding/resource.go#L177-L188)). |\n| `auth0_attack_protection` | Turns off breached-password detection, brute-force protection and IP throttling ([code](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/internal/auth0/attackprotection/resource.go#L837-L879)). |\n| `auth0_guardian` | Turns off all multi-factor authentication factors ([code](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/internal/auth0/guardian/resource.go#L693-L709)). |\n\nSo removing a singleton from the code can weaken the security of a production tenant.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "singletons-on-destroy"
      }
    },
