      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Secret Pitfalls\nThese pitfalls put secrets where they do not\nbelong, or lose them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e05febfd0cf7",
      "originalText": "Secret Pitfalls\nThese pitfalls put secrets where they do not belong, or lose them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "auth0-secret-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5924787715,
      "isDeleted": false,
      "id": "node-428ebd2abc20",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1860.4,
