    {
      "type": "text",
      "version": 1,
      "versionNonce": 4478698215,
      "isDeleted": false,
      "id": "text-aa0ef375b8b4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6035.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 415083,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Start from the Generated Config\nThe Auth0 CLI command `auth0 tf generate`\nwrites Terraform files and import blocks for\nan existing tenant ([generate guide](https://g\nithub.com/auth0/terraform-provider-auth0/blob/\nv1.63.0/docs/guides/generate_terraform_config.\nmd)). It is experimental, and it does not\nexport secrets. It writes plural resources\nsuch as `auth0_trigger_actions`, so check for\nsingular resources on the same parents before\nyou merge its output.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-aa0ef375b8b4",
      "originalText": "Start from the Generated Config\nThe Auth0 CLI command `auth0 tf generate` writes Terraform files and import blocks for an existing tenant ([generate guide](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/guides/generate_terraform_config.md)). It is experimental, and it does not export secrets. It writes plural resources such as `auth0_trigger_actions`, so check for singular resources on the same parents before you merge its output.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "start-from-generated-config"
      }
    },
