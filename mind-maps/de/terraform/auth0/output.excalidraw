      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6119901684,
      "isDeleted": false,
      "id": "text-0864a35b180f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1897.6,
      "y": 4541.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 167298,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Lists Stay Unless Emptied\nRemoving a list argument, such as `callbacks`\nor `allowed_origins`, from the code changes\nnothing in Auth0. To clear a list, set it to\n`[]` ([issue 1108](https://github.com/auth0/te\nrraform-provider-auth0/issues/1108)).\n`allowed_origins` also defaults to the\ncallback URLs ([client doc](https://github.com\n/auth0/terraform-provider-auth0/blob/v1.63.0/d\nocs/resources/client.md#L213)). So a localhost\ncallback left in a development list also\nbecomes an allowed origin.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-0864a35b180f",
      "originalText": "Lists Stay Unless Emptied\nRemoving a list argument, such as `callbacks` or `allowed_origins`, from the code changes nothing in Auth0. To clear a list, set it to `[]` ([issue 1108](https://github.com/auth0/terraform-provider-auth0/issues/1108)). `allowed_origins` also defaults to the callback URLs ([client doc](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/resources/client.md#L213)). So a localhost callback left in a development list also becomes an allowed origin.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "lists-stay-unless-emptied"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8954821312,
      "isDeleted": false,
      "id": "node-2c3ae304c2f4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1885.6,
      "y": 4796.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 294838,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
