      "updated": 1,
      "link": null,
      "locked": false,
      "text": "About the Sources\nThe provider facts come from the `auth0/auth0`\nrepository at tag v1.63.0, the latest release on\n2026-11-23, and at tag v1.27.0 for one older\ncode path. The Auth0 facts come from\nauth0.com/docs on the same day.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 16.25,
      "containerId": "node-dafc8c02d937",
      "originalText": "About the Sources\nThe provider facts come from the `auth0/auth0` repository at tag v1.63.0, the latest release on 2026-11-23, and at tag v1.27.0 for one older code path. The Auth0 facts come from auth0.com/docs on the same day.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "auth0-about-the-sources"
      }
    },
