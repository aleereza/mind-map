      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Change Pitfalls\nThese pitfalls appear during normal changes\nand upgrades.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b6793ec4a789",
      "originalText": "Change Pitfalls\nThese pitfalls appear during normal changes and upgrades.",
      "lineHeight": 1.25,
      "autoResize": true,
