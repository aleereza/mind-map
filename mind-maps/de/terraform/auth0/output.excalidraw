      "versionNonce": 7237787850,
      "isDeleted": false,
      "id": "node-4ce16aa51659",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1860.4,
      "y": 2460.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
