      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1357419288,
      "isDeleted": false,
      "id": "text-451b3f394516",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5576.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 297.5,
      "seed": 651401,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Least Privilege for Terraform's Client\nThe provider's quickstart authorizes all\nManagement API scopes for Terraform's\napplication ([quickstart](https://github.com/a\nuth0/terraform-provider-auth0/blob/v1.63.0/doc\ns/guides/quickstart.md#L27-L28)). That is\neasy, but it includes every delete scope. A\nsmaller set must still include the read scopes\nthat some attributes depend on, such as\n`read:client_keys` and\n`read:connections_options`; otherwise values\nread as empty. Keep the credentials in\nenvironment variables, not in code, and prefer\na signed JWT over a shared secret ([provider c\nonfiguration](https://github.com/auth0/terrafo\nrm-provider-auth0/blob/v1.63.0/docs/index.md#L\n29-L41)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-451b3f394516",
      "originalText": "Least Privilege for Terraform's Client\nThe provider's quickstart authorizes all Management API scopes for Terraform's application ([quickstart](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/guides/quickstart.md#L27-L28)). That is easy, but it includes every delete scope. A smaller set must still include the read scopes that some attributes depend on, such as `read:client_keys` and `read:connections_options`; otherwise values read as empty. Keep the credentials in environment variables, not in code, and prefer a signed JWT over a shared secret ([provider configuration](https://github.com/auth0/terraform-provider-auth0/blob/v1.63.0/docs/index.md#L29-L41)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "least-privilege-for-terraform"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7924989347,
      "isDeleted": false,
      "id": "node-55d1f4fb9b97",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
