      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pitfalls\nThe pitfalls fall into three\ngroups: ownership, secrets,\nand change management.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-91b8fb9586f9",
      "originalText": "Pitfalls\nThe pitfalls fall into three groups: ownership, secrets, and change management.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "auth0-pitfalls"
      }
    },
