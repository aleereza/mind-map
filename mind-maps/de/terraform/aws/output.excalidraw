    {
      "type": "text",
      "version": 1,
      "versionNonce": 6708978783,
      "isDeleted": false,
      "id": "text-e772705d75d5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1940.8,
      "y": 5281.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 402956,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Old S3 Backend Arguments\nTerraform 1.10.0 removed the old top-level\narguments for assuming a role in `backend\n\"s3\"`, such as `role_arn`; it requires an\n`assume_role` block ([Terraform 1.10.0 changes\n](https://github.com/hashicorp/terraform/blob/\nv1.10.0/CHANGELOG.md#L35)). A configuration\nwith the old form therefore keeps the whole\npipeline on Terraform 1.9. That also blocks\nwrite-only arguments, which need 1.11.\nTerraform 1.11.0 deprecated DynamoDB locking\nin favor of `use_lockfile` ([Terraform 1.11.0 \nchanges](https://github.com/hashicorp/terrafor\nm/blob/v1.11.0/CHANGELOG.md#L10)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e772705d75d5",
      "originalText": "Old S3 Backend Arguments\nTerraform 1.10.0 removed the old top-level arguments for assuming a role in `backend \"s3\"`, such as `role_arn`; it requires an `assume_role` block ([Terraform 1.10.0 changes](https://github.com/hashicorp/terraform/blob/v1.10.0/CHANGELOG.md#L35)). A configuration with the old form therefore keeps the whole pipeline on Terraform 1.9. That also blocks write-only arguments, which need 1.11. Terraform 1.11.0 deprecated DynamoDB locking in favor of `use_lockfile` ([Terraform 1.11.0 changes](https://github.com/hashicorp/terraform/blob/v1.11.0/CHANGELOG.md#L10)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "old-s3-backend-arguments"
      }
    },
    {
      "type": "rectangle",
