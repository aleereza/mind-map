      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Data Loss Pitfalls\nThese pitfalls delete or freeze\ndata.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-22c822d24826",
      "originalText": "Data Loss Pitfalls\nThese pitfalls delete or freeze data.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-data-loss-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9066818723,
      "isDeleted": false,
      "id": "node-c61c53f0c367",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1844.8,
      "y": 2720.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
