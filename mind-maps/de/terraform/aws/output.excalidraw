      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Event Wiring Pitfalls\nThese pitfalls break the path from a new\nfile to the code that handles it. Files keep\narriving, but nothing reacts.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-edfcc2a0579c",
      "originalText": "Event Wiring Pitfalls\nThese pitfalls break the path from a new file to the code that handles it. Files keep arriving, but nothing reacts.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-event-wiring-pitfalls"
      }
    },
