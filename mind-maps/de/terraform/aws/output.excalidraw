      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9839409045,
      "isDeleted": false,
      "id": "text-62f7b42ee02c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1856.8,
      "y": 3240.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 155109,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Database Versions and Replacements\nWith automatic minor upgrades on, AWS raises\nthe engine version of an RDS instance by\nitself. A configuration that pins\n`engine_version = \"16.4\"` then plans a\ndowngrade, and AWS rejects it. The provider\ndocs advise a version prefix, such as `\"16\"`,\nin that case ([db_instance doc](https://github\n.com/hashicorp/terraform-provider-aws/blob/v6.\n73.0/website/docs/r/db_instance.html.markdown#\nL342)). Other changes replace the instance:\nfor example `engine`, `username`, `db_name` or\n`storage_encrypted`. Keep\n`deletion_protection` on and a final snapshot\nset.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-62f7b42ee02c",
      "originalText": "Database Versions and Replacements\nWith automatic minor upgrades on, AWS raises the engine version of an RDS instance by itself. A configuration that pins `engine_version = \"16.4\"` then plans a downgrade, and AWS rejects it. The provider docs advise a version prefix, such as `\"16\"`, in that case ([db_instance doc](https://github.com/hashicorp/terraform-provider-aws/blob/v6.73.0/website/docs/r/db_instance.html.markdown#L342)). Other changes replace the instance: for example `engine`, `username`, `db_name` or `storage_encrypted`. Keep `deletion_protection` on and a final snapshot set.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "database-versions-and-replacements"
      }
    },
    {
      "type": "rectangle",
