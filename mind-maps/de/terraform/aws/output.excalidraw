      "id": "text-4f84b61db706",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1160.0,
      "strokeColor": "#1E3A8A",
