      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8011583859,
      "isDeleted": false,
      "id": "text-b7819e8c4084",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6551.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 157.5,
      "seed": 945612,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Protect Buckets That Hold Data\nA bucket for test files can use\n`force_destroy`, so it is easy to remove. A\nbucket with data that cannot be rebuilt should\nkeep `force_destroy` false and add `lifecycle\n{ prevent_destroy = true }`. Versioning and\nexpiry rules for old versions then protect\nagainst overwrites without growing the bucket\nforever.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b7819e8c4084",
      "originalText": "Protect Buckets That Hold Data\nA bucket for test files can use `force_destroy`, so it is easy to remove. A bucket with data that cannot be rebuilt should keep `force_destroy` false and add `lifecycle { prevent_destroy = true }`. Versioning and expiry rules for old versions then protect against overwrites without growing the bucket forever.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "protect-buckets-that-hold-data"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2536359727,
      "isDeleted": false,
      "id": "node-84fb7a74e7ba",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 6761.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
