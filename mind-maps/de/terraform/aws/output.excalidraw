      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pitfalls\nThe pitfalls fall into four\ngroups: data loss, event wiring,\nidentity and secrets, and provider\nversions.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-51ed7cd12f1d",
      "originalText": "Pitfalls\nThe pitfalls fall into four groups: data loss, event wiring, identity and secrets, and provider versions.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-pitfalls"
      }
    },
