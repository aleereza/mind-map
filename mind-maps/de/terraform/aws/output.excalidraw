      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "About the Sources\nThe provider facts come from the `hashicorp/aws`\nrepository at tag v6.73.0 and the `hashicorp/awscc`\nrepository at tag v1.110.0, the latest releases on\n2026-11-23. The AWS facts come from\ndocs.aws.amazon.com on the same day, and the\nTerraform facts from the Terraform changelogs at\ntags v1.10.0 and v1.11.0.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 16.25,
      "containerId": "node-b58f9ceb46f4",
      "originalText": "About the Sources\nThe provider facts come from the `hashicorp/aws` repository at tag v6.73.0 and the `hashicorp/awscc` repository at tag v1.110.0, the latest releases on 2026-11-23. The AWS facts come from docs.aws.amazon.com on the same day, and the Terraform facts from the Terraform changelogs at tags v1.10.0 and v1.11.0.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-about-the-sources"
      }
    },
