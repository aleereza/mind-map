    {
      "type": "text",
      "version": 1,
      "versionNonce": 7680303772,
      "isDeleted": false,
      "id": "text-37d58ab0a531",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1940.8,
      "y": 5801.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 129746,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Version Bugs\nEach provider release fixes bugs, and some\nreleases add them. For example, on versions\n6.0 to 6.8, a tag change on `aws_ecs_service`\nappeared in every plan, but the apply never\nwrote it; 6.9.0 fixed it ([issue 43570](https:\n//github.com/hashicorp/terraform-provider-aws/\nissues/43570)). A patch-level pin, such as `~>\n6.8.0`, keeps such a bug. With no committed\nlock file, a loose constraint such as `>=\n6.5.0` installs each new major version as soon\nas it appears. Commit the lock file, and raise\nversions on purpose.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-37d58ab0a531",
      "originalText": "Version Bugs\nEach provider release fixes bugs, and some releases add them. For example, on versions 6.0 to 6.8, a tag change on `aws_ecs_service` appeared in every plan, but the apply never wrote it; 6.9.0 fixed it ([issue 43570](https://github.com/hashicorp/terraform-provider-aws/issues/43570)). A patch-level pin, such as `~> 6.8.0`, keeps such a bug. With no committed lock file, a loose constraint such as `>= 6.5.0` installs each new major version as soon as it appears. Commit the lock file, and raise versions on purpose.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "version-bugs"
      }
    },
