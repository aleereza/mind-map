      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Identity and Secret Pitfalls\nThese pitfalls break access or leak secrets.\nPlans show them only indirectly.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-aab60b0c23dc",
      "originalText": "Identity and Secret Pitfalls\nThese pitfalls break access or leak secrets. Plans show them only indirectly.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-identity-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9476907879,
      "isDeleted": false,
      "id": "node-104af0ff58d3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1903.6,
      "y": 4280.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 878442,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
