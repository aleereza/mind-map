      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8045532404,
      "isDeleted": false,
      "id": "text-a43b0c9766b0",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1856.8,
      "y": 2980.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 232661,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Versioning Cannot Be Turned Off\n`Disabled` is valid only when a bucket is\ncreated or imported. A change from `Enabled`\nor `Suspended` to `Disabled` fails, because S3\ncannot return a bucket to the unversioned\nstate ([versioning doc](https://github.com/has\nhicorp/terraform-provider-aws/blob/v6.73.0/web\nsite/docs/r/s3_bucket_versioning.html.markdown\n#L103-L104)). Use `Suspended` instead. After\nyou first enable versioning, AWS advises\nwaiting 15 minutes before writes ([versioning \ndoc](https://github.com/hashicorp/terraform-pr\novider-aws/blob/v6.73.0/website/docs/r/s3_buck\net_versioning.html.markdown#L17)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-a43b0c9766b0",
      "originalText": "Versioning Cannot Be Turned Off\n`Disabled` is valid only when a bucket is created or imported. A change from `Enabled` or `Suspended` to `Disabled` fails, because S3 cannot return a bucket to the unversioned state ([versioning doc](https://github.com/hashicorp/terraform-provider-aws/blob/v6.73.0/website/docs/r/s3_bucket_versioning.html.markdown#L103-L104)). Use `Suspended` instead. After you first enable versioning, AWS advises waiting 15 minutes before writes ([versioning doc](https://github.com/hashicorp/terraform-provider-aws/blob/v6.73.0/website/docs/r/s3_bucket_versioning.html.markdown#L17)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "versioning-cannot-be-turned-off"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3036531442,
      "isDeleted": false,
      "id": "node-62f7b42ee02c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1844.8,
      "y": 3240.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 303187,
      "groupIds": [],
