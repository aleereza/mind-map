    {
      "type": "text",
      "version": 1,
      "versionNonce": 8095379729,
      "isDeleted": false,
      "id": "text-e519c45766dc",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1915.6,
      "y": 5063.25,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 304079,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "IAM Size Limits\nThe inline policies of one role can hold\n10,240 characters in total, and one managed\npolicy can hold 6,144 ([IAM quotas](https://do\ncs.aws.amazon.com/IAM/latest/UserGuide/referen\nce_iam-quotas.html)). A role can have 20\nattached managed policies by default, and 25\nat most. A growing `for_each` that adds\nstatements can pass the plan and fail the\napply at one of these limits.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e519c45766dc",
      "originalText": "IAM Size Limits\nThe inline policies of one role can hold 10,240 characters in total, and one managed policy can hold 6,144 ([IAM quotas](https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_iam-quotas.html)). A role can have 20 attached managed policies by default, and 25 at most. A growing `for_each` that adds statements can pass the plan and fail the apply at one of these limits.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "iam-size-limits"
      }
    },
