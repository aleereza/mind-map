    {
      "type": "text",
      "version": 1,
      "versionNonce": 9813018942,
      "isDeleted": false,
      "id": "text-c28df3279598",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1680.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
