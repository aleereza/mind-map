    {
      "type": "text",
      "version": 1,
      "versionNonce": 6845966707,
      "isDeleted": false,
      "id": "text-ea15b27ee859",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
