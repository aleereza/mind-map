      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Provider Version Pitfalls\nThese pitfalls come from Terraform and\nprovider versions.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-fc903f369db7",
      "originalText": "Provider Version Pitfalls\nThese pitfalls come from Terraform and provider versions.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "aws-provider-version-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8093371571,
      "isDeleted": false,
      "id": "node-e772705d75d5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1928.8,
      "y": 5281.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
