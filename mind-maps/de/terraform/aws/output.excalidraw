      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 1623570195,
      "isDeleted": false,
      "id": "text-c61c53f0c367",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1856.8,
      "y": 2725.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 536387,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Force Destroy Empties the Bucket\nWith `force_destroy = true`, a destroy of the\nbucket first deletes every object and every\nversion, locked objects included ([bucket doc]\n(https://github.com/hashicorp/terraform-provid\ner-aws/blob/v6.73.0/website/docs/r/s3_bucket.h\ntml.markdown#L58)). A rename, a moved resource\nwithout a `moved` block, or a deleted module\ncall can plan that destroy. The setting takes\neffect only after an apply has stored it in\nthe state. Keep it false on buckets with data,\nand add `prevent_destroy`.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-c61c53f0c367",
      "originalText": "Force Destroy Empties the Bucket\nWith `force_destroy = true`, a destroy of the bucket first deletes every object and every version, locked objects included ([bucket doc](https://github.com/hashicorp/terraform-provider-aws/blob/v6.73.0/website/docs/r/s3_bucket.html.markdown#L58)). A rename, a moved resource without a `moved` block, or a deleted module call can plan that destroy. The setting takes effect only after an apply has stored it in the state. Keep it false on buckets with data, and add `prevent_destroy`.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "force-destroy-empties-bucket"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2487683009,
      "isDeleted": false,
      "id": "node-a43b0c9766b0",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1844.8,
      "y": 2980.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 404402,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
