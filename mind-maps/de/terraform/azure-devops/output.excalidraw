    {
      "type": "text",
      "version": 1,
      "versionNonce": 3434639343,
      "isDeleted": false,
      "id": "text-2d13706f1a97",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
