    {
      "type": "text",
      "version": 1,
      "versionNonce": 9108632462,
      "isDeleted": false,
      "id": "text-ec13f18134d3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
