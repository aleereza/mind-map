      "angle": 0,
      "x": 1890.4,
      "y": 2960.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 855554,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Multi-Line Secrets Leak\nA private key in PEM format has many lines.\nPassed on the command line as `-var\nkey=$(secret)`, each line can appear in the\nlog, because Azure Pipelines masks only the\nfull value ([secrets](https://learn.microsoft.\ncom/en-us/azure/devops/pipelines/security/secr\nets)). Pass such secrets as `TF_VAR_*`\nenvironment variables or as secure files, and\nrotate any secret that has leaked. Watch for a\ntrailing newline, which can make Terraform see\na changed value.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-2d13706f1a97",
      "originalText": "Multi-Line Secrets Leak\nA private key in PEM format has many lines. Passed on the command line as `-var key=$(secret)`, each line can appear in the log, because Azure Pipelines masks only the full value ([secrets](https://learn.microsoft.com/en-us/azure/devops/pipelines/security/secrets)). Pass such secrets as `TF_VAR_*` environment variables or as secure files, and rotate any secret that has leaked. Watch for a trailing newline, which can make Terraform see a changed value.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "multi-line-secrets-leak"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5135647937,
      "isDeleted": false,
      "id": "node-e0adfcc7d35a",
