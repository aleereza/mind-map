        "node_id": "each-job-starts-fresh"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3009246980,
      "isDeleted": false,
      "id": "text-5c8ecc0ddb03",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1160.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 84953,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Each Job Starts Fresh\nEach job of a pipeline can run on a different\nmachine. A saved plan file from the plan job\ntherefore does not exist in the apply job,\nunless the pipeline publishes it as an\nartifact and downloads it again. HashiCorp\ndescribes what that needs: the whole working\ndirectory, with the same files, at the same\npath ([running Terraform in automation](https:\n//developer.hashicorp.com/terraform/tutorials/\nautomation/automate-terraform)). Without it,\nthe apply job makes a new plan and applies\nthat one.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-5c8ecc0ddb03",
      "originalText": "Each Job Starts Fresh\nEach job of a pipeline can run on a different machine. A saved plan file from the plan job therefore does not exist in the apply job, unless the pipeline publishes it as an artifact and downloads it again. HashiCorp describes what that needs: the whole working directory, with the same files, at the same path ([running Terraform in automation](https://developer.hashicorp.com/terraform/tutorials/automation/automate-terraform)). Without it, the apply job makes a new plan and applies that one.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "each-job-starts-fresh"
      }
    },
    {
      "type": "rectangle",
