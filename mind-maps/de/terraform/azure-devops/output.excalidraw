    {
      "type": "text",
      "version": 1,
      "versionNonce": 4071610976,
      "isDeleted": false,
      "id": "text-c04f1cf96e0a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5466.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 105.0,
      "seed": 607635,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pin Terraform and Providers\nPin the Terraform version in the install step,\nand commit `.terraform.lock.hcl`. A pipeline\nthat installs `latest` can change behavior on\nany day without a code change. Pinning moves\nupgrades into reviewed pull requests.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-c04f1cf96e0a",
      "originalText": "Pin Terraform and Providers\nPin the Terraform version in the install step, and commit `.terraform.lock.hcl`. A pipeline that installs `latest` can change behavior on any day without a code change. Pinning moves upgrades into reviewed pull requests.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "azdo-pin-terraform"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5303280704,
      "isDeleted": false,
      "id": "node-81947e79dad6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
