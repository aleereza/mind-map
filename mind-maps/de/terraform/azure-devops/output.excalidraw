    {
      "type": "text",
      "version": 1,
      "versionNonce": 2790527233,
      "isDeleted": false,
      "id": "text-f84d79cdc868",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 380.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
