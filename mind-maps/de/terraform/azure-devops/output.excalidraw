    {
      "type": "text",
      "version": 1,
      "versionNonce": 7556571117,
      "isDeleted": false,
      "id": "text-d4f38375ca88",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1890.4,
      "y": 2728.5,
      "strokeColor": "#92400E",
