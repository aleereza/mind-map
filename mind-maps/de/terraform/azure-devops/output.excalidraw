      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading Pipelines and\nConfigurations\nThese nodes say where to look\nfirst in a pipeline that runs\nTerraform, and in a Terraform\nconfiguration that manages Azure\nDevOps.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-574f87ad914a",
      "originalText": "Reading Pipelines and Configurations\nThese nodes say where to look first in a pipeline that runs Terraform, and in a Terraform configuration that manages Azure DevOps.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-azdo"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 7409981962,
      "isDeleted": false,
      "id": "node-1bff65d7b6b4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1320.0,
      "y": 1936.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 56205,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
