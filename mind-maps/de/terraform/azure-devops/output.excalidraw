      "height": 140.0,
      "seed": 218085,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Gates That YAML Cannot Change\nPut the approval for production on the\nenvironment or the service connection, as a\ncheck. A pull request cannot remove such a\ncheck. A stage `condition` or a\n`ManualValidation` step lives in YAML, so a\npull request can change it. Pull request\nreview alone is the weakest gate.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-c39f15685009",
      "originalText": "Gates That YAML Cannot Change\nPut the approval for production on the environment or the service connection, as a check. A pull request cannot remove such a check. A stage `condition` or a `ManualValidation` step lives in YAML, so a pull request can change it. Pull request review alone is the weakest gate.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "gates-that-yaml-cannot-change"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6848339850,
      "isDeleted": false,
      "id": "node-dbe9f33faed7",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
