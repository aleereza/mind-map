    {
      "type": "text",
      "version": 1,
      "versionNonce": 7572535116,
      "isDeleted": false,
      "id": "text-e0adfcc7d35a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1890.4,
      "y": 3215.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 224114,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Locks and Waiting Runs\nWith `batch: true`, a new CI run waits until\nthe current run completes ([batching](https://\nlearn.microsoft.com/en-us/azure/devops/pipelin\nes/repos/azure-repos-git)). A run that waits\nfor an approval therefore holds back every\nlater merge. The YAML setting `lockBehavior`\nhas effect only together with an exclusive\nlock check on the resource ([exclusive lock](h\nttps://learn.microsoft.com/en-us/azure/devops/\npipelines/process/approvals)). Terraform's own\nstate lock is separate. A plan with\n`-lock=false` can read state while another run\nwrites it.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e0adfcc7d35a",
      "originalText": "Locks and Waiting Runs\nWith `batch: true`, a new CI run waits until the current run completes ([batching](https://learn.microsoft.com/en-us/azure/devops/pipelines/repos/azure-repos-git)). A run that waits for an approval therefore holds back every later merge. The YAML setting `lockBehavior` has effect only together with an exclusive lock check on the resource ([exclusive lock](https://learn.microsoft.com/en-us/azure/devops/pipelines/process/approvals)). Terraform's own state lock is separate. A plan with `-lock=false` can read state while another run writes it.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "locks-and-waiting-runs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3595674084,
      "isDeleted": false,
