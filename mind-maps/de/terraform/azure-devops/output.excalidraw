      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pipeline Pitfalls\nThese pitfalls affect every system that a\npipeline deploys.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7e78d3ba0aea",
      "originalText": "Pipeline Pitfalls\nThese pitfalls affect every system that a pipeline deploys.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "azdo-pipeline-pitfalls"
      }
    },
    {
      "type": "rectangle",
