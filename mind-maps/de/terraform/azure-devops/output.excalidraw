    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 7817864190,
      "isDeleted": false,
      "id": "text-aabae97ec57d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 736.0,
      "y": 3518.75,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 377.99999999999994,
      "height": 112.5,
      "seed": 960150,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pitfalls\nThe pitfalls fall into two groups:\nrunning Terraform in pipelines,\nand managing Azure DevOps with\nTerraform.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-aabae97ec57d",
      "originalText": "Pitfalls\nThe pitfalls fall into two groups: running Terraform in pipelines, and managing Azure DevOps with Terraform.",
