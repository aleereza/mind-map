      "updated": 1,
      "link": null,
      "locked": false,
      "text": "About the Sources\nThe provider facts come from the\n`microsoft/azuredevops` repository at tag v1.16.0,\nthe latest release on 2026-11-23. The task facts\ncome from the TerraformCLI task repository at tag\n1.2.2. The Azure Pipelines facts come from\nlearn.microsoft.com, and the Terraform facts from\ndeveloper.hashicorp.com, on the same day.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 16.25,
      "containerId": "node-81947e79dad6",
      "originalText": "About the Sources\nThe provider facts come from the `microsoft/azuredevops` repository at tag v1.16.0, the latest release on 2026-11-23. The task facts come from the TerraformCLI task repository at tag 1.2.2. The Azure Pipelines facts come from learn.microsoft.com, and the Terraform facts from developer.hashicorp.com, on the same day.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "azdo-about-the-sources"
