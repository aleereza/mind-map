    {
      "type": "text",
      "version": 1,
      "versionNonce": 7311181090,
      "isDeleted": false,
      "id": "text-d83ab5c3e784",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4710.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 83565,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Import What the UI Built\nMany dbt Cloud accounts start in the UI.\n`import` blocks adopt those objects without a\ndestroy, and `moved` blocks keep them safe\nduring refactors. dbt Labs offers the tool\n`dbtcloud-terraforming`, which writes both the\nconfiguration and the import blocks for an\naccount ([import guide](https://github.com/dbt\n-labs/terraform-provider-dbtcloud/blob/v1.13.1\n/docs/guides/3_importing_existing_configuratio\nn.md#L8-L10)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-d83ab5c3e784",
      "originalText": "Import What the UI Built\nMany dbt Cloud accounts start in the UI. `import` blocks adopt those objects without a destroy, and `moved` blocks keep them safe during refactors. dbt Labs offers the tool `dbtcloud-terraforming`, which writes both the configuration and the import blocks for an account ([import guide](https://github.com/dbt-labs/terraform-provider-dbtcloud/blob/v1.13.1/docs/guides/3_importing_existing_configuration.md#L8-L10)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "import-what-the-ui-built"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4961263051,
      "isDeleted": false,
      "id": "node-30d13a731c0e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
