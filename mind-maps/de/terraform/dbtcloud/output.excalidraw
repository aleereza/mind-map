    {
      "type": "text",
      "version": 1,
      "versionNonce": 9917543642,
      "isDeleted": false,
      "id": "text-521a2d4b4f29",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 900.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
