    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6139238667,
      "isDeleted": false,
      "id": "text-30d13a731c0e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4955.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 239049,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Key Pairs for Snowflake\ndbt Cloud no longer lets you create Snowflake\ncredentials with a user name and password. New\ncredentials default to key pairs, and dbt\nrecommends PKCS#8 keys ([connect Snowflake](ht\ntps://docs.getdbt.com/docs/platform/connect-da\nta-platform/connect-snowflake)). In Terraform,\npass the key from a secret file at run time,\nand use `private_key_wo` on Terraform 1.11 or\nlater, so the key stays out of the state. The\n[authentication map](../../authentication/auth\nentication.md#private-key-private-key)\nexplains key-pair sign-in.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-30d13a731c0e",
      "originalText": "Key Pairs for Snowflake\ndbt Cloud no longer lets you create Snowflake credentials with a user name and password. New credentials default to key pairs, and dbt recommends PKCS#8 keys ([connect Snowflake](https://docs.getdbt.com/docs/platform/connect-data-platform/connect-snowflake)). In Terraform, pass the key from a secret file at run time, and use `private_key_wo` on Terraform 1.11 or later, so the key stays out of the state. The [authentication map](../../authentication/authentication.md#private-key-private-key) explains key-pair sign-in.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "key-pairs-for-snowflake"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3640060202,
      "isDeleted": false,
      "id": "node-f5d19ca15e5c",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 5215.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 432318,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
