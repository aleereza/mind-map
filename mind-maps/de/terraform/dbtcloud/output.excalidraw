    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9334057028,
      "isDeleted": false,
      "id": "node-00c5156bac31",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
