      "angle": 0,
      "x": 1299.6,
      "y": 4023.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 378.0,
      "height": 52.5,
      "seed": 510532,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Job Setting Pitfalls\nThese pitfalls come from defaults that\ndiffer from the UI.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-659e27403167",
      "originalText": "Job Setting Pitfalls\nThese pitfalls come from defaults that differ from the UI.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbtcloud-job-setting-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1587265005,
      "isDeleted": false,
      "id": "node-6f4b8cc2e483",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1879.6,
      "y": 3679.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 590831,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
