    {
      "type": "text",
      "version": 1,
      "versionNonce": 3525814137,
      "isDeleted": false,
      "id": "text-6bb3db4f7fda",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1160.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
