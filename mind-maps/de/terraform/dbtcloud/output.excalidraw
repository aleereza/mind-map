    {
      "type": "text",
      "version": 1,
      "versionNonce": 6405271652,
      "isDeleted": false,
      "id": "text-56f75a338628",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6,
      "y": 3944.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 527886,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Jobs Started by the API\nA job with all triggers off runs only when\nsomething calls the API. The scheduler queues\nsuch runs, and it does not cancel\nover-scheduled runs that the API started ([job\nscheduler](https://docs.getdbt.com/docs/deploy\n/job-scheduler)). A slow job that a pipeline\ncalls every hour can therefore build a growing\nqueue. dbt also deactivates a job after 100\nfailed runs in a row. A successful call to\nstart a run says nothing about the result; the\ncaller must poll the run.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-56f75a338628",
      "originalText": "Jobs Started by the API\nA job with all triggers off runs only when something calls the API. The scheduler queues such runs, and it does not cancel over-scheduled runs that the API started ([job scheduler](https://docs.getdbt.com/docs/deploy/job-scheduler)). A slow job that a pipeline calls every hour can therefore build a growing queue. dbt also deactivates a job after 100 failed runs in a row. A successful call to start a run says nothing about the result; the caller must poll the run.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "jobs-started-by-api"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
