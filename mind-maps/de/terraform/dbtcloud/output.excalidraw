    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5867521271,
      "isDeleted": false,
      "id": "text-00c5156bac31",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4471.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 886664,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Who Schedules the Jobs\ndbt Cloud can start jobs on a schedule, on a\nmerge, or on a pull request. A team can\ninstead turn all triggers off and start jobs\nfrom its own orchestrator through the API. The\nsecond way gives one scheduler for all systems\nand quiet plans. Its costs: the dbt Cloud UI\nshows no schedule, runs can queue (see Jobs\nStarted by the API), and the orchestrator must\npoll each run for its result.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-00c5156bac31",
      "originalText": "Who Schedules the Jobs\ndbt Cloud can start jobs on a schedule, on a merge, or on a pull request. A team can instead turn all triggers off and start jobs from its own orchestrator through the API. The second way gives one scheduler for all systems and quiet plans. Its costs: the dbt Cloud UI shows no schedule, runs can queue (see Jobs Started by the API), and the orchestrator must poll each run for its result.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "who-schedules-the-jobs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9419078997,
      "isDeleted": false,
      "id": "node-d83ab5c3e784",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 4698.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 216.5,
      "seed": 945311,
      "groupIds": [],
