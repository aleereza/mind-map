    {
      "type": "text",
      "version": 1,
      "versionNonce": 7336338356,
      "isDeleted": false,
      "id": "text-70de4920c868",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 2212.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 29165,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "UI Edits Get Reverted\ndbt Cloud lets anyone with the right role edit\na job in the UI. When the job is in Terraform,\nthe next apply reverts that edit, with no\nwarning beyond the plan line. dbt Cloud keeps\nthe settings history of each job for 90 days,\nso you can see what changed ([deploy jobs](htt\nps://docs.getdbt.com/docs/deploy/deploy-jobs))\n. Make every change to a Terraform-managed job\nin code.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-70de4920c868",
      "originalText": "UI Edits Get Reverted\ndbt Cloud lets anyone with the right role edit a job in the UI. When the job is in Terraform, the next apply reverts that edit, with no warning beyond the plan line. dbt Cloud keeps the settings history of each job for 90 days, so you can see what changed ([deploy jobs](https://docs.getdbt.com/docs/deploy/deploy-jobs)). Make every change to a Terraform-managed job in code.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "ui-edits-get-reverted"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4295234200,
      "isDeleted": false,
      "id": "node-ea15b27ee859",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
