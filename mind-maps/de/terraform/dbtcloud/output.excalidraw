    {
      "type": "text",
      "version": 1,
      "versionNonce": 8674394330,
      "isDeleted": false,
      "id": "text-7831ee548d78",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1908.3999999999999,
      "y": 3231.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 259039,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Setting is_active to False Deletes the Job\n`is_active = false` sounds like a pause, but\nthe docs say it \"is the same as creating a job\nin a deleted state\" ([job doc](https://github.\ncom/dbt-labs/terraform-provider-dbtcloud/blob/\nv1.13.1/docs/resources/job.md#L230)). To pause\na job, set every trigger to `false` instead ([\ntriggers](https://github.com/dbt-labs/terrafor\nm-provider-dbtcloud/blob/v1.13.1/docs/resource\ns/job.md#L216)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7831ee548d78",
      "originalText": "Setting is_active to False Deletes the Job\n`is_active = false` sounds like a pause, but the docs say it \"is the same as creating a job in a deleted state\" ([job doc](https://github.com/dbt-labs/terraform-provider-dbtcloud/blob/v1.13.1/docs/resources/job.md#L230)). To pause a job, set every trigger to `false` instead ([triggers](https://github.com/dbt-labs/terraform-provider-dbtcloud/blob/v1.13.1/docs/resources/job.md#L216)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "is-active-false-deletes"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4548917174,
      "isDeleted": false,
      "id": "node-b1a587786eaa",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
