      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Replacement Pitfalls\nThese pitfalls delete jobs or change their\nIDs.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b1a97efbe5d2",
      "originalText": "Replacement Pitfalls\nThese pitfalls delete jobs or change their IDs.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbtcloud-replacement-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 4435657995,
      "isDeleted": false,
      "id": "node-f39b1dcc292e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1896.3999999999999,
      "y": 2959.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
