    {
      "type": "text",
      "version": 1,
      "versionNonce": 9444464654,
      "isDeleted": false,
      "id": "text-008afdcbaab5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1891.6,
      "y": 4199.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 587621,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Version Gap\nA constraint such as `~> 0.3` with no\ncommitted lock file stays on 0.3.26, the last\n0.x release. The Registry docs then describe a\ndifferent schema. An upgrade to 1.x needs\ncare: the first 1.x plans can show\n`connection_id` and `credential_id` changes\n([issue 429](https://github.com/dbt-labs/terra\nform-provider-dbtcloud/issues/429); [issue 519\n](https://github.com/dbt-labs/terraform-provid\ner-dbtcloud/issues/519)). Read the upgrade\nguide and the changelog, upgrade in one step\nto a recent 1.x version, and review the first\nplan line by line.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-008afdcbaab5",
      "originalText": "Version Gap\nA constraint such as `~> 0.3` with no committed lock file stays on 0.3.26, the last 0.x release. The Registry docs then describe a different schema. An upgrade to 1.x needs care: the first 1.x plans can show `connection_id` and `credential_id` changes ([issue 429](https://github.com/dbt-labs/terraform-provider-dbtcloud/issues/429); [issue 519](https://github.com/dbt-labs/terraform-provider-dbtcloud/issues/519)). Read the upgrade guide and the changelog, upgrade in one step to a recent 1.x version, and review the first plan line by line.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "version-gap"
      }
    },
