      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3761903149,
      "isDeleted": false,
      "id": "text-44ed3355e97a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 1680.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 525.0,
      "seed": 2664,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Where to Look First\nRead a dbt Cloud configuration in this order:\n\n1. `required_providers` and the lock file. A\n0.x pin means the Registry docs do not match;\nread the docs at the pinned tag.\n2. The `provider \"dbtcloud\"` block. Check\n`host_url` and where the token comes from.\n3. The backend and the workspaces. Find which\nenvironments share one state, because one plan\nthen touches all of them.\n4. `dbtcloud_project`, and the `import` and\n`moved` blocks. They show which objects were\nfirst made in the UI.\n5. The connection, or the data source that\nfinds it, and the `connection_id` of every\nenvironment.\n6. The environments: `type`,\n`deployment_type`, the credential wiring,\n`dbt_version` and the branch.\n7. The credentials: `auth_type`, the Snowflake\nnames, and where the private key comes from.\n8. The jobs: `execute_steps`, `target_name`,\n`triggers`, the schedule fields and\n`num_threads`.\n9. The environment variables, and which values\nare secret.\n10. The outputs and pipelines that use job\nIDs, and the Snowflake code that creates the\nnamed database, role and warehouse.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-44ed3355e97a",
      "originalText": "Where to Look First\nRead a dbt Cloud configuration in this order:\n\n1. `required_providers` and the lock file. A 0.x pin means the Registry docs do not match; read the docs at the pinned tag.\n2. The `provider \"dbtcloud\"` block. Check `host_url` and where the token comes from.\n3. The backend and the workspaces. Find which environments share one state, because one plan then touches all of them.\n4. `dbtcloud_project`, and the `import` and `moved` blocks. They show which objects were first made in the UI.\n5. The connection, or the data source that finds it, and the `connection_id` of every environment.\n6. The environments: `type`, `deployment_type`, the credential wiring, `dbt_version` and the branch.\n7. The credentials: `auth_type`, the Snowflake names, and where the private key comes from.\n8. The jobs: `execute_steps`, `target_name`, `triggers`, the schedule fields and `num_threads`.\n9. The environment variables, and which values are secret.\n10. The outputs and pipelines that use job IDs, and the Snowflake code that creates the named database, role and warehouse.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbtcloud-where-to-look-first"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2299779813,
      "isDeleted": false,
      "id": "node-973a743f8fb2",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 1940.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 978755,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
