      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8215231943,
      "isDeleted": false,
      "id": "text-973a743f8fb2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 1940.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 350.0,
      "seed": 852052,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| `~ triggers` or `~ schedule_*` on a job\nwithout a code change | Someone changed the\njob in the UI; the apply will revert it. |\n| `-/+ dbtcloud_environment` | The environment\nis replaced; dbt deletes its jobs with it. |\n| `-/+ dbtcloud_job ... triggers` | The job\nchanges type between CI, merge and other jobs;\nit gets a new ID. |\n| `+ credential_id = (known after apply)`\nright after an upgrade to 1.x | The new\nversion stores empty values as null instead of\n0 ([issue 519](https://github.com/dbt-labs/ter\nraform-provider-dbtcloud/issues/519)). |\n| `target_name = \"default\"` on a new job | The\njob uses the provider default; models that\ncheck `target.name` may skip production logic.\n|",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-973a743f8fb2",
      "originalText": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| `~ triggers` or `~ schedule_*` on a job without a code change | Someone changed the job in the UI; the apply will revert it. |\n| `-/+ dbtcloud_environment` | The environment is replaced; dbt deletes its jobs with it. |\n| `-/+ dbtcloud_job ... triggers` | The job changes type between CI, merge and other jobs; it gets a new ID. |\n| `+ credential_id = (known after apply)` right after an upgrade to 1.x | The new version stores empty values as null instead of 0 ([issue 519](https://github.com/dbt-labs/terraform-provider-dbtcloud/issues/519)). |\n| `target_name = \"default\"` on a new job | The job uses the provider default; models that check `target.name` may skip production logic. |",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dbtcloud-plan-signals"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3253079972,
      "isDeleted": false,
      "id": "node-6ccc9fa4f6d6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 720.0,
      "y": 3248.75,
      "strokeColor": "#0F172A",
      "backgroundColor": "#DBEAFE",
      "width": 377.59999999999997,
      "height": 122.0,
      "seed": 994260,
      "groupIds": [],
      "frameId": null,
