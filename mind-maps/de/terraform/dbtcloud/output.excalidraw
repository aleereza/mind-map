      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 8965257146,
      "isDeleted": false,
      "id": "text-f5d19ca15e5c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5215.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 297.5,
      "seed": 138100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Leave Some Objects Out\nNot every dbt Cloud object belongs in\nTerraform. Two examples:\n\n- Any change to a service token replaces it,\nbecause the API does not allow changes to an\nexisting token. The new token has a new secret\n([changelog](https://github.com/dbt-labs/terra\nform-provider-dbtcloud/blob/v0.3.26/CHANGELOG.\nmd#L17)).\n- `dbtcloud_user_groups` removes groups that\npeople add by hand (see Authoritative Group\nLists).\n\nObjects that people change often, or whose\nreplacement breaks callers, can stay in the\nUI. Write down which objects Terraform owns.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-f5d19ca15e5c",
      "originalText": "Leave Some Objects Out\nNot every dbt Cloud object belongs in Terraform. Two examples:\n\n- Any change to a service token replaces it, because the API does not allow changes to an existing token. The new token has a new secret ([changelog](https://github.com/dbt-labs/terraform-provider-dbtcloud/blob/v0.3.26/CHANGELOG.md#L17)).\n- `dbtcloud_user_groups` removes groups that people add by hand (see Authoritative Group Lists).\n\nObjects that people change often, or whose replacement breaks callers, can stay in the UI. Write down which objects Terraform owns.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "leave-some-objects-out"
      }
    },
