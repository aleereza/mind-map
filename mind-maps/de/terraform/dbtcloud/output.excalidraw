    {
      "type": "text",
      "version": 1,
      "versionNonce": 9819701773,
      "isDeleted": false,
      "id": "text-659e27403167",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
