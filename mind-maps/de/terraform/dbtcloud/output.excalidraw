      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading a dbt Cloud Configuration\nThese nodes say what you will find\nin the files, in which order to\nread them, and what each kind of\nplan line means.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-e2aa47ddcda1",
      "originalText": "Reading a dbt Cloud Configuration\nThese nodes say what you will find in the files, in which order to read them, and what each kind of plan line means.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-dbtcloud-configuration"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2107661761,
      "isDeleted": false,
      "id": "node-645fbdca96ef",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
