    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6498090428,
      "isDeleted": false,
      "id": "text-f39b1dcc292e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1908.3999999999999,
      "y": 2959.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 800530,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Replacements Delete Jobs\ndbt deletes an environment's jobs together\nwith the environment ([delete an environment](\nhttps://docs.getdbt.com/faqs/Environments/dele\nte-environment-job)). So a plan that replaces\nan environment, for example after a change of\n`type`, also takes its jobs with it. A job\nalso gets a new ID when its triggers move it\nbetween kinds: CI, merge, or other ([job code]\n(https://github.com/dbt-labs/terraform-provide\nr-dbtcloud/blob/v1.13.1/pkg/framework/objects/\njob/resource.go#L128-L157)). Any pipeline or\nservice that starts the job by ID then calls a\njob that no longer exists.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-f39b1dcc292e",
      "originalText": "Replacements Delete Jobs\ndbt deletes an environment's jobs together with the environment ([delete an environment](https://docs.getdbt.com/faqs/Environments/delete-environment-job)). So a plan that replaces an environment, for example after a change of `type`, also takes its jobs with it. A job also gets a new ID when its triggers move it between kinds: CI, merge, or other ([job code](https://github.com/dbt-labs/terraform-provider-dbtcloud/blob/v1.13.1/pkg/framework/objects/job/resource.go#L128-L157)). Any pipeline or service that starts the job by ID then calls a job that no longer exists.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "replacements-delete-jobs"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1408297791,
      "isDeleted": false,
      "id": "node-7831ee548d78",
