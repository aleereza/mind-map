      "angle": 0,
      "x": 1288.8,
      "y": 120.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 490.0,
      "seed": 931502,
      "groupIds": [],
