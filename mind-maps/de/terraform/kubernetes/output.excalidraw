    {
      "type": "text",
      "version": 1,
      "versionNonce": 9842661473,
      "isDeleted": false,
      "id": "text-d1da763b6653",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 2460.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
