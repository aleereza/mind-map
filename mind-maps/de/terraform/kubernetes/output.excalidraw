    {
      "type": "text",
      "version": 1,
      "versionNonce": 4262312377,
      "isDeleted": false,
      "id": "text-1d77f3ed09aa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
