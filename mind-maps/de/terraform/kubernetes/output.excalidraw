    {
      "type": "text",
      "version": 1,
      "versionNonce": 7121145485,
      "isDeleted": false,
      "id": "text-e55d6da0359e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 645.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 522386,
      "groupIds": [],
