    {
      "type": "text",
      "version": 1,
      "versionNonce": 7415546471,
      "isDeleted": false,
      "id": "text-974076f4a89a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6214.5,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 122.5,
      "seed": 908525,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Atomic Releases with Real Timeouts\n`atomic = true` with a realistic `timeout`\nrolls a failed install back and reports the\nfailure. `wait = false` makes applies shorter,\nbut it reports broken releases as successes.\nPrefer the first for anything that other\nsystems depend on.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-974076f4a89a",
      "originalText": "Atomic Releases with Real Timeouts\n`atomic = true` with a realistic `timeout` rolls a failed install back and reports the failure. `wait = false` makes applies shorter, but it reports broken releases as successes. Prefer the first for anything that other systems depend on.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "atomic-releases"
      }
    },
