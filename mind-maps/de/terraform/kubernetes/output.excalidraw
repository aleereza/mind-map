      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6912712602,
      "isDeleted": false,
      "id": "text-09bcb6211502",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1883.1999999999998,
      "y": 4988.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 458206,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "NetworkPolicies Need an Enforcer\nA NetworkPolicy object has no effect unless\nthe cluster's network plugin enforces it\n([network policies](https://kubernetes.io/docs\n/concepts/services-networking/network-policies\n/)). On EKS, the VPC CNI plugin enforces\npolicies only when its `enableNetworkPolicy`\nsetting is on ([configure network policy](http\ns://docs.aws.amazon.com/eks/latest/userguide/c\nni-network-policy-configure.html)). Without\nit, Terraform creates the policies, the plan\nis clean, and all traffic still flows.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-09bcb6211502",
      "originalText": "NetworkPolicies Need an Enforcer\nA NetworkPolicy object has no effect unless the cluster's network plugin enforces it ([network policies](https://kubernetes.io/docs/concepts/services-networking/network-policies/)). On EKS, the VPC CNI plugin enforces policies only when its `enableNetworkPolicy` setting is on ([configure network policy](https://docs.aws.amazon.com/eks/latest/userguide/cni-network-policy-configure.html)). Without it, Terraform creates the policies, the plan is clean, and all traffic still flows.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "networkpolicies-need-an-enforcer"
      }
    },
    {
