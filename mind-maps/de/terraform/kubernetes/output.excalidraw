    {
      "type": "text",
      "version": 1,
      "versionNonce": 1549651093,
      "isDeleted": false,
      "id": "text-6c28b148d57e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1883.1999999999998,
      "y": 4463.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
