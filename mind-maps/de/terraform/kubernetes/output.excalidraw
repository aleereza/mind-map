      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6145588755,
      "isDeleted": false,
      "id": "text-e854fa88b6cc",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1849.6,
      "y": 3500.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 435757,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Secrets in Helm Values\nHelm values are part of the release resource.\nA secret written into `values`, for example a\nwebhook URL, can print in clear text in a plan\nwhen the release changes or is destroyed. Only\nvalues passed through `set_sensitive` stay\nhidden ([issue 1287](https://github.com/hashic\norp/terraform-provider-helm/issues/1287)). The\nopposite problem also happens: when a values\ntemplate reads one sensitive variable, the\nwhole values text becomes sensitive, and\nreviewers see no diff at all. Pass secrets\nthrough `set_sensitive` or the write-only\n`set_wo`, or let an operator read them from a\nsecret store at run time.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e854fa88b6cc",
      "originalText": "Secrets in Helm Values\nHelm values are part of the release resource. A secret written into `values`, for example a webhook URL, can print in clear text in a plan when the release changes or is destroyed. Only values passed through `set_sensitive` stay hidden ([issue 1287](https://github.com/hashicorp/terraform-provider-helm/issues/1287)). The opposite problem also happens: when a values template reads one sensitive variable, the whole values text becomes sensitive, and reviewers see no diff at all. Pass secrets through `set_sensitive` or the write-only `set_wo`, or let an operator read them from a secret store at run time.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "secrets-in-helm-values"
      }
    },
    {
      "type": "rectangle",
