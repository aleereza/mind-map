      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading a Kubernetes Configuration\nThese nodes say what you will find\nin the files, in which order to\nread them, and what each kind of\nplan line means.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-a7d1bcdfc030",
      "originalText": "Reading a Kubernetes Configuration\nThese nodes say what you will find in the files, in which order to read them, and what each kind of plan line means.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-k8s-configuration"
      }
    },
    {
      "type": "rectangle",
