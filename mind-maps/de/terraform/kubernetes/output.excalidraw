      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cluster Pitfalls\nThese pitfalls concern objects, identity and\nversions of the cluster.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-22620ef4790e",
      "originalText": "Cluster Pitfalls\nThese pitfalls concern objects, identity and versions of the cluster.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
