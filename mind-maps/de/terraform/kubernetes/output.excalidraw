      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Mental Models\nThe models come in dependency\norder: each model uses only\nthe models before it.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-f9dbe06b797a",
      "originalText": "Mental Models\nThe models come in dependency order: each model uses only the models before it.",
