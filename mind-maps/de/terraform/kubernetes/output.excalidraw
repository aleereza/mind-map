      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Helm Pitfalls\nThese pitfalls come from the gap\nbetween Terraform and Helm.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-064bfcb583f3",
