    {
      "type": "text",
      "version": 1,
      "versionNonce": 7856415469,
      "isDeleted": false,
      "id": "text-e00cd90be692",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1900.0,
      "y": 2720.0,
