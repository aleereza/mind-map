      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-48dc46994aeb",
      "originalText": "Pitfalls\nThe pitfalls fall into three groups: bootstrap, Helm, and the cluster.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "k8s-pitfalls"
      }
