      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Bootstrap Pitfalls\nThese pitfalls appear when a cluster is new or\nreplaced.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-23b1e5b4cd4c",
      "originalText": "Bootstrap Pitfalls\nThese pitfalls appear when a cluster is new or replaced.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "k8s-bootstrap-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2677449015,
      "isDeleted": false,
      "id": "node-d1da763b6653",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
