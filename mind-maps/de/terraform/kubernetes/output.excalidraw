      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 4576780992,
      "isDeleted": false,
      "id": "text-1b461f2ac71e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5467.75,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 175.0,
      "seed": 307751,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Fresh Tokens with exec\nAn `exec` block fetches a new token for each\nrun, so a long apply does not fail when a\ntoken expires, and no token lands in the\nstate. The provider docs forbid mixing `exec`\nwith other credential settings ([exec plugins]\n(https://github.com/hashicorp/terraform-provid\ner-kubernetes/blob/v3.5.0/docs/index.md#L112))\n. The cost is the AWS command-line tool on\nevery runner.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-1b461f2ac71e",
      "originalText": "Fresh Tokens with exec\nAn `exec` block fetches a new token for each run, so a long apply does not fail when a token expires, and no token lands in the state. The provider docs forbid mixing `exec` with other credential settings ([exec plugins](https://github.com/hashicorp/terraform-provider-kubernetes/blob/v3.5.0/docs/index.md#L112)). The cost is the AWS command-line tool on every runner.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "fresh-tokens-with-exec"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1326406285,
      "isDeleted": false,
      "id": "node-349fae491434",
      "fillStyle": "solid",
