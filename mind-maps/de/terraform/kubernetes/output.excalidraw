    {
      "type": "text",
      "version": 1,
      "versionNonce": 4588806540,
      "isDeleted": false,
      "id": "text-64b2e050d1ba",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1849.6,
      "y": 2985.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 49077,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Helm Does Not Upgrade CRDs\nA chart upgrade that brings new CRD versions\nin its `crds` folder installs the new chart,\nbut the old CRDs stay. New fields of the\ncustom resources then fail. The plan shows\nonly a new `version`. Each chart documents its\nown way to upgrade CRDs, for example with\n`kubectl apply` of the chart's CRD files.\nCharts that render their CRDs as normal\ntemplates do upgrade them, but they can also\ndelete them when the release is removed, which\ndeletes every custom resource of that kind.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-64b2e050d1ba",
      "originalText": "Helm Does Not Upgrade CRDs\nA chart upgrade that brings new CRD versions in its `crds` folder installs the new chart, but the old CRDs stay. New fields of the custom resources then fail. The plan shows only a new `version`. Each chart documents its own way to upgrade CRDs, for example with `kubectl apply` of the chart's CRD files. Charts that render their CRDs as normal templates do upgrade them, but they can also delete them when the release is removed, which deletes every custom resource of that kind.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "helm-does-not-upgrade-crds"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6981612619,
      "isDeleted": false,
      "id": "node-c7bdd57d18b1",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1837.6,
      "y": 3240.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 405365,
      "groupIds": [],
