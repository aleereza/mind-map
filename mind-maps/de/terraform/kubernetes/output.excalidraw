    {
      "type": "text",
      "version": 1,
      "versionNonce": 3554350425,
      "isDeleted": false,
      "id": "text-349fae491434",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5698.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 327929,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pin Every Version Axis\nA cluster has many versions that move on their\nown: the control plane, the node image, the\nadd-ons, the charts, the CRDs, the container\nimages and the providers. Without `version`,\n`helm_release` installs the latest chart\n([release doc](https://github.com/hashicorp/te\nrraform-provider-helm/blob/v3.3.0/docs/resourc\nes/release.md#L63)). Pin each axis, commit the\nlock file, and raise each pin in its own\nreviewed change.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-349fae491434",
      "originalText": "Pin Every Version Axis\nA cluster has many versions that move on their own: the control plane, the node image, the add-ons, the charts, the CRDs, the container images and the providers. Without `version`, `helm_release` installs the latest chart ([release doc](https://github.com/hashicorp/terraform-provider-helm/blob/v3.3.0/docs/resources/release.md#L63)). Pin each axis, commit the lock file, and raise each pin in its own reviewed change.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "pin-every-version-axis"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
