    {
      "type": "text",
      "version": 1,
      "versionNonce": 1227629360,
      "isDeleted": false,
      "id": "text-f740d3cd1c67",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 5320.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 682.5,
      "seed": 490555,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
