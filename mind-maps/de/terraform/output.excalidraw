    {
      "type": "text",
      "version": 1,
      "versionNonce": 2012622834,
      "isDeleted": false,
      "id": "text-918b95bd5e1c",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1919.2,
      "y": 3500.0,
      "strokeColor": "#92400E",
