      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading a Terraform Repo\nA repo can hold many\nconfigurations. These nodes say\nwhich file names matter, how to\nfind each configuration, how repos\nare laid out, and in which order\nto read.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-8a6143e51b8a",
      "originalText": "Reading a Terraform Repo\nA repo can hold many configurations. These nodes say which file names matter, how to find each configuration, how repos are laid out, and in which order to read.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-a-terraform-repo"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2958761453,
      "isDeleted": false,
      "id": "node-9640580c8c78",
