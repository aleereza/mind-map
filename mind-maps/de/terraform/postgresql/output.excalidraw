    {
      "type": "text",
      "version": 1,
      "versionNonce": 2822794700,
      "isDeleted": false,
      "id": "text-1397921802f5",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1420.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 245.0,
      "seed": 611485,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "The RDS Admin Is Not a Superuser\nOn Amazon RDS, the master user is a member of\nthe role `rds_superuser`, but it is not a real\nsuperuser ([RDS roles](https://docs.aws.amazon\n.com/AmazonRDS/latest/UserGuide/Appendix.Postg\nreSQL.CommonDBATasks.Roles.rds_superuser.html)\n). The provider must know this: set `superuser\n= false`. Then some features are off; for\nexample, the provider cannot read a role's\npassword back from the database ([provider doc\ns](https://github.com/cyrilgdn/terraform-provi\nder-postgresql/blob/v1.27.0/website/docs/index\n.html.markdown#L155-L156)). A password changed\noutside Terraform then never shows in a plan.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-1397921802f5",
      "originalText": "The RDS Admin Is Not a Superuser\nOn Amazon RDS, the master user is a member of the role `rds_superuser`, but it is not a real superuser ([RDS roles](https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/Appendix.PostgreSQL.CommonDBATasks.Roles.rds_superuser.html)). The provider must know this: set `superuser = false`. Then some features are off; for example, the provider cannot read a role's password back from the database ([provider docs](https://github.com/cyrilgdn/terraform-provider-postgresql/blob/v1.27.0/website/docs/index.html.markdown#L155-L156)). A password changed outside Terraform then never shows in a plan.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "the-rds-admin-is-not-a-superuser"
      }
    },
