      "versionNonce": 5823212251,
      "isDeleted": false,
      "id": "node-ab4e0bab5b80",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
