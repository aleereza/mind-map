    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1241554709,
      "isDeleted": false,
      "id": "node-06ddc8c7d87f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1852.0,
      "y": 3662.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 137824,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
