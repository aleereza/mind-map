    {
      "type": "text",
      "version": 1,
      "versionNonce": 9300449735,
      "isDeleted": false,
      "id": "text-ab4e0bab5b80",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 640.0,
      "strokeColor": "#1E3A8A",
