      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2307099516,
      "isDeleted": false,
      "id": "text-06ddc8c7d87f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1864.0,
      "y": 3662.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 754108,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Dropping a Role That Owns Objects\nWhen a `postgresql_role` leaves the\nconfiguration, the provider runs `REASSIGN\nOWNED` and `DROP OWNED` before `DROP ROLE`\n([role doc](https://github.com/cyrilgdn/terraf\norm-provider-postgresql/blob/v1.27.0/website/d\nocs/r/postgresql_role.html.markdown#L14-L22)).\nIt does this only in the provider's database.\nIf the role owns objects in another database,\n`DROP ROLE` fails. A rename of the role is an\nin-place `ALTER ROLE ... RENAME`. A new\nresource address without a `moved` block,\nhowever, plans a drop and a create.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-06ddc8c7d87f",
      "originalText": "Dropping a Role That Owns Objects\nWhen a `postgresql_role` leaves the configuration, the provider runs `REASSIGN OWNED` and `DROP OWNED` before `DROP ROLE` ([role doc](https://github.com/cyrilgdn/terraform-provider-postgresql/blob/v1.27.0/website/docs/r/postgresql_role.html.markdown#L14-L22)). It does this only in the provider's database. If the role owns objects in another database, `DROP ROLE` fails. A rename of the role is an in-place `ALTER ROLE ... RENAME`. A new resource address without a `moved` block, however, plans a drop and a create.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "dropping-a-role-that-owns-objects"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9115615107,
      "isDeleted": false,
      "id": "node-9574e61fb294",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1852.0,
      "y": 3922.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 903325,
      "groupIds": [],
      "frameId": null,
