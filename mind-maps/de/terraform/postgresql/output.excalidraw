      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Connection Pitfalls\nThese pitfalls stop the plan or point it at\nthe wrong server.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-2c67391abf22",
      "originalText": "Connection Pitfalls\nThese pitfalls stop the plan or point it at the wrong server.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "pg-connection-pitfalls"
      }
    },
    {
      "type": "rectangle",
