      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 4887042983,
      "isDeleted": false,
      "id": "text-d2ca72066928",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 2200.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 251909,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| The plan fails before any diff with `error\ndetecting capabilities` or a timeout | The\nrunner cannot reach the server, or the login\nfails. |\n| `~ privileges` on a table grant with no code\nchange | New tables appeared; the apply will\nrun `REVOKE ALL` and grant again. |\n| `-` or `-/+` on `postgresql_database` | The\ndatabase will be dropped, with its data. |\n| `-` on `postgresql_role` | The role's\nobjects will be reassigned and dropped in the\ndefault database first. |",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-d2ca72066928",
      "originalText": "Plan Signals\n| Line in the plan | Meaning |\n| --- | --- |\n| The plan fails before any diff with `error detecting capabilities` or a timeout | The runner cannot reach the server, or the login fails. |\n| `~ privileges` on a table grant with no code change | New tables appeared; the apply will run `REVOKE ALL` and grant again. |\n| `-` or `-/+` on `postgresql_database` | The database will be dropped, with its data. |\n| `-` on `postgresql_role` | The role's objects will be reassigned and dropped in the default database first. |",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "pg-plan-signals"
      }
    },
