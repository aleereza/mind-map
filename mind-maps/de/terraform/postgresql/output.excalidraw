    {
      "type": "text",
      "version": 1,
      "versionNonce": 5230239019,
      "isDeleted": false,
      "id": "text-9574e61fb294",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1864.0,
      "y": 3922.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 727343,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Destroying a Database Forces Disconnects\nA destroy of `postgresql_database` terminates\nthe open connections and then runs `DROP\nDATABASE ... WITH (FORCE)` on PostgreSQL 13\nand later ([database code](https://github.com/\ncyrilgdn/terraform-provider-postgresql/blob/v1\n.27.0/postgresql/resource_postgresql_database.\ngo#L240-L290)). A drop cannot be undone ([DROP\nDATABASE](https://www.postgresql.org/docs/curr\nent/sql-dropdatabase.html)). A change of\n`template`, `encoding`, `lc_collate` or\n`lc_ctype` also replaces the database. Add\n`prevent_destroy` to every database with data.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-9574e61fb294",
      "originalText": "Destroying a Database Forces Disconnects\nA destroy of `postgresql_database` terminates the open connections and then runs `DROP DATABASE ... WITH (FORCE)` on PostgreSQL 13 and later ([database code](https://github.com/cyrilgdn/terraform-provider-postgresql/blob/v1.27.0/postgresql/resource_postgresql_database.go#L240-L290)). A drop cannot be undone ([DROP DATABASE](https://www.postgresql.org/docs/current/sql-dropdatabase.html)). A change of `template`, `encoding`, `lc_collate` or `lc_ctype` also replaces the database. Add `prevent_destroy` to every database with data.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "destroying-a-database-forces-disconnects"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
