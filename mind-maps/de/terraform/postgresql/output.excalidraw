    {
      "type": "text",
      "version": 1,
      "versionNonce": 4099084902,
      "isDeleted": false,
      "id": "text-3c425d83ede3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 730.0,
      "y": 5429.0,
      "strokeColor": "#57534E",
      "backgroundColor": "transparent",
      "width": 397.8,
      "height": 113.75,
      "seed": 691998,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "About the Sources\nThe provider facts come from the\n`cyrilgdn/postgresql` repository at tag v1.27.0,\nthe latest release on 2026-11-23. The PostgreSQL\nfacts come from postgresql.org/docs/current, and\nthe RDS facts from docs.aws.amazon.com, on the same\nday.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 16.25,
      "containerId": "node-3c425d83ede3",
      "originalText": "About the Sources\nThe provider facts come from the `cyrilgdn/postgresql` repository at tag v1.27.0, the latest release on 2026-11-23. The PostgreSQL facts come from postgresql.org/docs/current, and the RDS facts from docs.aws.amazon.com, on the same day.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "pg-about-the-sources"
      }
    },
