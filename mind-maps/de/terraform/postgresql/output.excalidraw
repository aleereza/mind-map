      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 6522937630,
      "isDeleted": false,
      "id": "text-70f5cec87d8a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1864.0,
      "y": 3145.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 262.5,
      "seed": 464211,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Owner Table Grant Drifts\nSome configurations grant table privileges to\nthe role that also owns the tables, while the\napp's migrations create new tables after each\napply. New tables have no explicit access\nlist, so the next refresh shows the privileges\nas missing, and the plan shows `~ privileges`\nwith no code change. The apply then runs\n`REVOKE ALL` and grants the listed privileges\nagain. If the list lacks `TRUNCATE`, the owner\nloses `TRUNCATE` on its existing tables\n([issue 627](https://github.com/cyrilgdn/terra\nform-provider-postgresql/issues/627)). Do not\ngrant table privileges to the owner: it\nalready has them.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-70f5cec87d8a",
      "originalText": "Owner Table Grant Drifts\nSome configurations grant table privileges to the role that also owns the tables, while the app's migrations create new tables after each apply. New tables have no explicit access list, so the next refresh shows the privileges as missing, and the plan shows `~ privileges` with no code change. The apply then runs `REVOKE ALL` and grants the listed privileges again. If the list lacks `TRUNCATE`, the owner loses `TRUNCATE` on its existing tables ([issue 627](https://github.com/cyrilgdn/terraform-provider-postgresql/issues/627)). Do not grant table privileges to the owner: it already has them.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "owner-table-grant-drifts"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 2162145062,
      "isDeleted": false,
      "id": "node-d82fa53cd5d8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1852.0,
      "y": 3405.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 410.40000000000003,
      "height": 216.5,
      "seed": 983835,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
