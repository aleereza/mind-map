        "node_id": "separate-migration-and-reader-roles"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 9772759224,
      "isDeleted": false,
      "id": "text-fe5108ef8d5f",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4714.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 140.0,
      "seed": 629974,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Separate Migration and Reader Roles\nThe role that runs migrations creates the\ntables, so it owns them. A reader role gets a\ngrant on the tables that exist and a\ndefault-privileges rule `FOR ROLE <migration\nrole>` for the tables to come. This pair\ncovers past and future tables, and nothing in\nit drifts when migrations add tables.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-fe5108ef8d5f",
      "originalText": "Separate Migration and Reader Roles\nThe role that runs migrations creates the tables, so it owns them. A reader role gets a grant on the tables that exist and a default-privileges rule `FOR ROLE <migration role>` for the tables to come. This pair covers past and future tables, and nothing in it drifts when migrations add tables.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "separate-migration-and-reader-roles"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6035887388,
      "isDeleted": false,
      "id": "node-9e4ceb4e5867",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 4906.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 216.5,
      "seed": 18503,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-9e4ceb4e5867"
        },
        {
          "id": "edge-0627984a06f4",
          "type": "arrow"
        }
      ],
      "updated": 1,
      "link": null,
      "locked": false,
      "customData": {
        "node_id": "reach-the-database-privately"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 5405695516,
      "isDeleted": false,
      "id": "text-9e4ceb4e5867",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4918.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 53656,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reach the Database Privately\nA public database endpoint with an allowlist\nfor the runner's address is quick to set up,\nbut it exposes the server to the internet. A\nrunner inside the private network, or a proxy,\nkeeps port 5432 private. With `sslmode =\n\"verify-full\"`, the provider also checks that\nit talks to the right server ([provider settin\ngs](https://github.com/cyrilgdn/terraform-prov\nider-postgresql/blob/v1.27.0/website/docs/inde\nx.html.markdown#L157-L163)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-9e4ceb4e5867",
      "originalText": "Reach the Database Privately\nA public database endpoint with an allowlist for the runner's address is quick to set up, but it exposes the server to the internet. A runner inside the private network, or a proxy, keeps port 5432 private. With `sslmode = \"verify-full\"`, the provider also checks that it talks to the right server ([provider settings](https://github.com/cyrilgdn/terraform-provider-postgresql/blob/v1.27.0/website/docs/index.html.markdown#L157-L163)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
