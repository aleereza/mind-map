    {
      "type": "text",
      "version": 1,
      "versionNonce": 7793542106,
      "isDeleted": false,
      "id": "text-bf02960694aa",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 736.0,
      "y": 1993.75,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 367.2,
      "height": 112.5,
      "seed": 798007,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Reading a PostgreSQL Configuration\nThese nodes say what you will find\nin the files, in which order to\nread them, and what each kind of\nplan line means.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-bf02960694aa",
      "originalText": "Reading a PostgreSQL Configuration\nThese nodes say what you will find in the files, in which order to read them, and what each kind of plan line means.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "reading-pg-configuration"
      }
    },
    {
      "type": "rectangle",
