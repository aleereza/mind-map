    {
      "type": "text",
      "version": 1,
      "versionNonce": 5928486833,
      "isDeleted": false,
      "id": "text-d761dc3f3345",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1864.0,
      "y": 2953.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 386.40000000000003,
      "height": 140.0,
      "seed": 920310,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A Grant Takes the Whole Set\nTwo `postgresql_grant` resources on the same\ncombination of role, database, schema and\nobject type revoke each other's privileges at\neach update. A grant made by hand on that\ncombination disappears the same way. Give each\ncombination exactly one resource, with every\nprivilege it needs.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-d761dc3f3345",
      "originalText": "A Grant Takes the Whole Set\nTwo `postgresql_grant` resources on the same combination of role, database, schema and object type revoke each other's privileges at each update. A grant made by hand on that combination disappears the same way. Give each combination exactly one resource, with every privilege it needs.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "grant-takes-the-whole-set"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 9025460575,
      "isDeleted": false,
      "id": "node-70f5cec87d8a",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1852.0,
      "y": 3145.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 132973,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
