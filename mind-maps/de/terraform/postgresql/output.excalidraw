      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2320770242,
      "isDeleted": false,
      "id": "text-14bd258fde97",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 4447.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 612885,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "One Login Role per App\nGive each app its own login role, and let that\nrole own the app's database. The predefined\nrole `pg_database_owner` owns the `public`\nschema, so each database owner governs that\nschema ([predefined roles](https://www.postgre\nsql.org/docs/current/predefined-roles.html)).\nDashboards and other readers then get their\nown roles with only `SELECT`. Sharing the RDS\nmaster user between apps and dashboards is\nsimpler, but one leaked password then opens\nevery database on the instance.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-14bd258fde97",
      "originalText": "One Login Role per App\nGive each app its own login role, and let that role own the app's database. The predefined role `pg_database_owner` owns the `public` schema, so each database owner governs that schema ([predefined roles](https://www.postgresql.org/docs/current/predefined-roles.html)). Dashboards and other readers then get their own roles with only `SELECT`. Sharing the RDS master user between apps and dashboards is simpler, but one leaked password then opens every database on the instance.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "one-login-role-per-app"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5406074386,
      "isDeleted": false,
      "id": "node-fe5108ef8d5f",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 4702.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 164.0,
      "seed": 435288,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
        "value": 8
      },
      "boundElements": [
        {
          "type": "text",
          "id": "text-fe5108ef8d5f"
        },
        {
          "id": "edge-4574cd46e31c",
          "type": "arrow"
        }
      ],
      "updated": 1,
      "link": null,
