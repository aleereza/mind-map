    {
      "type": "text",
      "version": 1,
      "versionNonce": 4316719663,
      "isDeleted": false,
      "id": "text-24e3175b7ce8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6093.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 227.5,
      "seed": 731351,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Native Resources Before Raw SQL\nA native resource reads the object back, shows\ndrift and changes it in place.\n`snowflake_execute` does none of this. Use it\nonly where no resource exists, such as for a\ncatalog-linked database today. Catalog\nintegrations have stable resources since\n2.18.0 ([migration guide](https://github.com/s\nnowflakedb/terraform-provider-snowflake/blob/v\n2.23.0/MIGRATION_GUIDE.md#L2173)). Moving a\ncatalog integration out of `snowflake_execute`\nremoves the drop-and-recreate on each secret\nchange.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-24e3175b7ce8",
      "originalText": "Native Resources Before Raw SQL\nA native resource reads the object back, shows drift and changes it in place. `snowflake_execute` does none of this. Use it only where no resource exists, such as for a catalog-linked database today. Catalog integrations have stable resources since 2.18.0 ([migration guide](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/MIGRATION_GUIDE.md#L2173)). Moving a catalog integration out of `snowflake_execute` removes the drop-and-recreate on each secret change.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "native-before-raw-sql"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1280424369,
      "isDeleted": false,
      "id": "node-e55b244d060d",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 6353.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
      "width": 418.8,
      "height": 220.0,
      "seed": 943531,
      "groupIds": [],
