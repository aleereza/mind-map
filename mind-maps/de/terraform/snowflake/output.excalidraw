    {
      "type": "text",
      "version": 1,
      "versionNonce": 1731072634,
      "isDeleted": false,
      "id": "text-3270c298ada2",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1882.0,
      "y": 4793.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 297.5,
      "seed": 718702,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "External Volumes Freeze\nSnowflake refuses to drop or replace an\nexternal volume while Iceberg tables use it\n([DROP EXTERNAL VOLUME](https://docs.snowflake\n.com/en/sql-reference/sql/drop-external-volume\n)). It also refuses to remove the active\nstorage location ([provider note](https://gith\nub.com/snowflakedb/terraform-provider-snowflak\ne/blob/v2.23.0/docs/resources/external_volume.\nmd#L8)). So a plan that replaces a volume, for\nexample through `replace_triggered_by`, fails\nat apply. Before 2.19.0, the provider could\nremove and re-add an unchanged location, which\nfailed with error 393926 ([migration guide](ht\ntps://github.com/snowflakedb/terraform-provide\nr-snowflake/blob/v2.23.0/MIGRATION_GUIDE.md#L2\n138-L2146)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-3270c298ada2",
      "originalText": "External Volumes Freeze\nSnowflake refuses to drop or replace an external volume while Iceberg tables use it ([DROP EXTERNAL VOLUME](https://docs.snowflake.com/en/sql-reference/sql/drop-external-volume)). It also refuses to remove the active storage location ([provider note](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/docs/resources/external_volume.md#L8)). So a plan that replaces a volume, for example through `replace_triggered_by`, fails at apply. Before 2.19.0, the provider could remove and re-add an unchanged location, which failed with error 393926 ([migration guide](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/MIGRATION_GUIDE.md#L2138-L2146)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "external-volumes-freeze"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
