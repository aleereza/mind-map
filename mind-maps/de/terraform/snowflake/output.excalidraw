      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Raw SQL Pitfalls\n`snowflake_execute` takes three SQL strings:\n`execute` on create, `revert` on destroy, and\nan optional `query` on read. The provider\ncalls it dangerous, because it runs any\nstatement ([execute warning](https://github.co\nm/snowflakedb/terraform-provider-snowflake/blo\nb/v2.23.0/docs/resources/execute.md#L10)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-7971a37e0ae3",
      "originalText": "Raw SQL Pitfalls\n`snowflake_execute` takes three SQL strings: `execute` on create, `revert` on destroy, and an optional `query` on read. The provider calls it dangerous, because it runs any statement ([execute warning](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/docs/resources/execute.md#L10)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "raw-sql-pitfalls"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5847569480,
      "isDeleted": false,
      "id": "node-c2179dc406e4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1928.8,
      "y": 2720.0,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
      "seed": 217935,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3,
