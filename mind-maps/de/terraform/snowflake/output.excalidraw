    {
      "type": "text",
      "version": 1,
      "versionNonce": 4562132936,
      "isDeleted": false,
      "id": "text-67e4e2efd9db",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1288.8,
      "y": 1160.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
