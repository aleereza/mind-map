    {
      "type": "text",
      "version": 1,
      "versionNonce": 4924013661,
      "isDeleted": false,
      "id": "text-c02b15a510fb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1882.0,
      "y": 5053.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 280.0,
      "seed": 964631,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Catalog-Linked Databases Sync Late\nA catalog-linked database mirrors the\nnamespaces of a remote Iceberg catalog. The\nprovider has no resource for it yet, so\nconfigurations create it with\n`snowflake_execute` ([issue 4201](https://gith\nub.com/snowflakedb/terraform-provider-snowflak\ne/issues/4201)). Snowflake syncs the tables in\nthe background, every 30 seconds by default\n([CREATE DATABASE (catalog-linked)](https://do\ncs.snowflake.com/en/sql-reference/sql/create-d\natabase-catalog-linked)). Grants that run\nright after the create can therefore miss\ntables, so configurations add a wait. Its\ndefault `ALLOWED_WRITE_OPERATIONS = ALL` also\nsends table drops on to the remote catalog.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-c02b15a510fb",
      "originalText": "Catalog-Linked Databases Sync Late\nA catalog-linked database mirrors the namespaces of a remote Iceberg catalog. The provider has no resource for it yet, so configurations create it with `snowflake_execute` ([issue 4201](https://github.com/snowflakedb/terraform-provider-snowflake/issues/4201)). Snowflake syncs the tables in the background, every 30 seconds by default ([CREATE DATABASE (catalog-linked)](https://docs.snowflake.com/en/sql-reference/sql/create-database-catalog-linked)). Grants that run right after the create can therefore miss tables, so configurations add a wait. Its default `ALLOWED_WRITE_OPERATIONS = ALL` also sends table drops on to the remote catalog.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "catalog-linked-databases-sync-late"
      }
    },
