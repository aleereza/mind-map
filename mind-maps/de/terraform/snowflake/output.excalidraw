        "node_id": "all-grants-revoke-widely"
      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 2354135858,
      "isDeleted": false,
      "id": "text-b2ea5d61c4d7",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1932.4,
      "y": 3756.5,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 315.0,
      "seed": 904406,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "ALL Grants Revoke Widely\nThe provider never reads back an `all` grant,\nso it cannot show drift for it ([always_apply \ndecision](https://github.com/snowflakedb/terra\nform-provider-snowflake/blob/v2.23.0/docs/guid\nes/grants_redesign_design_decisions.md#L77-L84\n)). Its destroy runs `REVOKE ... ON ALL`. When\nthe provider role holds MANAGE GRANTS,\nSnowflake revokes every instance of the\nprivilege, whoever granted it ([REVOKE privile\nge](https://docs.snowflake.com/en/sql-referenc\ne/sql/revoke-privilege)). So removing one\n`all` grant can also take away grants that dbt\nor a person made. `all_privileges` has the\nsame blind spot ([read code](https://github.co\nm/snowflakedb/terraform-provider-snowflake/blo\nb/v2.23.0/pkg/resources/grant_privileges_to_ac\ncount_role.go#L1034-L1037)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-b2ea5d61c4d7",
      "originalText": "ALL Grants Revoke Widely\nThe provider never reads back an `all` grant, so it cannot show drift for it ([always_apply decision](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/docs/guides/grants_redesign_design_decisions.md#L77-L84)). Its destroy runs `REVOKE ... ON ALL`. When the provider role holds MANAGE GRANTS, Snowflake revokes every instance of the privilege, whoever granted it ([REVOKE privilege](https://docs.snowflake.com/en/sql-reference/sql/revoke-privilege)). So removing one `all` grant can also take away grants that dbt or a person made. `all_privileges` has the same blind spot ([read code](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/pkg/resources/grant_privileges_to_account_role.go#L1034-L1037)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "all-grants-revoke-widely"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 5850837199,
      "isDeleted": false,
      "id": "node-aa768a01f4c3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1920.4,
      "y": 4016.5,
      "strokeColor": "#92400E",
      "backgroundColor": "#FEF3C7",
      "width": 418.8,
      "height": 220.0,
