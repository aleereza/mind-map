      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pitfalls\nThe pitfalls fall into four\ngroups: raw SQL, grants,\nintegrations, and lifecycle.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-4ee69b13530c",
      "originalText": "Pitfalls\nThe pitfalls fall into four groups: raw SQL, grants, integrations, and lifecycle.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "snowflake-pitfalls"
      }
    },
    {
