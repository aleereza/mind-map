      }
    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3363641307,
      "isDeleted": false,
      "id": "text-0eb4653c67a4",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 7145.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 192.5,
      "seed": 891617,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Protect What Cannot Be Rebuilt\nA database or a table that holds data cannot\ncome back from code. `lifecycle {\nprevent_destroy = true }` makes any plan that\ndestroys it fail. The cost is a deliberate\nconfig edit before a planned removal\n([migration guide](https://github.com/snowflak\nedb/terraform-provider-snowflake/blob/v2.23.0/\ndocs/guides/resource_migration.md#L92-L94)).\nPair it with `moved` blocks for renames, so a\nrefactor never plans a destroy.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-0eb4653c67a4",
      "originalText": "Protect What Cannot Be Rebuilt\nA database or a table that holds data cannot come back from code. `lifecycle { prevent_destroy = true }` makes any plan that destroys it fail. The cost is a deliberate config edit before a planned removal ([migration guide](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/docs/guides/resource_migration.md#L92-L94)). Pair it with `moved` blocks for renames, so a refactor never plans a destroy.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "protect-what-cannot-be-rebuilt"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 6260764073,
      "isDeleted": false,
      "id": "node-e2ef693d4c46",
