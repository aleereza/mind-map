    {
      "type": "text",
      "version": 1,
      "versionNonce": 7100915742,
      "isDeleted": false,
      "id": "text-3a9179793f5a",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1882.0,
      "y": 4533.0,
      "strokeColor": "#92400E",
