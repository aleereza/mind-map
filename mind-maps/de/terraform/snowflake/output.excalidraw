    },
    {
      "type": "text",
      "version": 1,
      "versionNonce": 3980404930,
      "isDeleted": false,
      "id": "text-e55b244d060d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1321.2,
      "y": 6353.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 420.0,
      "seed": 361555,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Grants as Resources or as SQL\nSome repos render grant SQL from a template\nand run it with `snowflake_execute`. The table\ncompares this with native grant resources:\n\n| | Native grant resources | Grant SQL in\n`snowflake_execute` |\n| --- | --- | --- |\n| Number of resources | One resource for each\ngrant | One resource for many grants |\n| Drift detection | Yes, except for `all`\ngrants | No |\n| Removing extra grants | Yes, with\n`strict_privilege_management` | No |\n| Rename safety | `moved` blocks | Any text\nchange revokes and grants again |\n\nNative resources cost more lines, but they\nshow the truth in the plan. Inherited grants\nsince 2.19.0 replace each pair of `all` and\n`future` grants with one resource ([migration \nguide](https://github.com/snowflakedb/terrafor\nm-provider-snowflake/blob/v2.23.0/MIGRATION_GU\nIDE.md#L1986-L1988)).",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e55b244d060d",
      "originalText": "Grants as Resources or as SQL\nSome repos render grant SQL from a template and run it with `snowflake_execute`. The table compares this with native grant resources:\n\n| | Native grant resources | Grant SQL in `snowflake_execute` |\n| --- | --- | --- |\n| Number of resources | One resource for each grant | One resource for many grants |\n| Drift detection | Yes, except for `all` grants | No |\n| Removing extra grants | Yes, with `strict_privilege_management` | No |\n| Rename safety | `moved` blocks | Any text change revokes and grants again |\n\nNative resources cost more lines, but they show the truth in the plan. Inherited grants since 2.19.0 replace each pair of `all` and `future` grants with one resource ([migration guide](https://github.com/snowflakedb/terraform-provider-snowflake/blob/v2.23.0/MIGRATION_GUIDE.md#L1986-L1988)).",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "grants-as-resources-or-sql"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 1674832790,
      "isDeleted": false,
      "id": "node-3993e91c9dfb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1309.2,
      "y": 6613.0,
