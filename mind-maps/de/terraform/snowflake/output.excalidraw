      "versionNonce": 2331347592,
      "isDeleted": false,
      "id": "node-3a9179793f5a",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
