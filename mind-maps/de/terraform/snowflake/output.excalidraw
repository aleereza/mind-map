    {
      "type": "text",
      "version": 1,
      "versionNonce": 7819427048,
      "isDeleted": false,
      "id": "text-20dc165e649b",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1873.6,
      "y": 5578.0,
      "strokeColor": "#92400E",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 210.0,
      "seed": 427403,
      "groupIds": [],
