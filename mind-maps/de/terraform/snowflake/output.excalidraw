      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Integration Pitfalls\nThese pitfalls cross into AWS or into\nan Iceberg catalog. Terraform sees only\nthe Snowflake side of each connection.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 17.5,
      "containerId": "node-e26015a7081d",
      "originalText": "Integration Pitfalls\nThese pitfalls cross into AWS or into an Iceberg catalog. Terraform sees only the Snowflake side of each connection.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "integration-pitfalls"
      }
    },
    {
      "type": "rectangle",
