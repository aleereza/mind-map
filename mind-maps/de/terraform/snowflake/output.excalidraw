    {
      "type": "text",
      "version": 1,
      "versionNonce": 3627751578,
      "isDeleted": false,
      "id": "text-7971a37e0ae3",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1332.0,
      "y": 3018.25,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
