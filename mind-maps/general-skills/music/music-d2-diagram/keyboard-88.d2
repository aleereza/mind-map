# All 88 keys of the piano, from A0 to C8, with every C named and middle C and A4 marked.

vars: {
  d2-config: {
    layout-engine: tala
    pad: 24
  }
}

classes: {
  white: {
    style: {
      fill: "#FFFFFF"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 3
      font-color: "#0F172A"
    }
  }
  white_alt: {
    style: {
      fill: "#E2E8F0"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 3
      font-color: "#0F172A"
    }
  }
  middle_c: {
    style: {
      fill: "#FDE68A"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 3
      font-color: "#0F172A"
    }
  }
  tuning_a: {
    style: {
      fill: "#BFDBFE"
      stroke: "#334155"
      stroke-width: 2
      border-radius: 3
      font-color: "#0F172A"
    }
  }
  black: {
    style: {
      fill: "#1E293B"
      stroke: "#0F172A"
      stroke-width: 1
      border-radius: 3
      font-color: "#FFFFFF"
    }
  }
  ink: {
    style: {
      fill: "#0F172A"
      stroke: "#0F172A"
      stroke-width: 0
    }
  }
  head_open: {
    shape: oval
    style: {
      fill: "#FFFFFF"
      stroke: "#0F172A"
      stroke-width: 2
    }
  }
  head_filled: {
    shape: oval
    style: {
      fill: "#0F172A"
      stroke: "#0F172A"
      stroke-width: 2
    }
  }
  note_c4: {
    shape: oval
    style: {
      fill: "#FDE68A"
      stroke: "#0F172A"
      stroke-width: 2
    }
  }
  label: {
    shape: text
    style: {
      font-color: "#0F172A"
    }
  }
  tag: {
    style: {
      fill: transparent
      stroke-width: 0
      font-color: "#0F172A"
      bold: false
    }
  }
}

