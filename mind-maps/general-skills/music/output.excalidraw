      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Hearing Pitch\nHearing turns the pressure wave\nback into notes. The inner ear\nsplits the sound by frequency, and\nthe brain turns the result into\npitch, loudness and timbre. Two\nskills then differ a lot from\nperson to person. Relative pitch,\nwhich is hearing the interval\nbetween two notes, is common among\nmusicians. Absolute pitch, which\nis naming a single note with no\nreference, is rare.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "baseline": 22.5,
      "containerId": "node-992f12c9781d",
      "originalText": "Hearing Pitch\nHearing turns the pressure wave back into notes. The inner ear splits the sound by frequency, and the brain turns the result into pitch, loudness and timbre. Two skills then differ a lot from person to person. Relative pitch, which is hearing the interval between two notes, is common among musicians. Absolute pitch, which is naming a single note with no reference, is rare.",
      "lineHeight": 1.25,
      "autoResize": true,
      "customData": {
        "node_id": "hearing-pitch"
      }
    },
    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 3357824896,
      "isDeleted": false,
      "id": "node-1bafa0eeb5d1",
