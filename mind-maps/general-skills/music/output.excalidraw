    {
      "type": "text",
      "version": 1,
      "versionNonce": 2842060347,
      "isDeleted": false,
      "id": "text-5bfb7116984d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1312.0,
      "y": 380.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 472.5,
      "seed": 155427,
      "groupIds": [],
