      "angle": 0,
      "x": 1312.0,
      "y": 120.0,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "transparent",
      "width": 394.8,
      "height": 822.5,
      "seed": 331791,
      "groupIds": [],
