    {
      "type": "text",
      "version": 1,
      "versionNonce": 7737145331,
      "isDeleted": false,
      "id": "text-2de264a7b61e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1312.0,
      "y": 4320.80579834672,
      "strokeColor": "#1E3A8A",
