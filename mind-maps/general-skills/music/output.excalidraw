    {
      "type": "rectangle",
      "version": 1,
      "versionNonce": 8063089786,
      "isDeleted": false,
      "id": "node-df463387ae15",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 1300.0,
      "y": 3800.8057983467197,
      "strokeColor": "#1E3A8A",
      "backgroundColor": "#F8FAFC",
