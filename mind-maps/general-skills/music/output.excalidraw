    {
      "type": "text",
      "version": 1,
      "versionNonce": 3067751053,
      "isDeleted": false,
      "id": "text-992f12c9781d",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 726.0,
      "y": 4970.80579834672,
      "strokeColor": "#0F172A",
      "backgroundColor": "transparent",
      "width": 377.99999999999994,
      "height": 292.5,
      "seed": 570664,
      "groupIds": [],
